<Window x:Class="PortableDeveloper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PortableDeveloper.App.Converters"
        mc:Ignorable="d"
        Title="Portable Developer"
        Icon="Assets/portable-developer.ico"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Background="#101725"
        Foreground="#E8EDF5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EnumToVisibilityConverter x:Key="PageVisibilityConverter" />

        <Style x:Key="PanelCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="#192235" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#253650" />
            <Setter Property="BorderBrush" Value="#4A6388" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Foreground" Value="#E8EDF5" />
            <Setter Property="Background" Value="#101725" />
            <Setter Property="BorderBrush" Value="#4A6388" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#E8EDF5" />
        </Style>

        <Style x:Key="InputPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Foreground" Value="#E8EDF5" />
            <Setter Property="Background" Value="#101725" />
            <Setter Property="BorderBrush" Value="#4A6388" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#E8EDF5" />
        </Style>

        <Style x:Key="NavigationItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#A9B6C9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="NavigationChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background" Value="#182238" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background" Value="#253650" />
                                <Setter Property="Foreground" Value="#F5F7FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeleniumTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#A9B6C9" />
            <Setter Property="Background" Value="#182238" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" CornerRadius="5,5,0,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#2D6A4F" />
                                <Setter Property="Foreground" Value="#F5F7FA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0C1321" BorderBrush="#202B40" BorderThickness="0,0,1,0">
            <Grid Margin="18,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="8,0,8,20">
                    <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Text.ApplicationTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="10"
                               Foreground="#78879C"
                               TextWrapping="Wrap"
                               Text="{Binding Text.LocalOnly}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="10"
                               Foreground="#5F708A"
                               Text="{Binding ApplicationVersion, StringFormat=v{0}}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         SelectionChanged="NavigationList_SelectionChanged"
                         ItemsSource="{Binding NavigationItems}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         SelectedValuePath="Page"
                         SelectedValue="{Binding SelectedPage, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="14" Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="8,16,8,0">
                    <TextBlock Margin="0,0,0,6"
                               FontSize="11"
                               Foreground="#78879C"
                               Text="{Binding Text.Language}" />
                    <ComboBox x:Name="LanguageSelector"
                              Padding="8,6"
                              SelectionChanged="LanguageSelector_SelectionChanged"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Tag="Czech" Content="Česky" />
                        <ComboBoxItem Tag="English" Content="English" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock FontSize="27" FontWeight="SemiBold" Text="{Binding PageTitle}" />
                <TextBlock Margin="0,5,0,0" Foreground="#78879C" Text="{Binding Text.Subtitle}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- Dashboard -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Dashboard}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="#A9B6C9" FontSize="12" Text="{Binding Text.WebStack}" />
                                    <TextBlock Margin="0,7,0,0" FontSize="21" FontWeight="SemiBold" Foreground="#F1C46B" Text="{Binding StackState}" />
                                    <TextBlock Margin="0,6,24,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding StackDetail}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionButtonStyle}"
                                        MinWidth="170"
                                        Padding="18,11"
                                        VerticalAlignment="Center"
                                        Background="{Binding StackActionBackground}"
                                        BorderBrush="{Binding StackActionBorder}"
                                        IsEnabled="{Binding StackActionEnabled}"
                                        Click="ToggleStack_Click"
                                        Content="{Binding StackActionLabel}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="185" MinHeight="205" Margin="0,0,10,10" Style="{StaticResource PanelCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Margin="0,6,0,16" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Description}" />
                                            <TextBlock Foreground="#F1C46B" FontWeight="SemiBold" Text="{Binding State}" />
                                            <TextBlock Margin="0,6,0,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Detail}" />
                                            <Button Margin="0,14,0,0"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Padding="11,7"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    IsEnabled="{Binding IsActionEnabled}"
                                                    Tag="{Binding ActionKey}"
                                                    Click="ServiceAction_Click"
                                                    Content="{Binding ActionLabel}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- PHP -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Php}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="PHP FastCGI" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#F1C46B" FontWeight="SemiBold" Text="{Binding PhpService.State}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding PhpService.Detail}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" MinWidth="170" Padding="18,11"
                                        VerticalAlignment="Center" Background="{Binding StackActionBackground}" BorderBrush="{Binding StackActionBorder}"
                                        IsEnabled="{Binding StackActionEnabled}" Click="ToggleStack_Click" Content="{Binding StackActionLabel}" />
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.PhpSettings}" />
                                    <TextBlock Margin="0,7,0,3" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Text.PhpSettingsHelp}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Foreground="#78879C" Text="{Binding Text.MemoryLimit}" />
                                            <TextBox x:Name="PhpMemoryLimitTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                            <TextBlock Margin="0,11,0,5" Foreground="#78879C" Text="{Binding Text.UploadLimit}" />
                                            <TextBox x:Name="PhpUploadLimitTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                            <TextBlock Margin="0,11,0,5" Foreground="#78879C" Text="{Binding Text.ExecutionTime}" />
                                            <TextBox x:Name="PhpExecutionTimeTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Foreground="#78879C" Text="{Binding Text.PostLimit}" />
                                            <TextBox x:Name="PhpPostLimitTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                            <TextBlock Margin="0,11,0,5" Foreground="#78879C" Text="{Binding Text.MaximumInputVariables}" />
                                            <TextBox x:Name="PhpMaxInputVariablesTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="PhpDisplayErrorsCheckBox" Margin="0,14,0,0"
                                              Foreground="#E8EDF5" IsEnabled="{Binding PhpSettingsEnabled}"
                                              Content="{Binding Text.DisplayErrors}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                               Text="{Binding Text.DisplayErrorsHelp}" />
                                    <WrapPanel Margin="0,15,0,0">
                                        <Button Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                                IsEnabled="{Binding PhpSettingsEnabled}" Click="SavePhpSettings_Click"
                                                Content="{Binding Text.SavePhpSettings}" />
                                        <Button Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                                IsEnabled="{Binding PhpSettingsEnabled}" Click="ResetPhpSettings_Click"
                                                Content="{Binding Text.ResetDefaults}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.PhpExtensions}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                               Text="{Binding Text.PhpExtensionsHelp}" />
                                    <TextBlock Margin="0,8,0,12" Foreground="#F1C46B" TextWrapping="Wrap"
                                               Text="{Binding Text.RequiredPhpExtensions}" />
                                    <ItemsControl ItemsSource="{Binding PhpExtensions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,0,18,12" MinWidth="105" Foreground="#E8EDF5"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanToggle}">
                                                    <TextBlock Text="{Binding Name}" />
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Margin="0,5,0,0" Padding="12,10" Background="#101725" CornerRadius="5">
                                        <StackPanel>
                                            <TextBlock Foreground="#78879C" Text="{Binding Text.PhpIni}" />
                                            <TextBlock Margin="0,4,0,0" Text="temp/generated/default/apache-php/php.ini" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0" Foreground="#78879C" Text="{Binding Text.Version}" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding PhpService.Version}" />
                                        </StackPanel>
                                    </Border>
                                    <Button Margin="0,14,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left" IsEnabled="{Binding EditorReady}"
                                            Click="EditCustomPhpIni_Click" Content="{Binding Text.EditCustomPhpIni}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="#F1C46B" TextWrapping="Wrap"
                                               Text="{Binding Text.CustomPhpIniHelp}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Apache -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Apache}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Apache HTTP Server" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#F1C46B" FontWeight="SemiBold" Text="{Binding ApacheService.State}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding ApacheService.Detail}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" MinWidth="170" Padding="18,11"
                                        VerticalAlignment="Center" Background="{Binding StackActionBackground}" BorderBrush="{Binding StackActionBorder}"
                                        IsEnabled="{Binding StackActionEnabled}" Click="ToggleStack_Click" Content="{Binding StackActionLabel}" />
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CurrentConfiguration}" />
                                    <TextBlock Margin="0,16,0,3" Foreground="#78879C" Text="{Binding Text.Version}" />
                                    <TextBlock Text="{Binding ApacheService.Version}" />
                                    <TextBlock Margin="0,13,0,3" Foreground="#78879C" Text="{Binding Text.Port}" />
                                    <TextBlock Text="{Binding ApachePort}" />
                                    <TextBlock Margin="0,13,0,3" Foreground="#78879C" Text="{Binding Text.DocumentRoot}" />
                                    <TextBlock Text="{Binding Text.DocumentRootValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.PlannedConfiguration}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="#F1C46B" Text="{Binding Text.Planned}" />
                                    <TextBlock Margin="0,14,0,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Text.ApacheConfigurationPlan}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Databases -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Databases}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="MariaDB" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#F1C46B" FontWeight="SemiBold" Text="{Binding MariaDbService.State}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding MariaDbService.Detail}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" MinWidth="170" Padding="18,11"
                                        VerticalAlignment="Center" Background="{Binding MariaDbActionBackground}"
                                        BorderBrush="{Binding MariaDbActionBorder}" IsEnabled="{Binding MariaDbActionEnabled}"
                                        Tag="toggle-mariadb" Click="ServiceAction_Click" Content="{Binding MariaDbActionLabel}" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.ConnectionDetails}" />
                                    <TextBlock Margin="0,16,0,3" Foreground="#78879C" Text="{Binding Text.Host}" />
                                    <TextBlock Text="127.0.0.1" />
                                    <TextBlock Margin="0,13,0,3" Foreground="#78879C" Text="{Binding Text.Port}" />
                                    <TextBlock Text="{Binding MariaDbPort}" />
                                    <TextBlock Margin="0,13,0,3" Foreground="#78879C" Text="{Binding Text.User}" />
                                    <TextBlock Text="root" />
                                    <TextBlock Margin="0,13,0,3" Foreground="#78879C" Text="{Binding Text.Password}" />
                                    <TextBlock Text="{Binding RootPasswordState}" />
                                    <TextBlock Margin="0,16,0,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Text.RootAccountNote}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CreateDatabase}" />
                                    <TextBlock Margin="0,16,0,6" Foreground="#78879C" Text="{Binding Text.NewDatabaseName}" />
                                    <TextBox x:Name="NewDatabaseNameTextBox" Style="{StaticResource InputTextBoxStyle}" Text="project_db" />
                                    <TextBlock Margin="0,12,0,3" Foreground="#78879C" Text="{Binding Text.DefaultDatabase}" />
                                    <TextBlock Foreground="#F1C46B" Text="portable_dev" />
                                    <Button Margin="0,18,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left" IsEnabled="{Binding DatabaseActionsEnabled}"
                                            Click="CreateDatabase_Click" Content="{Binding Text.CreateDatabase}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.RootPasswordSecurity}" />
                                    <TextBlock Margin="0,5,0,0" Foreground="#F1C46B" Text="{Binding RootPasswordState}" />
                                    <TextBlock Margin="0,14,0,5" Foreground="#78879C" Text="{Binding Text.NewPassword}" />
                                    <PasswordBox x:Name="RootPasswordBox" Style="{StaticResource InputPasswordBoxStyle}" />
                                    <TextBlock Margin="0,11,0,5" Foreground="#78879C" Text="{Binding Text.ConfirmPassword}" />
                                    <PasswordBox x:Name="ConfirmRootPasswordBox" Style="{StaticResource InputPasswordBoxStyle}" />
                                    <TextBlock Margin="0,11,0,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Text.PasswordGuidance}" />
                                    <Button Margin="0,16,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left" IsEnabled="{Binding DatabaseActionsEnabled}"
                                            Click="ChangeRootPassword_Click" Content="{Binding RootPasswordActionLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="phpMyAdmin 5.2.3" />
                                    <TextBlock Margin="0,10,0,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Text.PhpMyAdminDescription}" />
                                    <TextBlock Margin="0,16,0,4" Foreground="#78879C" Text="URL" />
                                    <TextBlock Foreground="#F1C46B" TextWrapping="Wrap" Text="{Binding PhpMyAdminUrl}" />
                                    <Button Margin="0,18,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left" IsEnabled="{Binding PhpMyAdminActionEnabled}" Click="OpenPhpMyAdmin_Click"
                                            Content="{Binding Text.OpenPhpMyAdmin}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.DatabaseOverview}" />
                                        <TextBlock Margin="0,4,0,0" Foreground="#78879C" Text="{Binding DatabaseCount}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="13,8"
                                            IsEnabled="{Binding DatabaseActionsEnabled}" Click="RefreshDatabases_Click"
                                            Content="{Binding Text.Refresh}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Databases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="13,11" Background="#101725" CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock HorizontalAlignment="Right" Foreground="#F1C46B" Text="{Binding ApproximateSize}" />
                                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#78879C"
                                                                   Text="{Binding DataContext.Text.ApproximateSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Selenium -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Selenium}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Selenium Server" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#F1C46B" FontWeight="SemiBold" Text="{Binding SeleniumService.State}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding SeleniumService.Detail}" />
                                    <TextBlock Margin="0,8,20,0" Foreground="#78879C" TextWrapping="Wrap" Text="{Binding SeleniumHubUrl}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}" Padding="15,10"
                                            IsEnabled="{Binding SeleniumIsRunning}" Click="OpenSeleniumHub_Click"
                                            Content="{Binding Text.OpenSeleniumHub}" />
                                    <Button Style="{StaticResource ActionButtonStyle}" MinWidth="170" Padding="18,11"
                                            Background="{Binding SeleniumActionBackground}" BorderBrush="{Binding SeleniumActionBorder}"
                                            IsEnabled="{Binding SeleniumActionEnabled}" Click="ToggleSelenium_Click"
                                            Content="{Binding SeleniumActionLabel}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabItem Style="{StaticResource SeleniumTabItemStyle}" Header="{Binding Text.SeleniumSettings}">
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SeleniumSettings}" />
                                            <TextBlock Margin="0,15,0,5" Foreground="#78879C" Text="{Binding Text.Port}" />
                                            <TextBox x:Name="SeleniumPortTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding SeleniumSettingsEnabled}" />
                                            <TextBlock Margin="0,12,0,5" Foreground="#78879C" Text="{Binding Text.MaximumSessions}" />
                                            <TextBox x:Name="SeleniumMaxSessionsTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding SeleniumSettingsEnabled}" />
                                            <TextBlock Margin="0,12,0,5" Foreground="#78879C" Text="{Binding Text.SessionTimeout}" />
                                            <TextBox x:Name="SeleniumSessionTimeoutTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding SeleniumSettingsEnabled}" />
                                            <TextBlock Margin="0,9,0,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                                       Text="{Binding Text.SessionTimeoutHelp}" />
                                            <Button Margin="0,15,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                                    HorizontalAlignment="Left" IsEnabled="{Binding SeleniumSettingsEnabled}"
                                                    Click="SaveSeleniumSettings_Click" Content="{Binding Text.SaveSeleniumSettings}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SeleniumDrivers}" />
                                            <TextBlock Margin="0,5,0,0" Foreground="#F1C46B" Text="{Binding SeleniumDriverCount}" />
                                            <TextBlock Margin="0,10,0,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                                       Text="{Binding Text.SeleniumDriversHelp}" />
                                            <WrapPanel Margin="0,14,0,8">
                                                <Button Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Padding="13,8"
                                                        Click="OpenSeleniumDriversFolder_Click" Content="{Binding Text.OpenDriversFolder}" />
                                                <Button Style="{StaticResource ActionButtonStyle}" Padding="13,8"
                                                        IsEnabled="{Binding SeleniumSettingsEnabled}" Click="ReloadSeleniumDrivers_Click"
                                                        Content="{Binding Text.ReloadDrivers}" />
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding SeleniumDrivers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,6,0,0" Padding="12,10" Background="#101725" CornerRadius="5">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                    <TextBlock Grid.Column="1" Foreground="#F1C46B" Text="{Binding Version}" />
                                                                </Grid>
                                                                <TextBlock Margin="0,4,0,0" Foreground="#78879C" Text="{Binding Source}" />
                                                                <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#78879C"
                                                                           TextWrapping="Wrap" Text="{Binding RelativePath}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem Style="{StaticResource SeleniumTabItemStyle}" Header="{Binding Text.SeleniumSessions}">
                                <Border Margin="0,14,0,0" Style="{StaticResource PanelCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SeleniumSessions}" />
                                                <TextBlock Margin="0,4,0,0" Foreground="#F1C46B" Text="{Binding SeleniumSessionCount}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="13,8"
                                                    IsEnabled="{Binding SeleniumSessionActionsEnabled}" Click="RefreshSeleniumSessions_Click"
                                                    Content="{Binding Text.Refresh}" />
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0" Foreground="#A9B6C9"
                                                   Visibility="{Binding NoSeleniumSessions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   Text="{Binding Text.NoSeleniumSessions}" />
                                        <ItemsControl ItemsSource="{Binding SeleniumSessions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="13,11" Background="#101725" CornerRadius="5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="1*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontSize="10" Foreground="#78879C" Text="{Binding DataContext.Text.Browser, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,3,8,0" FontWeight="SemiBold" Text="{Binding Browser}" />
                                                                <TextBlock Margin="0,3,8,0" FontSize="9" Foreground="#78879C" TextTrimming="CharacterEllipsis" Text="{Binding Id}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock FontSize="10" Foreground="#78879C" Text="{Binding DataContext.Text.Platform, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,3,8,0" Text="{Binding Platform}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock FontSize="10" Foreground="#78879C" Text="{Binding DataContext.Text.Started, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,3,8,0" Text="{Binding StartedAt}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3">
                                                                <TextBlock FontSize="10" Foreground="#78879C" Text="{Binding DataContext.Text.Duration, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,3,10,0" Foreground="#F1C46B" Text="{Binding Duration}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                                                                    VerticalAlignment="Center" Tag="{Binding Id}" Click="TerminateSeleniumSession_Click"
                                                                    IsEnabled="{Binding DataContext.SeleniumSessionActionsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Content="{Binding DataContext.Text.TerminateSession, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Composer -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Composer}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Composer" />
                                    <TextBlock Margin="0,6,20,0" Foreground="#F1C46B" FontWeight="SemiBold"
                                               Text="{Binding Composer.RuntimeVersion, StringFormat=Version {0}}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                               Text="{Binding Composer.RuntimeDetail}" />
                                    <TextBlock Margin="0,8,20,0" Foreground="#78879C" TextWrapping="Wrap"
                                               Text="{Binding Composer.ProjectRelativePath}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Padding="13,9"
                                            Click="OpenComposerProject_Click" Content="{Binding Text.OpenProjectDirectory}" />
                                    <Button Style="{StaticResource ActionButtonStyle}" Padding="13,9"
                                            IsEnabled="{Binding Composer.CanOperate}" Click="RefreshComposerPackages_Click"
                                            Content="{Binding Text.RefreshPackages}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.AddPackage}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Text.ComposerHelp}" />
                                    <TextBlock Margin="0,15,0,5" Foreground="#78879C" Text="{Binding Text.PackageName}" />
                                    <TextBox x:Name="ComposerPackageNameTextBox" Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding Composer.CanOperate}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#78879C" Text="{Binding Text.ComposerPackageExample}" />
                                    <TextBlock Margin="0,12,0,5" Foreground="#78879C" Text="{Binding Text.VersionConstraint}" />
                                    <TextBox x:Name="ComposerVersionConstraintTextBox" Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding Composer.CanOperate}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#78879C" Text="{Binding Text.ComposerConstraintExample}" />
                                    <Button Margin="0,15,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left" IsEnabled="{Binding Composer.CanOperate}"
                                            Click="InstallComposerPackage_Click" Content="{Binding Text.InstallPackage}" />
                                    <TextBlock Margin="0,16,0,0" Foreground="#F1C46B" TextWrapping="Wrap"
                                               Text="{Binding Text.PackageNetworkNotice}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.InstalledPackages}" />
                                        <TextBlock Grid.Column="1" Foreground="#F1C46B" Text="{Binding Composer.Packages.Count}" />
                                    </Grid>
                                    <TextBlock Margin="0,10,0,0" Foreground="#A9B6C9"
                                               Visibility="{Binding Composer.NoPackages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Text="{Binding Text.NoInstalledPackages}" />
                                    <ItemsControl ItemsSource="{Binding Composer.Packages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="13,11" Background="#101725" CornerRadius="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                            <TextBlock Margin="0,3,10,0" Foreground="#F1C46B" Text="{Binding Version}" />
                                                            <TextBlock Margin="0,3,10,0" FontSize="10" Foreground="#78879C"
                                                                       TextWrapping="Wrap" Text="{Binding Description}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                                                                Tag="{Binding Name}" IsEnabled="{Binding IsDirectDependency}"
                                                                Click="RemoveComposerPackage_Click"
                                                                Content="{Binding DataContext.Text.RemovePackage, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Python -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Python}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Python" />
                                    <TextBlock Margin="0,6,20,0" Foreground="#F1C46B" FontWeight="SemiBold"
                                               Text="{Binding Python.RuntimeVersion, StringFormat=Version {0}}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                               Text="{Binding Python.RuntimeDetail}" />
                                    <TextBlock Margin="0,8,20,0" Foreground="#78879C" TextWrapping="Wrap"
                                               Text="{Binding Python.ProjectRelativePath}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Padding="13,9"
                                            Click="OpenPythonProject_Click" Content="{Binding Text.OpenProjectDirectory}" />
                                    <Button Style="{StaticResource ActionButtonStyle}" Padding="13,9"
                                            IsEnabled="{Binding Python.CanOperate}" Click="RefreshPythonPackages_Click"
                                            Content="{Binding Text.RefreshPackages}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.AddPackage}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Text.PythonHelp}" />
                                    <TextBlock Margin="0,15,0,5" Foreground="#78879C" Text="{Binding Text.PackageName}" />
                                    <TextBox x:Name="PythonPackageNameTextBox" Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding Python.CanOperate}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#78879C" Text="{Binding Text.PythonPackageExample}" />
                                    <TextBlock Margin="0,12,0,5" Foreground="#78879C" Text="{Binding Text.VersionConstraint}" />
                                    <TextBox x:Name="PythonVersionConstraintTextBox" Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding Python.CanOperate}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#78879C" Text="{Binding Text.PythonConstraintExample}" />
                                    <Button Margin="0,15,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left" IsEnabled="{Binding Python.CanOperate}"
                                            Click="InstallPythonPackage_Click" Content="{Binding Text.InstallPackage}" />
                                    <TextBlock Margin="0,16,0,0" Foreground="#F1C46B" TextWrapping="Wrap"
                                               Text="{Binding Text.PackageNetworkNotice}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.InstalledPackages}" />
                                        <TextBlock Grid.Column="1" Foreground="#F1C46B" Text="{Binding Python.Packages.Count}" />
                                    </Grid>
                                    <TextBlock Margin="0,10,0,0" Foreground="#A9B6C9"
                                               Visibility="{Binding Python.NoPackages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Text="{Binding Text.NoInstalledPackages}" />
                                    <ItemsControl ItemsSource="{Binding Python.Packages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="13,11" Background="#101725" CornerRadius="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                            <TextBlock Margin="0,3,10,0" Foreground="#F1C46B" Text="{Binding Version}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                                                                Tag="{Binding Name}" IsEnabled="{Binding DataContext.Python.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Click="RemovePythonPackage_Click"
                                                                Content="{Binding DataContext.Text.RemovePackage, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Terminal -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Terminal}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.TerminalCommand}" />
                                <TextBlock Margin="0,7,20,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                           Text="{Binding Text.TerminalHelp}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="16,9"
                                    VerticalAlignment="Center" Click="ClearTerminal_Click"
                                    Content="{Binding Text.ClearTerminal}" />
                        </Grid>
                    </Border>
                    <TextBox x:Name="TerminalConsoleTextBox" Grid.Row="1"
                             Padding="14" AcceptsReturn="True" AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono,Consolas" FontSize="13"
                             Foreground="#D7E4D9" Background="#080D16" BorderBrush="#253650"
                             TextWrapping="NoWrap"
                             PreviewKeyDown="TerminalConsoleTextBox_PreviewKeyDown"
                             PreviewTextInput="TerminalConsoleTextBox_PreviewTextInput" />
                </Grid>

                <!-- Files -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Files}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Text.FileManagerName}" />
                                    <TextBlock Margin="0,6,20,0" Foreground="#F1C46B" FontWeight="SemiBold"
                                               Text="{Binding FileManagerVersionLabel}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                               Text="{Binding FileManagerDetail}" />
                                    <TextBlock Margin="0,12,20,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                               Text="{Binding Text.FileManagerHelp}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="18,10"
                                        VerticalAlignment="Center" IsEnabled="{Binding FileManagerReady}"
                                        Click="StartFileManager_Click" Content="{Binding Text.StartFileManager}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.ProjectDirectory}" />
                                <TextBlock Margin="0,9,0,0" FontFamily="Cascadia Mono,Consolas" Foreground="#F1C46B"
                                           Text="instances/default/www" />
                                <TextBlock Margin="0,10,0,0" Foreground="#78879C" TextWrapping="Wrap"
                                           Text="{Binding Text.FileManagerPortableConfig}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="15" Background="#2A2215" BorderBrush="#6E5730" BorderThickness="1" CornerRadius="6">
                            <TextBlock Foreground="#F1C46B" TextWrapping="Wrap"
                                       Text="{Binding Text.FileManagerBoundaryWarning}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tools -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Tools}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Text.PortableEditor}" />
                                    <TextBlock Margin="0,6,20,0" Foreground="#F1C46B" FontWeight="SemiBold"
                                               Text="{Binding EditorVersionLabel}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                               Text="{Binding EditorDetail}" />
                                    <TextBlock Margin="0,9,20,0" Foreground="#78879C" TextWrapping="Wrap"
                                               Text="{Binding Text.PortableEditorHelp}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="16,10"
                                        VerticalAlignment="Center" IsEnabled="{Binding EditorReady}"
                                        Click="StartEditor_Click" Content="{Binding Text.StartEditor}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PanelCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CustomPhpIni}" />
                                    <TextBlock Margin="0,8,20,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                               Text="{Binding Text.CustomPhpIniHelp}" />
                                    <TextBlock Margin="0,10,20,0" Foreground="#78879C" TextWrapping="Wrap"
                                               Text="instances/default/config/php-custom.ini" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="16,10"
                                        VerticalAlignment="Center" IsEnabled="{Binding EditorReady}"
                                        Click="EditCustomPhpIni_Click" Content="{Binding Text.EditCustomPhpIni}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.PortableStorage}" />
                                <TextBlock Margin="0,14,0,3" Foreground="#78879C" Text="{Binding Text.ApplicationRoot}" />
                                <TextBlock Text="{Binding RootPath}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,16,0,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                           Text="{Binding Text.PortableBoundaryNote}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.TechnicalDetails}" />
                                <TextBlock Margin="0,14,0,3" Foreground="#78879C" Text="{Binding Text.ApplicationVersion}" />
                                <TextBlock Text="{Binding ApplicationVersion}" />
                                <TextBlock Margin="0,14,0,0" Foreground="#A9B6C9" TextWrapping="Wrap"
                                           Text="Apache 8080  •  PHP FastCGI 9000  •  MariaDB 3307  •  Selenium 4444" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <TextBlock x:Name="InstallationStatusText"
                       Grid.Row="2"
                       Margin="0,14,0,0"
                       Foreground="#78879C"
                       TextWrapping="Wrap"
                       Text="{Binding Text.InitialStatus}" />
        </Grid>
    </Grid>
</Window>
