<UserControl x:Class="PortableDeveloper.App.Views.FilesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
             xmlns:shell="clr-namespace:PortableDeveloper.App.Shell"
             xmlns:views="clr-namespace:PortableDeveloper.App.Views"
             PreviewKeyDown="FilesPageView_PreviewKeyDown">
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="{Binding Text.Back}"
                            Click="WorkspaceBack_Click" ToolTip="{Binding Text.Back}">
                        <controls:AppIcon Width="18" Height="18" Data="{StaticResource IconBack}" />
                    </Button>
                    <Grid Grid.Column="1" Margin="10,0">
                        <TextBox x:Name="WorkspacePathTextBox" Padding="38,7,12,7"
                                 FontFamily="Cascadia Mono,Consolas"
                                 ToolTip="{Binding Text.WorkspaceAddressHint}"
                                 Text="{Binding PathText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="WorkspacePathTextBox_KeyDown"
                                 GotKeyboardFocus="WorkspacePathTextBox_GotKeyboardFocus" />
                        <controls:AppIcon Margin="12,0,0,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Data="{StaticResource IconFolder}" />
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="{Binding Text.RefreshFiles}"
                            Click="RefreshWorkspace_Click" ToolTip="{Binding Text.RefreshFiles}">
                        <controls:AppIcon Data="{StaticResource IconRefresh}" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="10,8,10,0" Padding="0,5"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="5,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="2" Tag="Name" Style="{StaticResource DetailsHeaderButtonStyle}"
                            Click="WorkspaceSort_Click" Content="{Binding NameSortHeader}" />
                    <Button Grid.Column="3" Tag="Type" Style="{StaticResource DetailsHeaderButtonStyle}"
                            Click="WorkspaceSort_Click" Content="{Binding TypeSortHeader}" />
                    <Button Grid.Column="4" Width="90" Tag="Size" Style="{StaticResource DetailsHeaderButtonStyle}"
                            Click="WorkspaceSort_Click" Content="{Binding SizeSortHeader}"
                            Visibility="{Binding (shell:WorkspaceLayout.Mode), RelativeSource={RelativeSource AncestorType={x:Type views:FilesPageView}}, Converter={StaticResource LayoutModeVisibilityConverter}, ConverterParameter=Wide}" />
                    <Button Grid.Column="5" Width="135" Tag="Modified" Style="{StaticResource DetailsHeaderButtonStyle}"
                            Click="WorkspaceSort_Click" Content="{Binding ModifiedSortHeader}"
                            Visibility="{Binding (shell:WorkspaceLayout.Mode), RelativeSource={RelativeSource AncestorType={x:Type views:FilesPageView}}, Converter={StaticResource LayoutModeVisibilityConverter}, ConverterParameter=Wide}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="10,4,10,8" AllowDrop="True"
                  PreviewDragOver="WorkspaceFileList_DragOver"
                  Drop="WorkspaceFileList_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding NoWorkspaceEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:AppIcon Width="28" Height="28" HorizontalAlignment="Center"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Data="{StaticResource IconFolder}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding Text.EmptyFolder}" />
                </StackPanel>

                <ListBox x:Name="WorkspaceEntriesListBox"
                         ItemsSource="{Binding WorkspaceEntries}"
                         ItemContainerStyle="{StaticResource FileListItemStyle}"
                         Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         PreviewKeyDown="WorkspaceEntriesListBox_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="WorkspaceEntriesListBox_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="WorkspaceEntriesListBox_PreviewMouseMove">
                    <ListBox.Resources>
                        <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush"
                                         Color="{DynamicResource SubtleFillColorSecondary}" />
                        <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush"
                                         Color="{DynamicResource SubtleFillColorTertiary}" />
                        <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush"
                                         Color="{DynamicResource SubtleFillColorSecondary}" />
                        <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush"
                                         Color="{DynamicResource TextFillColorPrimary}" />
                    </ListBox.Resources>
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="WorkspaceBackgroundContextMenu_Opened">
                            <MenuItem x:Name="WorkspaceContextPasteMenuItem"
                                      InputGestureText="Ctrl+V" Click="WorkspaceContextPaste_Click" />
                            <Separator />
                            <MenuItem x:Name="WorkspaceContextNewFileMenuItem" Click="CreateWorkspaceFile_Click" />
                            <MenuItem x:Name="WorkspaceContextNewFolderMenuItem" Click="CreateWorkspaceFolder_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Tag="{Binding}" MouseLeftButtonDown="WorkspaceEntry_MouseLeftButtonDown">
                                <Grid MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Margin="0,6" CornerRadius="2"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <controls:AppIcon Grid.Column="1" Width="18" Height="18"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <controls:AppIcon.Style>
                                            <Style TargetType="{x:Type controls:AppIcon}"
                                                   BasedOn="{StaticResource AppIconBaseStyle}">
                                                <Setter Property="Data" Value="{StaticResource IconFile}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter Property="Data" Value="{StaticResource IconFolder}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Image"><Setter Property="Data" Value="{StaticResource IconImage}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Archive"><Setter Property="Data" Value="{StaticResource IconArchive}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Database"><Setter Property="Data" Value="{StaticResource IconDatabase}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Configuration"><Setter Property="Data" Value="{StaticResource IconGear}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Php"><Setter Property="Data" Value="{StaticResource IconCode}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Python"><Setter Property="Data" Value="{StaticResource IconCode}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="JavaScript"><Setter Property="Data" Value="{StaticResource IconBraces}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="StyleSheet"><Setter Property="Data" Value="{StaticResource IconBraces}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Html"><Setter Property="Data" Value="{StaticResource IconHtml}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Xml"><Setter Property="Data" Value="{StaticResource IconHtml}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Json"><Setter Property="Data" Value="{StaticResource IconBraces}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Yaml"><Setter Property="Data" Value="{StaticResource IconBraces}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Markdown"><Setter Property="Data" Value="{StaticResource IconText}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Text"><Setter Property="Data" Value="{StaticResource IconText}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Document"><Setter Property="Data" Value="{StaticResource IconText}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Spreadsheet"><Setter Property="Data" Value="{StaticResource IconSpreadsheet}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding FileKind}" Value="Executable"><Setter Property="Data" Value="{StaticResource IconExecutable}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:AppIcon.Style>
                                    </controls:AppIcon>
                                    <Grid Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                   PreviewMouseRightButtonDown="WorkspaceName_PreviewMouseRightButtonDown">
                                            <TextBlock.ContextMenu>
                                                <ContextMenu Opened="WorkspaceItemContextMenu_Opened">
                                                    <MenuItem Tag="Open" Click="WorkspaceContextOpen_Click" />
                                                    <Separator />
                                                    <MenuItem Tag="Copy" InputGestureText="Ctrl+C" Click="WorkspaceContextCopy_Click" />
                                                    <MenuItem Tag="Cut" InputGestureText="Ctrl+X" Click="WorkspaceContextCut_Click" />
                                                    <MenuItem Tag="Rename" Click="WorkspaceContextRename_Click" />
                                                    <MenuItem Tag="Delete" Click="WorkspaceContextDelete_Click" />
                                                </ContextMenu>
                                            </TextBlock.ContextMenu>
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Padding="5,2" Margin="-5,-3,8,-3"
                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="WorkspaceRenameTextBox_KeyDown"
                                                 LostKeyboardFocus="WorkspaceRenameTextBox_LostKeyboardFocus"
                                                 IsVisibleChanged="WorkspaceRenameTextBox_IsVisibleChanged">
                                            <TextBox.Style>
                                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DefaultTextBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{Binding Kind}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Kind}" />
                                    <TextBlock Grid.Column="4" Width="90" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Size}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Size}"
                                               Visibility="{Binding (shell:WorkspaceLayout.Mode), RelativeSource={RelativeSource AncestorType={x:Type views:FilesPageView}}, Converter={StaticResource LayoutModeVisibilityConverter}, ConverterParameter=Wide}" />
                                    <TextBlock Grid.Column="5" Width="135" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{Binding Modified}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Modified}"
                                               Visibility="{Binding (shell:WorkspaceLayout.Mode), RelativeSource={RelativeSource AncestorType={x:Type views:FilesPageView}}, Converter={StaticResource LayoutModeVisibilityConverter}, ConverterParameter=Wide}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Row="3" Padding="10,8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding Text.ItemsPerPage}" />
                        <ComboBox Width="72" SelectedValuePath="Tag"
                                  SelectedValue="{Binding PageSizeText, Mode=TwoWay}"
                                  SelectionChanged="WorkspacePageSizeSelector_SelectionChanged">
                            <ComboBoxItem Tag="25" Content="25" />
                            <ComboBoxItem Tag="50" Content="50" IsSelected="True" />
                            <ComboBoxItem Tag="100" Content="100" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding WorkspacePageSummary}" />
                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding StatusText}"
                                   Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}" Tag="First" IsEnabled="{Binding WorkspaceHasPreviousPage}"
                                AutomationProperties.Name="{Binding Text.FirstPage}" Click="WorkspacePage_Click" ToolTip="{Binding Text.FirstPage}">
                            <controls:AppIcon Data="{StaticResource IconFirstPage}" />
                        </Button>
                        <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="Previous" IsEnabled="{Binding WorkspaceHasPreviousPage}"
                                AutomationProperties.Name="{Binding Text.PreviousPage}" Click="WorkspacePage_Click" ToolTip="{Binding Text.PreviousPage}">
                            <controls:AppIcon Data="{StaticResource IconPreviousPage}" />
                        </Button>
                        <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="Next" IsEnabled="{Binding WorkspaceHasNextPage}"
                                AutomationProperties.Name="{Binding Text.NextPage}" Click="WorkspacePage_Click" ToolTip="{Binding Text.NextPage}">
                            <controls:AppIcon Data="{StaticResource IconNextPage}" />
                        </Button>
                        <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="Last" IsEnabled="{Binding WorkspaceHasNextPage}"
                                AutomationProperties.Name="{Binding Text.LastPage}" Click="WorkspacePage_Click" ToolTip="{Binding Text.LastPage}">
                            <controls:AppIcon Data="{StaticResource IconLastPage}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
