<UserControl x:Class="PortableDeveloper.App.Views.SchedulerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
             xmlns:views="clr-namespace:PortableDeveloper.App.Views">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <Border Margin="0,0,0,14" Style="{StaticResource InlineInfoPanelStyle}"
                    Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <controls:AppIcon Margin="0,1,10,0" VerticalAlignment="Top"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Data="{StaticResource IconInfo}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Text="{Binding StatusText}" />
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SchedulerTasks}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconSchedule}"
                                                Heading="{Binding Text.SchedulerTasksTab}"
                                                Metadata="{Binding ScheduledTasks.Count}">
                            <controls:SectionHeader.Actions>
                                <Button Style="{StaticResource FormPrimaryButtonStyle}"
                                        Click="NewScheduledTask_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconAdd}" />
                                        <TextBlock Text="{Binding Text.NewScheduledTask}" />
                                    </StackPanel>
                                </Button>
                            </controls:SectionHeader.Actions>
                        </controls:SectionHeader>

                        <StackPanel Margin="8,28" HorizontalAlignment="Center"
                                    Visibility="{Binding NoScheduledTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controls:AppIcon Width="28" Height="28" HorizontalAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Data="{StaticResource IconSchedule}" />
                            <TextBlock Margin="0,10,0,0" MaxWidth="420" TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding Text.NoScheduledTasks}" />
                        </StackPanel>

                        <ScrollViewer MaxHeight="520"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="20,18" Style="{StaticResource CatalogRowStyle}">
                                            <controls:AdaptiveSplitPanel Gap="28" SecondaryWeight="0" CompactBreakpoint="900">
                                                <controls:AdaptiveSplitPanel Gap="34" PrimaryWeight="0.7" SecondaryWeight="1.3"
                                                                             CompactBreakpoint="680">
                                                    <Grid MinWidth="0" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="46" Height="46" VerticalAlignment="Top"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                BorderThickness="1" CornerRadius="7">
                                                            <controls:BrandLogo Width="30" Height="30"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                Brand="{Binding Brand}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" MinWidth="0">
                                                            <TextBlock FontSize="16" FontWeight="SemiBold"
                                                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}" />
                                                            <TextBlock Margin="0,5,0,0"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Target}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Target}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel MinWidth="0" VerticalAlignment="Center">
                                                        <WrapPanel>
                                                            <StackPanel Margin="0,0,24,8" Orientation="Horizontal">
                                                                <controls:AppIcon Width="17" Height="17" Margin="0,0,8,0"
                                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                  Data="{StaticResource IconSchedule}" />
                                                                <TextBlock VerticalAlignment="Center" FontSize="15"
                                                                           Text="{Binding Schedule}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                                                <Ellipse Width="9" Height="9" Margin="0,0,9,0"
                                                                         VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock VerticalAlignment="Center" FontSize="15"
                                                                           Text="{Binding Status}" />
                                                            </StackPanel>
                                                        </WrapPanel>

                                                        <WrapPanel Margin="0,10,0,0">
                                                            <StackPanel Margin="0,0,24,7" Orientation="Horizontal">
                                                                <controls:AppIcon Width="14" Height="14" Margin="0,1,7,0"
                                                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                                  Data="{StaticResource IconSchedule}" />
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                                    <Run Text="{Binding DataContext.Text.ScheduledTaskNextRun, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}, Mode=OneWay}" />
                                                                    <Run Text=": " />
                                                                    <Run Text="{Binding NextRun, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,0,7" Orientation="Horizontal">
                                                                <controls:AppIcon Width="14" Height="14" Margin="0,1,7,0"
                                                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                                  Data="{StaticResource IconHistory}" />
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                                    <Run Text="{Binding DataContext.Text.ScheduledTaskLastRun, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}, Mode=OneWay}" />
                                                                    <Run Text=": " />
                                                                    <Run Text="{Binding LastRun, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Margin="7,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                                           Text="{Binding LastRunResult}"
                                                                           Visibility="{Binding HasLastRunResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </controls:AdaptiveSplitPanel>

                                                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Button Margin="0,2,10,2" Style="{StaticResource FormPrimaryButtonStyle}"
                                                            Tag="{Binding Id}" IsEnabled="{Binding CanRun}"
                                                            Click="RunScheduledTask_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconPlay}" />
                                                            <TextBlock Text="{Binding DataContext.Text.RunScheduledTaskNow, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Width="38" Height="36" Margin="0,2,8,2" Padding="8"
                                                            Tag="{Binding Id}" IsEnabled="{Binding CanRun}"
                                                            Click="EditScheduledTask_Click"
                                                            ToolTip="{Binding DataContext.Text.EditScheduledTask, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}"
                                                            AutomationProperties.Name="{Binding DataContext.Text.EditScheduledTask, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}">
                                                        <controls:AppIcon Data="{StaticResource IconEdit}" />
                                                    </Button>
                                                    <Button Width="38" Height="36" Margin="0,2" Padding="8"
                                                            Tag="{Binding Id}" IsEnabled="{Binding CanRun}"
                                                            Click="DeleteScheduledTask_Click"
                                                            ToolTip="{Binding DataContext.Text.DeleteScheduledTask, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}"
                                                            AutomationProperties.Name="{Binding DataContext.Text.DeleteScheduledTask, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}">
                                                        <controls:AppIcon Data="{StaticResource IconDelete}" />
                                                    </Button>
                                                </WrapPanel>
                                            </controls:AdaptiveSplitPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SchedulerHistory}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconHistory}"
                                                Heading="{Binding Text.SchedulerHistoryTab}">
                            <controls:SectionHeader.Metadata>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="ScheduledTaskHistory.Count" />
                                    <Binding Path="ScheduledTaskHistoryTotalCount" />
                                </MultiBinding>
                            </controls:SectionHeader.Metadata>
                            <controls:SectionHeader.Actions>
                                <Button Style="{StaticResource SectionActionButtonStyle}"
                                        IsEnabled="{Binding HasScheduledTaskHistory}"
                                        Click="ClearScheduledTaskHistory_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconDelete}" />
                                        <TextBlock Text="{Binding Text.ClearScheduledTaskHistory}" />
                                    </StackPanel>
                                </Button>
                            </controls:SectionHeader.Actions>
                        </controls:SectionHeader>

                        <controls:AdaptiveSplitPanel Margin="0,0,0,12" Gap="10"
                                                     SecondaryWeight="0" CompactBreakpoint="520">
                            <StackPanel>
                                <Grid>
                                    <TextBox x:Name="HistoryFilterTextBox" Padding="34,7,10,7"
                                             ToolTip="{Binding Text.ScheduledTaskHistoryFilterHint}"
                                             Text="{Binding HistoryFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <controls:AppIcon Width="15" Height="15" Margin="11,0,0,0"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                      Data="{StaticResource IconSearch}" />
                                </Grid>
                            </StackPanel>
                            <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Style="{StaticResource SectionActionButtonStyle}"
                                    IsEnabled="{Binding HasHistoryFilter}" Click="ClearHistoryFilter_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconClose}" />
                                    <TextBlock Text="{Binding Text.ClearScheduledTaskHistoryFilter}" />
                                </StackPanel>
                            </Button>
                        </controls:AdaptiveSplitPanel>

                        <StackPanel Margin="8,28" HorizontalAlignment="Center"
                                    Visibility="{Binding NoScheduledTaskHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controls:AppIcon Width="28" Height="28" HorizontalAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Data="{StaticResource IconHistory}" />
                            <TextBlock Margin="0,10,0,0" MaxWidth="420" TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding Text.NoScheduledTaskHistory}" />
                        </StackPanel>
                        <TextBlock Margin="8,24" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Text.NoMatchingScheduledTaskHistory}"
                                   Visibility="{Binding NoMatchingScheduledTaskHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ScrollViewer MaxHeight="520"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScheduledTaskHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="20,18" Style="{StaticResource CatalogRowStyle}">
                                            <controls:AdaptiveSplitPanel Gap="28" SecondaryWeight="0" CompactBreakpoint="900">
                                                <controls:AdaptiveSplitPanel Gap="34" PrimaryWeight="0.7" SecondaryWeight="1.3"
                                                                             CompactBreakpoint="680">
                                                    <Grid MinWidth="0" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="46" Height="46" VerticalAlignment="Top"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                BorderThickness="1" CornerRadius="7"
                                                                ToolTip="{Binding Command}"
                                                                AutomationProperties.Name="{Binding Command}">
                                                            <controls:BrandLogo Width="30" Height="30"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                Brand="{Binding Brand}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" MinWidth="0">
                                                            <TextBlock FontSize="16" FontWeight="SemiBold"
                                                                       Text="{Binding TaskName}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding TaskName}" />
                                                            <TextBlock Margin="0,5,0,0"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Target}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Target}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <WrapPanel VerticalAlignment="Center">
                                                        <controls:AppIcon Width="18" Height="18" Margin="0,0,24,8"
                                                                          ToolTip="{Binding Result}"
                                                                          AutomationProperties.Name="{Binding Result}">
                                                            <controls:AppIcon.Style>
                                                                <Style TargetType="{x:Type controls:AppIcon}"
                                                                       BasedOn="{StaticResource AppIconBaseStyle}">
                                                                    <Setter Property="Data" Value="{StaticResource IconFailure}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource IconSuccess}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </controls:AppIcon.Style>
                                                        </controls:AppIcon>
                                                        <StackPanel Margin="0,0,24,8" Orientation="Horizontal">
                                                            <controls:AppIcon Width="14" Height="14" Margin="0,1,7,0"
                                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                              Data="{StaticResource IconHistory}" />
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Started}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,24,8" Orientation="Horizontal">
                                                            <controls:AppIcon Width="14" Height="14" Margin="0,1,7,0"
                                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                              Data="{StaticResource IconDuration}" />
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Duration}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                                            <controls:AppIcon Width="14" Height="14" Margin="0,1,7,0"
                                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                              Data="{StaticResource IconPlay}" />
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Trigger}" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </controls:AdaptiveSplitPanel>
                                                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Button Margin="0,2,8,2" Style="{StaticResource SectionActionButtonStyle}"
                                                            Tag="{Binding Id}" Click="ViewScheduledTaskLog_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconDetails}" />
                                                            <TextBlock Text="{Binding DataContext.Text.ViewScheduledTaskLog, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Margin="0,2" Style="{StaticResource SectionActionButtonStyle}"
                                                            Tag="{Binding Id}" Click="DeleteScheduledTaskLog_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconDelete}" />
                                                            <TextBlock Text="{Binding DataContext.Text.DeleteScheduledTaskLog, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </controls:AdaptiveSplitPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
