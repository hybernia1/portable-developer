<UserControl x:Class="PortableDeveloper.App.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SettingsGeneral}">
                <controls:FormSection MaxWidth="820" HorizontalAlignment="Stretch"
                                      Icon="{StaticResource IconCode}"
                                      Heading="{Binding Text.EditorSelection}"
                                      Description="{Binding Text.EditorSelectionHelp}"
                                      Feedback="{Binding EditorStatus}">
                    <controls:FormSection.Body>
                        <StackPanel MaxWidth="420" HorizontalAlignment="Stretch">
                            <ComboBox SelectedValuePath="Tag"
                                      SelectedValue="{Binding EditorPreferenceName, Mode=OneWay}"
                                      SelectionChanged="EditorPreferenceSelector_SelectionChanged">
                                <ComboBoxItem Tag="PortableWhenAvailable" Content="{Binding Text.PreferPortableEditor}" />
                                <ComboBoxItem Tag="WindowsDefault" Content="{Binding Text.UseWindowsDefaultEditor}" />
                            </ComboBox>
                        </StackPanel>
                    </controls:FormSection.Body>
                </controls:FormSection>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SettingsStorage}">
                <StackPanel>
                    <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18" MaxWidth="820" HorizontalAlignment="Stretch">
                        <StackPanel IsEnabled="{Binding StorageActionsEnabled}">
                            <controls:SectionHeader Icon="{StaticResource IconPackage}"
                                                    Heading="{Binding Text.CacheManagement}"
                                                    Description="{Binding Text.CacheManagementHelp}">
                                <controls:SectionHeader.Actions>
                                    <WrapPanel>
                                        <Button Margin="0,0,8,0" Style="{StaticResource SectionActionButtonStyle}"
                                                Click="RefreshStorageUsage_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconRefresh}" />
                                                <TextBlock Text="{Binding Text.RefreshStorage}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SectionActionButtonStyle}"
                                                IsEnabled="{Binding CanClearAllCaches}"
                                                Click="ClearAllStorageCaches_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconDelete}" />
                                                <TextBlock Text="{Binding Text.ClearAllCaches}" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </controls:SectionHeader.Actions>
                            </controls:SectionHeader>
                            <Border Padding="12,4" Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Text.RuntimePackageCache}" />
                                    <TextBlock Grid.Column="1" Margin="18,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding RuntimePackageCacheSize}" />
                                    <Button Grid.Column="2" Margin="6,5,0,5" Tag="RuntimePackages"
                                            IsEnabled="{Binding CanClearRuntimePackageCache}"
                                            Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding Text.ComposerCache}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="18,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ComposerCacheSize}" />
                                    <Button Grid.Row="1" Grid.Column="2" Margin="6,5,0,5" Tag="Composer"
                                            IsEnabled="{Binding CanClearComposerCache}"
                                            Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding Text.NpmCache}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="18,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding NpmCacheSize}" />
                                    <Button Grid.Row="2" Grid.Column="2" Margin="6,5,0,5" Tag="Npm"
                                            IsEnabled="{Binding CanClearNpmCache}"
                                            Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{Binding Text.PipCache}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="18,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PipCacheSize}" />
                                    <Button Grid.Row="3" Grid.Column="2" Margin="6,5,0,5" Tag="Pip"
                                            IsEnabled="{Binding CanClearPipCache}"
                                            Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                    <Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0" />
                                    <TextBlock Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.TotalCache}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="18,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"
                                               Text="{Binding TotalCacheSize}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,13,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding StorageStatus}"
                                       Visibility="{Binding StorageStatus, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCardStyle}" MaxWidth="820" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <controls:SectionHeader Icon="{StaticResource IconShield}"
                                                    Heading="{Binding Text.ProtectedStorage}"
                                                    Description="{Binding Text.ProtectedStorageHelp}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Text.InstalledRuntimes}" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding InstalledRuntimeSize}" />
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Text.PersistentProjectData}" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding PersistentDataSize}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SettingsAbout}">
                <Border Style="{StaticResource PanelCardStyle}" MaxWidth="820" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconInfo}"
                                                Heading="{Binding Text.TechnicalDetails}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding Text.ApplicationVersion}" />
                        <TextBlock Text="{Binding ApplicationVersion}" />
                        <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                            <Run Text="Apache " /><Run Text="{Binding ApachePort, Mode=OneWay}" /><Run Text="  •  PHP FastCGI " />
                            <Run Text="{Binding PhpFastCgiPort, Mode=OneWay}" /><Run Text="  •  MariaDB " /><Run Text="{Binding MariaDbPort, Mode=OneWay}" />
                            <Run Text="  •  Selenium " /><Run Text="{Binding SeleniumPort, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
