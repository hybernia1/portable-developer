<UserControl x:Class="PortableDeveloper.App.Views.ProjectsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
             xmlns:views="clr-namespace:PortableDeveloper.App.Views">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Text="{Binding StatusText}"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}" />

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=ProjectsOverview}">
                <StackPanel>
                    <Border Margin="0,0,0,14" Style="{StaticResource PanelCardStyle}"
                            Visibility="{Binding WebConfigurationRestartPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <controls:AdaptiveSplitPanel SecondaryWeight="0">
                            <StackPanel Margin="0,0,24,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:AppIcon Margin="0,0,10,0" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                  Data="{StaticResource IconWarning}" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap" Text="{Binding Text.WebConfigurationRestartPending}" />
                            </StackPanel>
                            <Button Padding="14,8" HorizontalAlignment="Left"
                                    IsEnabled="{Binding WebConfigurationApplyEnabled}"
                                    Click="ApplyWebConfiguration_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconRefresh}" />
                                    <TextBlock Text="{Binding Text.ApplyWebConfiguration}" />
                                </StackPanel>
                            </Button>
                        </controls:AdaptiveSplitPanel>
                    </Border>

                    <controls:AdaptiveSplitPanel PrimaryWeight="0.72" SecondaryWeight="1.28">
                        <Border MinHeight="430" MaxHeight="520" Style="{StaticResource PanelCardStyle}">
                            <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource MasterListItemStyle}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.Resources>
                                    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush"
                                                     Color="{DynamicResource SubtleFillColorSecondary}" />
                                    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush"
                                                     Color="{DynamicResource SubtleFillColorTertiary}" />
                                    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush"
                                                     Color="{DynamicResource SubtleFillColorSecondary}" />
                                    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush"
                                                     Color="{DynamicResource TextFillColorPrimary}" />
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="72">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" Margin="0,9" CornerRadius="2"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Border Grid.Column="1" Width="32" Height="32" Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="6">
                                                <controls:AppIcon Width="18" Height="18" Data="{StaticResource IconProject}" />
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="10,10,8,10" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Margin="0,4,0,0" FontFamily="Cascadia Mono,Consolas" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RootRelativePath}"
                                                           Text="{Binding RootRelativePath}" />
                                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                    <controls:AppIcon Width="13" Height="13" Margin="0,0,5,0"
                                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                      Data="{StaticResource IconCode}" />
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding Capabilities}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="3" Margin="4,10,10,0" Padding="7,2"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding DataContext.Text.ActiveProjectBadge, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border MinHeight="430" Style="{StaticResource PanelCardStyle}">
                            <ContentControl Content="{Binding SelectedProject}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" Margin="0,0,12,0"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="7">
                                                    <controls:AppIcon Width="20" Height="20" Data="{StaticResource IconProject}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Margin="0,4,0,0" FontFamily="Cascadia Mono,Consolas" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="{Binding RootRelativePath}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RootRelativePath}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Margin="12,0,0,0" Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="9"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding DataContext.Text.ActiveProjectBadge, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                </Border>
                                            </Grid>

                                            <Border Margin="0,0,0,16" Padding="12"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectoryAvailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:AppIcon Margin="0,0,9,0"
                                                                      Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                      Data="{StaticResource IconWarning}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               TextWrapping="Wrap" Text="{Binding Availability}" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Margin="0,0,0,9" FontSize="12" FontWeight="SemiBold"
                                                       Text="{Binding DataContext.Text.ProjectTools, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                            <WrapPanel>
                                                <Button Margin="0,0,8,8" Padding="12,8" Tag="{Binding Id}"
                                                        IsEnabled="{Binding IsDirectoryAvailable}" Click="OpenManagedProject_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconOpenFolder}" />
                                                        <TextBlock Text="{Binding DataContext.Text.OpenProjectDirectory, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="0,0,8,8" Padding="12,8" Tag="{Binding Id}"
                                                        IsEnabled="{Binding IsDirectoryAvailable}" Click="OpenProjectFiles_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconFile}" />
                                                        <TextBlock Text="{Binding DataContext.Text.OpenFiles, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="0,0,8,8" Padding="12,8" Tag="{Binding Id}"
                                                        IsEnabled="{Binding IsDirectoryAvailable}" Click="OpenProjectTerminal_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconTerminal}" />
                                                        <TextBlock Text="{Binding DataContext.Text.OpenTerminal, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="0,0,0,8" Padding="12,8" Tag="{Binding Id}"
                                                        Click="OpenWebProjectUrl_Click">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DefaultButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWebConfiguration}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsWebEnabled}" Value="True" />
                                                                        <Condition Binding="{Binding DataContext.ApacheIsRunning, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconGlobe}" />
                                                        <TextBlock Text="{Binding DataContext.Text.OpenWebUrl, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>

                                            <Border Height="1" Margin="0,10,0,16" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconCode}" />
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Text="{Binding DataContext.Text.ProjectCapabilities, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                </StackPanel>
                                                <TextBlock Margin="24,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding Capabilities}" />
                                                <TextBlock Margin="24,5,0,0" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextWrapping="Wrap" Text="{Binding RuntimeReadiness}" />
                                            </StackPanel>

                                            <Border Height="1" Margin="0,16" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />

                                            <controls:AdaptiveSplitPanel Gap="16" SecondaryWeight="0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconGlobe}" />
                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                   Text="{Binding DataContext.Text.WebSupport, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="24,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding WebStatus}" />
                                                    <TextBlock Margin="24,4,0,0" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="{Binding WebDetail}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="24,4,0,0" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="{Binding HtaccessStatus}"
                                                               Visibility="{Binding HasWebConfiguration, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Margin="24,4,0,0" FontFamily="Cascadia Mono,Consolas" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="{Binding HostName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HostName}"
                                                               Visibility="{Binding HasWebConfiguration, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <Button Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Tag="{Binding Id}" IsEnabled="{Binding IsDirectoryAvailable}"
                                                        Click="ConfigureProjectWeb_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconGear}" />
                                                        <TextBlock Text="{Binding DataContext.Text.ConfigureWebProject, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                    </StackPanel>
                                                </Button>
                                            </controls:AdaptiveSplitPanel>

                                            <StackPanel Margin="0,20,0,0"
                                                        Visibility="{Binding CanUnregister, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Height="1" Margin="0,0,0,16" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <StackPanel Margin="0,0,0,9" Orientation="Horizontal">
                                                    <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconManage}" />
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Text="{Binding DataContext.Text.ProjectManagement, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                </StackPanel>
                                                <WrapPanel>
                                                    <Button Margin="0,0,8,8" Padding="11,7" Tag="{Binding Id}"
                                                            Click="RenameProject_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconEdit}" />
                                                            <TextBlock Text="{Binding DataContext.Text.RenameProject, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Margin="0,0,0,8" Padding="11,7" Tag="{Binding Id}"
                                                            Click="UnregisterProject_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconRemove}" />
                                                            <TextBlock Text="{Binding DataContext.Text.UnregisterProject, RelativeSource={RelativeSource AncestorType={x:Type views:ProjectsPageView}}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Border>
                    </controls:AdaptiveSplitPanel>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=ProjectsCreate}">
                <controls:FormSection MaxWidth="760" HorizontalAlignment="Left"
                                      Icon="{StaticResource IconProject}"
                                      Heading="{Binding Text.CreateGeneralProject}">
                    <controls:FormSection.Body>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="{Binding Text.ProjectName}" />
                        <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,6" Style="{StaticResource FormFieldLabelStyle}"
                                   Text="{Binding Text.ProjectTemplate}" />
                        <ComboBox ItemsSource="{Binding ProjectTemplates}"
                                  DisplayMemberPath="Name" SelectedValuePath="Kind"
                                  SelectedValue="{Binding SelectedTemplateKind, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource FormHelpTextStyle}"
                                   TextWrapping="Wrap" Text="{Binding SelectedTemplateDescription}" />
                    </StackPanel>
                    </controls:FormSection.Body>
                    <controls:FormSection.Actions>
                        <Button Style="{StaticResource FormPrimaryButtonStyle}"
                                Click="CreateGeneralProject_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconAdd}" />
                                <TextBlock Text="{Binding Text.CreateProject}" />
                            </StackPanel>
                        </Button>
                    </controls:FormSection.Actions>
                </controls:FormSection>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=ProjectsAdd}">
                <controls:FormSection MaxWidth="760" HorizontalAlignment="Left"
                                      Icon="{StaticResource IconDependency}"
                                      Heading="{Binding Text.AddExistingProject}">
                    <controls:FormSection.Body>
                    <StackPanel>
                        <Border Margin="0,0,0,16" Style="{StaticResource InlineInfoPanelStyle}"
                                Visibility="{Binding NoRegistrableProjectDirectories, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:AppIcon Width="16" Height="16" Margin="0,1,0,0"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Data="{StaticResource IconInfo}" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Text="{Binding Text.NoExistingProjectDirectories}" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource FormFieldLabelStyle}"
                                   Text="{Binding Text.ExistingProjectDirectory}" />
                        <ComboBox ItemsSource="{Binding RegistrableProjectDirectories}"
                                  DisplayMemberPath="RootRelativePath" SelectedValuePath="DirectoryId"
                                  SelectedValue="{Binding SelectedExistingDirectoryId, Mode=TwoWay}" />
                        <TextBlock Margin="0,14,0,6" Style="{StaticResource FormFieldLabelStyle}"
                                   Text="{Binding Text.ExistingProjectName}" />
                        <TextBox Text="{Binding ExistingProjectName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    </controls:FormSection.Body>
                    <controls:FormSection.Actions>
                        <Button Style="{StaticResource FormPrimaryButtonStyle}"
                                Click="RegisterExistingProject_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconDependency}" />
                                <TextBlock Text="{Binding Text.RegisterProject}" />
                            </StackPanel>
                        </Button>
                    </controls:FormSection.Actions>
                </controls:FormSection>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
