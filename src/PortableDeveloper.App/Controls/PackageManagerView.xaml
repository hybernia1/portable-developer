<UserControl x:Class="PortableDeveloper.App.Controls.PackageManagerView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="0,0,0,18" Style="{StaticResource PanelCardStyle}">
                <controls:AdaptiveSplitPanel SecondaryWeight="0" CompactBreakpoint="700">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:BrandLogo Width="36" Height="36" Margin="0,2,12,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Brand="{Binding BrandLogo, ElementName=Root}" />
                        <StackPanel Grid.Column="1" MinWidth="0">
                            <WrapPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold"
                                           Text="{Binding HeaderTitle, ElementName=Root}" />
                                <TextBlock Margin="14,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Page.RuntimeVersion, ElementName=Root}" />
                            </WrapPanel>
                            <TextBlock Margin="0,7,20,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding Page.ProjectRelativePath, ElementName=Root}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel VerticalAlignment="Center">
                        <Button Margin="0,0,8,8" Padding="13,9" Click="OpenProject_Click"
                                AutomationProperties.Name="{Binding DataContext.Text.OpenProjectDirectory, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconOpenFolder}"
                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding DataContext.Text.OpenProjectDirectory, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,0,8" Padding="13,9" Click="RefreshPackages_Click"
                                IsEnabled="{Binding Page.CanOperate, ElementName=Root}"
                                AutomationProperties.Name="{Binding DataContext.Text.RefreshPackages, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconRefresh}"
                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding DataContext.Text.RefreshPackages, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </controls:AdaptiveSplitPanel>
            </Border>

            <ContentControl Grid.Row="1" Margin="0,0,0,18"
                            Content="{Binding Page, ElementName=Root}"
                            ContentTemplate="{StaticResource OperationProgressTemplate}"
                            Visibility="{Binding Page.OperationVisible, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <controls:AdaptiveSplitPanel Grid.Row="2" MinHeight="0"
                                         PrimaryWeight="0.78" SecondaryWeight="1.62"
                                         CompactBreakpoint="900">
                <controls:FormSection Icon="{StaticResource IconInstall}"
                                      Heading="{Binding DataContext.Text.AddPackage, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}">
                    <controls:FormSection.HeaderActions>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="ShowHelp_Click"
                                ToolTip="{Binding DataContext.Text.MoreInformation, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}"
                                AutomationProperties.Name="{Binding DataContext.Text.MoreInformation, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}">
                            <controls:AppIcon Data="{StaticResource IconInfo}"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </controls:FormSection.HeaderActions>
                    <controls:FormSection.Body>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FormFieldLabelStyle}"
                                   Text="{Binding DataContext.Text.PackageName, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />
                        <TextBox IsEnabled="{Binding Page.CanOperate, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}"
                                 Text="{Binding PackageNameInput, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FormHelpTextStyle}"
                                   Text="{Binding PackageExample, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />

                        <TextBlock Margin="0,14,0,6" Style="{StaticResource FormFieldLabelStyle}"
                                   Text="{Binding DataContext.Text.VersionConstraint, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />
                        <TextBox IsEnabled="{Binding Page.CanOperate, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}"
                                 Text="{Binding VersionConstraintInput, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FormHelpTextStyle}"
                                   Text="{Binding ConstraintExample, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />

                        <Border Margin="0,18,0,0" Style="{StaticResource InlineInfoPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:AppIcon Width="18" Height="18" Margin="0,1,0,0"
                                                  VerticalAlignment="Top" Data="{StaticResource IconShield}"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding DataContext.Text.PackageNetworkNotice, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    </controls:FormSection.Body>
                    <controls:FormSection.Actions>
                        <Button Style="{StaticResource FormPrimaryButtonStyle}"
                                IsEnabled="{Binding Page.CanOperate, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}"
                                Click="InstallPackage_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconInstall}"
                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding DataContext.Text.InstallPackage, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />
                            </StackPanel>
                        </Button>
                    </controls:FormSection.Actions>
                </controls:FormSection>

                <Border Style="{StaticResource PanelCardStyle}">
                    <Grid MinHeight="360">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <controls:SectionHeader Icon="{StaticResource IconPackage}"
                                                Heading="{Binding DataContext.Text.InstalledPackages, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}"
                                                Metadata="{Binding Page.DirectPackages.Count, ElementName=Root}" />

                        <StackPanel Grid.Row="1">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Page.DirectPackages, ElementName=Root}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Style="{StaticResource CatalogRowStyle}">
                                                <controls:AdaptiveSplitPanel Gap="12" SecondaryWeight="0">
                                                    <Grid MinWidth="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <controls:AppIcon Width="18" Height="18" Margin="0,1,0,0"
                                                                          VerticalAlignment="Top" Data="{StaticResource IconPackage}"
                                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <StackPanel Grid.Column="1" MinWidth="0">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                            <TextBlock Margin="0,4,12,0" FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       Text="{Binding Description}" TextWrapping="Wrap"
                                                                       Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" />
                                                            <TextBlock Margin="0,7,0,0" FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Version}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <WrapPanel VerticalAlignment="Center">
                                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                            <controls:AppIcon Width="14" Height="14" Margin="0,0,6,0"
                                                                              Data="{StaticResource IconDependency}"
                                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       Text="{Binding DataContext.Text.DirectDependency, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />
                                                        </StackPanel>
                                                        <Button Padding="11,7" Tag="{Binding Name}"
                                                                IsEnabled="{Binding Page.CanOperate, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}"
                                                                Click="RemovePackage_Click"
                                                                AutomationProperties.Name="{Binding DataContext.Text.RemovePackage, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconDelete}"
                                                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                <TextBlock Text="{Binding DataContext.Text.RemovePackage, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </controls:AdaptiveSplitPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Margin="0,4,0,0"
                                          Visibility="{Binding Page.HasTransitivePackages, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding DataContext.Text.TransitiveDependencies, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}" />
                                            <TextBlock Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Page.TransitivePackages.Count, ElementName=Root}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <ScrollViewer Margin="0,8,0,0" MaxHeight="300"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Page.TransitivePackages, ElementName=Root}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="10,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <controls:AppIcon Width="13" Height="13" Data="{StaticResource IconPackage}"
                                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Grid.Column="2" Margin="12,0,0,0"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Text="{Binding Version}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="20" HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Page.NoPackages, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <controls:AppIcon Width="38" Height="38" HorizontalAlignment="Center"
                                              Data="{StaticResource IconPackage}"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Margin="0,14,0,0" MaxWidth="420" TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding DataContext.Text.NoInstalledPackages, RelativeSource={RelativeSource AncestorType={x:Type controls:PackageManagerView}}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </controls:AdaptiveSplitPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
