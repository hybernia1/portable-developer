<UserControl x:Class="PortableDeveloper.App.Controls.TransientNotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
             xmlns:viewModels="clr-namespace:PortableDeveloper.App.ViewModels"
             Focusable="False"
             MouseEnter="Host_MouseEnter"
             MouseLeave="Host_MouseLeave">
    <Border MaxWidth="420" Padding="14,12"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8"
            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:AppIcon Width="18" Height="18" Margin="0,1,0,0" VerticalAlignment="Top">
                <controls:AppIcon.Style>
                    <Style TargetType="{x:Type controls:AppIcon}" BasedOn="{StaticResource AppIconBaseStyle}">
                        <Setter Property="Data" Value="{StaticResource IconInfo}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Intent}" Value="{x:Static viewModels:TransientNotificationIntent.Success}">
                                <Setter Property="Data" Value="{StaticResource IconSuccess}" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Intent}" Value="{x:Static viewModels:TransientNotificationIntent.Error}">
                                <Setter Property="Data" Value="{StaticResource IconFailure}" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:AppIcon.Style>
            </controls:AppIcon>

            <TextBlock x:Name="LiveRegion" Grid.Column="1" Margin="8,0,12,0"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding Message}" TextWrapping="Wrap" />

            <Button Grid.Column="2" Width="30" Height="30" Padding="6"
                    VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="{Binding DataContext.Text.Close, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="{Binding DataContext.Text.Close, RelativeSource={RelativeSource AncestorType=Window}}"
                    Click="Dismiss_Click">
                <controls:AppIcon Width="14" Height="14" Data="{StaticResource IconClose}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
