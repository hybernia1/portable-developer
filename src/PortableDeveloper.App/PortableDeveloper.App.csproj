<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PortableDeveloper.Application\PortableDeveloper.Application.csproj" />
    <ProjectReference Include="..\PortableDeveloper.Infrastructure\PortableDeveloper.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PortableDeveloper</AssemblyName>
    <RootNamespace>PortableDeveloper.App</RootNamespace>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\portable-developer.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;cs</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\catalog\modules.json" Link="catalog\modules.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\portable-developer.ico" />
  </ItemGroup>

</Project>
