<UserControl x:Class="PortableDeveloper.App.Controls.AppSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedNavigation" Source="{Binding NavigationItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0"
                     Margin="12,12,0,0"
                     IsEnabled="{Binding CanNavigate}"
                     SelectionChanged="NavigationList_SelectionChanged"
                     ItemsSource="{Binding Source={StaticResource GroupedNavigation}}"
                     ItemContainerStyle="{StaticResource SidebarNavigationItemStyle}"
                     SelectedValuePath="Page"
                     SelectedValue="{Binding SelectedPage, Mode=OneWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DefaultScrollBarStyle}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                         Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush"
                                     Color="{DynamicResource SubtleFillColorSecondary}" />
                    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush"
                                     Color="{DynamicResource SubtleFillColorTertiary}" />
                    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush"
                                     Color="{DynamicResource SubtleFillColorSecondary}" />
                    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush"
                                     Color="{DynamicResource TextFillColorPrimary}" />
                </ListBox.Resources>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="10,12,8,4" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Name}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Margin="0,7" CornerRadius="2"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <controls:AppIcon Grid.Column="1" Margin="8,0,0,0"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="1.6">
                                <controls:AppIcon.Style>
                                    <Style TargetType="{x:Type controls:AppIcon}" BasedOn="{StaticResource AppIconBaseStyle}">
                                        <Setter Property="Data" Value="{StaticResource IconPackage}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Folder"><Setter Property="Data" Value="{StaticResource IconFolder}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Ports"><Setter Property="Data" Value="{StaticResource IconPorts}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Code"><Setter Property="Data" Value="{StaticResource IconCode}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Database"><Setter Property="Data" Value="{StaticResource IconDatabase}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Gear"><Setter Property="Data" Value="{StaticResource IconGear}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Schedule"><Setter Property="Data" Value="{StaticResource IconSchedule}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Terminal"><Setter Property="Data" Value="{StaticResource IconTerminal}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Guide"><Setter Property="Data" Value="{StaticResource IconGuide}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding UsesBrandLogo}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                    </Style>
                                </controls:AppIcon.Style>
                            </controls:AppIcon>
                            <controls:BrandLogo Grid.Column="1" Width="16" Height="16" Margin="8,0,0,0" Brand="{Binding BrandLogo}"
                                                Visibility="{Binding UsesBrandLogo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center"
                                       FontSize="14" Text="{Binding Label}" />
                            <Ellipse Grid.Column="3" Width="8" Height="8" Margin="9,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter Property="Visibility" Value="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Setter Property="ToolTip" Value="{Binding StatusText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Margin="22,14,20,12">
                <TextBlock Margin="0,0,0,6"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Text.Language}" />
                <ComboBox x:Name="LanguageSelector"
                          SelectionChanged="LanguageSelector_SelectionChanged"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Tag="Czech" Content="Česky" />
                    <ComboBoxItem Tag="English" Content="English" />
                </ComboBox>
                <TextBlock Margin="0,10,2,0"
                           HorizontalAlignment="Right"
                           FontSize="9"
                           Foreground="{DynamicResource TextFillColorDisabledBrush}"
                           Text="{Binding ApplicationVersion, StringFormat=v{0}}" />
            </StackPanel>
    </Grid>
</UserControl>
