<UserControl x:Class="PortableDeveloper.App.Views.SchedulerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
             xmlns:views="clr-namespace:PortableDeveloper.App.Views">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Text="{Binding StatusText}"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}" />

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SchedulerTasks}">
                <StackPanel>
                    <Border Margin="0,0,0,14" Style="{StaticResource PanelCardStyle}">
                        <controls:AdaptiveSplitPanel SecondaryWeight="0">
                            <TextBlock Margin="0,0,18,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding Text.SchedulerRunsOnlyWhileOpen}" />
                            <Button Padding="14,9" HorizontalAlignment="Left" Click="NewScheduledTask_Click"
                                    Content="{Binding Text.NewScheduledTask}" />
                        </controls:AdaptiveSplitPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SchedulerTasksTab}" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding ScheduledTasks.Count}" />
                            </Grid>

                            <TextBlock Margin="4,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Text.NoScheduledTasks}"
                                       Visibility="{Binding NoScheduledTasks, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <ScrollViewer MaxHeight="520"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,13" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <controls:AdaptiveSplitPanel Gap="18" SecondaryWeight="0">
                                                    <StackPanel MinWidth="0">
                                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Margin="0,5,16,0"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding Target}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Target}" />
                                                        <WrapPanel Margin="0,10,16,0">
                                                            <TextBlock Margin="0,0,18,4"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{Binding DataContext.Text.ScheduledTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}, Mode=OneWay}" />
                                                                <Run Text=": " />
                                                                <Run Text="{Binding Command, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,18,4"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{Binding DataContext.Text.ScheduledTaskSchedule, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}, Mode=OneWay}" />
                                                                <Run Text=": " />
                                                                <Run Text="{Binding Schedule, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold">
                                                                <Run Text="{Binding DataContext.Text.ScheduledTaskStatus, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}, Mode=OneWay}" />
                                                                <Run Text=": " />
                                                                <Run Text="{Binding Status, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </WrapPanel>
                                                        <TextBlock Margin="0,3,16,0" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Text="{Binding NextRun}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,3,16,0" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Text="{Binding LastRun}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Button Margin="0,2,8,2" Padding="12,8" Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanRun}" Click="RunScheduledTask_Click"
                                                                Content="{Binding DataContext.Text.RunScheduledTaskNow, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}" />
                                                        <Button Margin="0,2,8,2" Padding="12,8" Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanRun}" Click="EditScheduledTask_Click"
                                                                Content="{Binding DataContext.Text.EditScheduledTask, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}" />
                                                        <Button Margin="0,2" Padding="12,8" Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanRun}" Click="DeleteScheduledTask_Click"
                                                                Content="{Binding DataContext.Text.DeleteScheduledTask, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}" />
                                                    </WrapPanel>
                                                </controls:AdaptiveSplitPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SchedulerHistory}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <controls:AdaptiveSplitPanel Gap="18" SecondaryWeight="0">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SchedulerHistoryTab}" />
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding ScheduledTaskHistory.Count, Mode=OneWay}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding ScheduledTaskHistoryTotalCount, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Padding="12,8" HorizontalAlignment="Left"
                                    IsEnabled="{Binding HasScheduledTaskHistory}"
                                    Click="ClearScheduledTaskHistory_Click"
                                    Content="{Binding Text.ClearScheduledTaskHistory}" />
                        </controls:AdaptiveSplitPanel>

                        <controls:AdaptiveSplitPanel Margin="0,16,0,4" Gap="10" SecondaryWeight="0">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold"
                                           Text="{Binding Text.ScheduledTaskHistoryFilter}" />
                                <TextBox x:Name="HistoryFilterTextBox" Padding="10,7"
                                         ToolTip="{Binding Text.ScheduledTaskHistoryFilterHint}"
                                         Text="{Binding HistoryFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    IsEnabled="{Binding HasHistoryFilter}" Click="ClearHistoryFilter_Click"
                                    Content="{Binding Text.ClearScheduledTaskHistoryFilter}" />
                        </controls:AdaptiveSplitPanel>

                        <TextBlock Margin="4,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Text.NoScheduledTaskHistory}"
                                   Visibility="{Binding NoScheduledTaskHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="4,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Text.NoMatchingScheduledTaskHistory}"
                                   Visibility="{Binding NoMatchingScheduledTaskHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ScrollViewer MaxHeight="520"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScheduledTaskHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,13" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                            <controls:AdaptiveSplitPanel Gap="18" SecondaryWeight="0">
                                                <StackPanel MinWidth="0">
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding TaskName}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskName}" />
                                                    <WrapPanel Margin="0,9,16,0">
                                                        <TextBlock Margin="0,0,18,5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="{Binding DataContext.Text.ScheduledTaskStarted, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}, Mode=OneWay}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding Started, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,0,18,5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="{Binding DataContext.Text.ScheduledTaskDuration, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}, Mode=OneWay}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding Duration, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,0,18,5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="{Binding DataContext.Text.ScheduledTaskTriggerLabel, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}, Mode=OneWay}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding Trigger, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,0,0,5" FontWeight="SemiBold">
                                                            <Run Text="{Binding DataContext.Text.ScheduledTaskResult, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}, Mode=OneWay}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding Result, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Button Margin="0,2,8,2" Padding="12,8" Tag="{Binding Id}"
                                                            Click="ViewScheduledTaskLog_Click"
                                                            Content="{Binding DataContext.Text.ViewScheduledTaskLog, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}" />
                                                    <Button Margin="0,2" Padding="12,8" Tag="{Binding Id}"
                                                            Click="DeleteScheduledTaskLog_Click"
                                                            Content="{Binding DataContext.Text.DeleteScheduledTaskLog, RelativeSource={RelativeSource AncestorType={x:Type views:SchedulerPageView}}}" />
                                                </WrapPanel>
                                            </controls:AdaptiveSplitPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
