<UserControl x:Class="PortableDeveloper.App.Views.DatabasesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
             xmlns:views="clr-namespace:PortableDeveloper.App.Views">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <controls:RuntimeHeader Margin="0,0,0,18"
                                    Brand="mariadb"
                                    Heading="MariaDB"
                                    State="{Binding MariaDbService.State}"
                                    IsRunning="{Binding MariaDbIsRunning}"
                                    Version="{Binding MariaDbService.Version}"
                                    Detail="{Binding MariaDbHeaderDetail}"
                                    Feedback="{Binding StatusText}">
                <controls:RuntimeHeader.Actions>
                    <Button HorizontalAlignment="Left"
                            Style="{StaticResource RuntimePrimaryButtonStyle}"
                            IsEnabled="{Binding MariaDbActionEnabled}"
                            Click="ToggleMariaDb_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Width="15" Height="15" Margin="0,0,8,0">
                                <controls:AppIcon.Style>
                                    <Style TargetType="{x:Type controls:AppIcon}"
                                           BasedOn="{StaticResource AppIconBaseStyle}">
                                        <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MariaDbIsRunning}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconStop}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:AppIcon.Style>
                            </controls:AppIcon>
                            <TextBlock Text="{Binding MariaDbActionLabel}" />
                        </StackPanel>
                    </Button>
                </controls:RuntimeHeader.Actions>
            </controls:RuntimeHeader>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=DatabasesOverview}">
                <Border Margin="0,0,0,18" Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconPorts}"
                                                Heading="{Binding Text.ConnectionDetails}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Host}" />
                        <TextBlock Text="127.0.0.1" />
                        <TextBlock Margin="0,13,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Port}" />
                        <TextBlock Text="{Binding MariaDbPort}" />
                        <TextBlock Margin="0,13,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.User}" />
                        <TextBlock Text="root" />
                        <TextBlock Margin="0,13,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Password}" />
                        <TextBlock Text="{Binding RootPasswordState}" />
                        <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding Text.RootAccountNote}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=DatabasesAdministration}">
                <controls:AdaptiveSplitPanel Margin="0,0,0,18">
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <controls:SectionHeader Icon="{StaticResource IconShield}"
                                                    Heading="{Binding Text.RootPasswordSecurity}"
                                                    Description="{Binding Text.PasswordGuidance}" />
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding RootPasswordState}" />
                                <TextBlock Style="{StaticResource FormFieldLabelStyle}"
                                           Text="{Binding Text.NewPassword}" />
                                <PasswordBox x:Name="RootPasswordBox"
                                             PasswordChanged="PasswordInput_PasswordChanged" />
                                <TextBlock Margin="0,14,0,6" Style="{StaticResource FormFieldLabelStyle}"
                                           Text="{Binding Text.ConfirmPassword}" />
                                <PasswordBox x:Name="ConfirmRootPasswordBox"
                                             PasswordChanged="PasswordInput_PasswordChanged" />
                            </StackPanel>
                            <Border Style="{StaticResource FormActionFooterStyle}">
                                <Button HorizontalAlignment="Left"
                                        Style="{StaticResource FormPrimaryButtonStyle}"
                                        IsEnabled="{Binding DatabaseActionsEnabled}"
                                        Click="ChangeRootPassword_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconSave}" />
                                        <TextBlock Text="{Binding RootPasswordActionLabel}" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCardStyle}"
                            Visibility="{Binding PhpMyAdminInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <controls:SectionHeader Icon="{StaticResource IconGlobe}"
                                                    Heading="phpMyAdmin 5.2.3">
                                <controls:SectionHeader.Actions>
                                    <Button Style="{StaticResource SectionActionButtonStyle}"
                                            IsEnabled="{Binding PhpMyAdminActionEnabled}"
                                            Click="OpenPhpMyAdmin_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconGlobe}" />
                                            <TextBlock Text="{Binding Text.OpenPhpMyAdmin}" />
                                        </StackPanel>
                                    </Button>
                                </controls:SectionHeader.Actions>
                            </controls:SectionHeader>
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="URL" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding PhpMyAdminUrl}" />
                            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding PhpMyAdminDependencyState}" />
                        </StackPanel>
                    </Border>
                </controls:AdaptiveSplitPanel>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=DatabasesCatalog}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconDatabase}"
                                                Heading="{Binding Text.DatabaseOverview}"
                                                Metadata="{Binding DatabaseCount}">
                            <controls:SectionHeader.Actions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FormPrimaryButtonStyle}"
                                            IsEnabled="{Binding DatabaseActionsEnabled}"
                                            Click="CreateDatabase_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconAdd}" />
                                            <TextBlock Text="{Binding Text.CreateDatabase}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="8,0,0,0"
                                            Style="{StaticResource SectionActionButtonStyle}"
                                            IsEnabled="{Binding DatabaseActionsEnabled}"
                                            Click="RefreshDatabases_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconRefresh}" />
                                            <TextBlock Text="{Binding Text.Refresh}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SectionHeader.Actions>
                        </controls:SectionHeader>
                        <ScrollViewer MaxHeight="420"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Databases}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Margin="0,6,0,0" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{Binding DataContext.Text.ApproximateSize, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}, Mode=OneWay}" />
                                                        <Run Text=": " />
                                                        <Run Text="{Binding ApproximateSize, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,6,12,0" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="{Binding DataContext.Text.DefaultDatabaseCannotBeDeleted, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" Margin="16,0,0,0"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Margin="0,2,8,2" Padding="12,8" Tag="{Binding Name}"
                                                            IsEnabled="{Binding DataContext.PhpMyAdminActionEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}"
                                                            ToolTip="{Binding DataContext.PhpMyAdminDependencyState, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}"
                                                            Click="ManageDatabase_Click"
                                                            Content="{Binding DataContext.Text.ManageDatabase, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}" />
                                                    <Button Margin="0,2" Padding="12,8" Tag="{Binding Name}"
                                                            Click="DeleteDatabase_Click"
                                                            Content="{Binding DataContext.Text.DeleteDatabase, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}">
                                                        <Button.Style>
                                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DefaultButtonStyle}">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding CanDelete}" Value="True" />
                                                                            <Condition Binding="{Binding DataContext.DatabaseActionsEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
