<Window x:Class="PortableDeveloper.App.ScheduledTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
        Width="560" Height="690" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppDialogWindowStyle}"
        Background="{StaticResource AppWindowBrush}" Foreground="{StaticResource AppForegroundBrush}"
        Icon="Assets/portable-developer.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <controls:AppTitleBar ShowMinimizeButton="False" ShowMaximizeButton="False" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="NameLabel" FontWeight="SemiBold" />
                <TextBox x:Name="NameTextBox" Grid.Row="1" Margin="0,7,0,15" Style="{StaticResource AppTextBoxStyle}" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CommandLabel" FontWeight="SemiBold" />
                        <ComboBox x:Name="CommandComboBox" Margin="0,7,0,0" Style="{StaticResource AppComboBoxStyle}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ScheduleLabel" FontWeight="SemiBold" />
                        <ComboBox x:Name="ScheduleComboBox" Margin="0,7,0,0" Style="{StaticResource AppComboBoxStyle}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ScheduleComboBox_SelectionChanged" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,15,0,0">
                    <TextBlock x:Name="TargetLabel" FontWeight="SemiBold" />
                    <TextBox x:Name="TargetTextBox" Margin="0,7,0,0" Style="{StaticResource AppTextBoxStyle}" />
                    <TextBlock x:Name="TargetHelpText" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,15,0,0">
                    <TextBlock x:Name="ArgumentsLabel" FontWeight="SemiBold" />
                    <TextBox x:Name="ArgumentsTextBox" Margin="0,7,0,0" Style="{StaticResource AppTextBoxStyle}" />
                    <TextBlock x:Name="ArgumentsHelpText" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="IntervalPanel">
                        <TextBlock x:Name="IntervalLabel" FontWeight="SemiBold" />
                        <TextBox x:Name="IntervalTextBox" Margin="0,7,0,0" Style="{StaticResource AppTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="TimePanel" Grid.Column="2">
                        <TextBlock x:Name="TimeLabel" FontWeight="SemiBold" />
                        <TextBox x:Name="TimeTextBox" Margin="0,7,0,0" Style="{StaticResource AppTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="DayPanel" Grid.Row="6" Margin="0,15,0,0">
                    <TextBlock x:Name="DayLabel" FontWeight="SemiBold" />
                    <ComboBox x:Name="DayComboBox" Margin="0,7,0,0" Style="{StaticResource AppComboBoxStyle}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" />
                </StackPanel>

                <StackPanel Grid.Row="7" Margin="0,15,0,0">
                    <TextBlock x:Name="TimeoutLabel" FontWeight="SemiBold" />
                    <TextBox x:Name="TimeoutTextBox" Margin="0,7,0,0" Style="{StaticResource AppTextBoxStyle}" />
                </StackPanel>

                <CheckBox x:Name="EnabledCheckBox" Grid.Row="8" Margin="0,18,0,0" Foreground="{StaticResource AppForegroundBrush}" />
                <TextBlock x:Name="ValidationText" Grid.Row="9" Margin="0,12,0,0"
                           Foreground="{StaticResource AppValidationBrush}" TextWrapping="Wrap" />

                <StackPanel Grid.Row="10" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Margin="0,0,8,0" Style="{StaticResource AppDialogButtonStyle}"
                            IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="SaveButton" Style="{StaticResource AppDialogPrimaryButtonStyle}"
                            IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
