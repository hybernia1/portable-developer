<Window x:Class="PortableDeveloper.App.NamePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="205" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#101725" Foreground="#E8EDF5"
        Icon="Assets/portable-developer.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox x:Name="NameTextBox" Grid.Row="1" Margin="0,13,0,0" Padding="11,9"
                 Foreground="#E8EDF5" Background="#0B111D" BorderBrush="#4A6388"
                 CaretBrush="#E8EDF5" KeyDown="NameTextBox_KeyDown" />
        <TextBlock x:Name="ValidationText" Grid.Row="2" Margin="0,8,0,0"
                   Foreground="#F1C46B" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton" MinWidth="88" Padding="13,8" Margin="0,0,8,0"
                    Foreground="#E8EDF5" Background="#253650" BorderBrush="#4A6388"
                    IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" MinWidth="88" Padding="13,8"
                    Foreground="#F5F7FA" Background="#2D6A4F" BorderBrush="#4F9A70"
                    IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
