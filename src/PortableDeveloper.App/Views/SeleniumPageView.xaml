<UserControl x:Class="PortableDeveloper.App.Views.SeleniumPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <controls:RuntimeHeader Margin="0,0,0,18"
                                    Brand="selenium"
                                    Heading="Selenium Server"
                                    State="{Binding SeleniumService.State}"
                                    IsRunning="{Binding SeleniumIsRunning}"
                                    Version="{Binding SeleniumService.Version}"
                                    Detail="{Binding SeleniumHeaderDetail}"
                                    Feedback="{Binding StatusText}">
                <controls:RuntimeHeader.Actions>
                    <WrapPanel>
                        <Button Margin="0,0,10,0"
                                Style="{StaticResource RuntimeSecondaryButtonStyle}"
                                Visibility="{Binding SeleniumIsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="OpenSeleniumHub_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Width="15" Height="15" Margin="0,0,8,0"
                                                  Data="{StaticResource IconGlobe}" />
                                <TextBlock Text="{Binding Text.OpenSeleniumHub}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RuntimePrimaryButtonStyle}"
                                IsEnabled="{Binding SeleniumActionEnabled}"
                                Click="ToggleSelenium_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Width="15" Height="15" Margin="0,0,8,0">
                                    <controls:AppIcon.Style>
                                        <Style TargetType="{x:Type controls:AppIcon}"
                                               BasedOn="{StaticResource AppIconBaseStyle}">
                                            <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SeleniumIsRunning}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IconStop}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:AppIcon.Style>
                                </controls:AppIcon>
                                <TextBlock Text="{Binding SeleniumActionLabel}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </controls:RuntimeHeader.Actions>
            </controls:RuntimeHeader>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SeleniumSettings}">
                <controls:FormSection Icon="{StaticResource IconGear}"
                                      Heading="{Binding Text.SeleniumSettings}">
                    <controls:FormSection.Body>
                        <StackPanel>
                            <controls:AdaptiveSplitPanel Gap="14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormFieldLabelStyle}"
                                               Text="{Binding Text.MaximumSessions}" />
                                    <TextBox IsEnabled="{Binding SeleniumSettingsEnabled}"
                                             Text="{Binding MaximumSessionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormFieldLabelStyle}"
                                               Text="{Binding Text.SessionTimeout}" />
                                    <TextBox IsEnabled="{Binding SeleniumSettingsEnabled}"
                                             Text="{Binding SessionTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </controls:AdaptiveSplitPanel>
                            <CheckBox Margin="0,18,0,0"
                                      IsChecked="{Binding DownloadsEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding SeleniumSettingsEnabled}"
                                      Content="{Binding Text.EnableSeleniumDownloads}" />
                        </StackPanel>
                    </controls:FormSection.Body>
                    <controls:FormSection.Actions>
                        <Button Style="{StaticResource FormPrimaryButtonStyle}"
                                IsEnabled="{Binding SeleniumSettingsEnabled}"
                                Click="SaveSeleniumSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconSave}" />
                                <TextBlock Text="{Binding SeleniumSettingsActionLabel}" />
                            </StackPanel>
                        </Button>
                    </controls:FormSection.Actions>
                </controls:FormSection>
            </Grid>

            <Border Style="{StaticResource PanelCardStyle}"
                    Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SeleniumDrivers}">
                <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconInstall}"
                                                Heading="{Binding Text.SeleniumDriverCatalog}">
                            <controls:SectionHeader.Actions>
                                <Button Style="{StaticResource SectionActionButtonStyle}"
                                        IsEnabled="{Binding SeleniumSettingsEnabled}"
                                        Click="ReloadSeleniumDrivers_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconRefresh}" />
                                        <TextBlock Text="{Binding Text.ReloadDrivers}" />
                                    </StackPanel>
                                </Button>
                            </controls:SectionHeader.Actions>
                        </controls:SectionHeader>
                        <ItemsControl ItemsSource="{Binding SeleniumDriverPackages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="16" Style="{StaticResource CatalogRowStyle}">
                                            <StackPanel>
                                                <Grid MinWidth="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="46" Height="46" VerticalAlignment="Top"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="8">
                                                        <controls:BrandLogo Width="31" Height="31"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            Brand="{Binding PrimaryBrandLogo}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" MinWidth="0">
                                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Margin="0,6,16,0"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding Description}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="14,2,0,0" Orientation="Horizontal"
                                                                VerticalAlignment="Top">
                                                        <controls:AppIcon Width="15" Height="15" Margin="0,0,7,0"
                                                                          Data="{StaticResource IconPackage}"
                                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding Version}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Margin="0,14,0,12" Height="1"
                                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                                <controls:AdaptiveSplitPanel Gap="14" SecondaryWeight="0" CompactBreakpoint="540">
                                                    <Button Padding="12,8" HorizontalAlignment="Left"
                                                            IsEnabled="{Binding CanInstall}" Click="InstallRuntimePackage_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Width="15" Height="15" Margin="0,0,8,0">
                                                                <controls:AppIcon.Style>
                                                                    <Style TargetType="{x:Type controls:AppIcon}" BasedOn="{StaticResource AppIconBaseStyle}">
                                                                        <Setter Property="Data" Value="{StaticResource IconInstall}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                <Setter Property="Data" Value="{StaticResource IconSuccess}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </controls:AppIcon.Style>
                                                            </controls:AppIcon>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="{x:Type TextBlock}">
                                                                        <Setter Property="Text" Value="{Binding DataContext.Text.DownloadAndInstall, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding DataContext.Text.Installed, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>
                                                    <StackPanel MinWidth="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <controls:AppIcon Width="16" Height="16" Margin="0,0,8,0">
                                                                <controls:AppIcon.Style>
                                                                    <Style TargetType="{x:Type controls:AppIcon}" BasedOn="{StaticResource AppIconBaseStyle}">
                                                                        <Setter Property="Data" Value="{StaticResource IconInstall}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                <Setter Property="Data" Value="{StaticResource IconSuccess}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </controls:AppIcon.Style>
                                                            </controls:AppIcon>
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="{x:Type TextBlock}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <ProgressBar Margin="0,7,0,0" Height="4" Minimum="0" Maximum="100"
                                                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                     Value="{Binding Progress, Mode=OneWay}" />
                                                    </StackPanel>
                                                </controls:AdaptiveSplitPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </StackPanel>
            </Border>

            <Border VerticalAlignment="Top" Style="{StaticResource PanelCardStyle}"
                    Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SeleniumBrowserProfiles}">
                <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconFolder}"
                                                Heading="{Binding Text.SeleniumProfileMasters}"
                                                Metadata="{Binding SeleniumProfileCount}">
                            <controls:SectionHeader.Actions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Style="{StaticResource IconButtonStyle}"
                                            Click="ShowProfileHelp_Click"
                                            ToolTip="{Binding Text.MoreInformation}"
                                            AutomationProperties.Name="{Binding Text.MoreInformation}">
                                        <controls:AppIcon Data="{StaticResource IconInfo}"
                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <Button Style="{StaticResource FormPrimaryButtonStyle}"
                                            IsEnabled="{Binding SeleniumProfileActionsEnabled}"
                                            Click="CreateCleanSeleniumProfile_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconAdd}" />
                                            <TextBlock Text="{Binding Text.AddSeleniumProfile}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SectionHeader.Actions>
                        </controls:SectionHeader>
                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding ProfileProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ProfileProgressMessage}" TextWrapping="Wrap" />
                            <ProgressBar Margin="0,7,0,0" Height="5"
                                         IsIndeterminate="{Binding ProfileProgressVisible}" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding NoSeleniumProfiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="{Binding Text.NoSeleniumProfiles}" />
                        <ScrollViewer MaxHeight="430" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SeleniumProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="16" Style="{StaticResource CatalogRowStyle}">
                                            <controls:AdaptiveSplitPanel Gap="20" SecondaryWeight="0" CompactBreakpoint="720">
                                                <controls:AdaptiveSplitPanel Gap="24" PrimaryWeight="1.25" SecondaryWeight="0.75" CompactBreakpoint="520">
                                                    <Grid MinWidth="0" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="46" Height="46" VerticalAlignment="Top"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                BorderThickness="1" CornerRadius="8">
                                                            <Grid>
                                                                <controls:BrandLogo Width="31" Height="31"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                    Brand="{Binding BrowserBrand}">
                                                                    <controls:BrandLogo.Style>
                                                                        <Style TargetType="{x:Type controls:BrandLogo}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasBrowserBrand}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </controls:BrandLogo.Style>
                                                                </controls:BrandLogo>
                                                                <controls:AppIcon Width="24" Height="24" Data="{StaticResource IconGlobe}"
                                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                    <controls:AppIcon.Style>
                                                                        <Style TargetType="{x:Type controls:AppIcon}" BasedOn="{StaticResource AppIconBaseStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasBrowserBrand}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </controls:AppIcon.Style>
                                                                </controls:AppIcon>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" MinWidth="0">
                                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Browser}" />
                                                            <TextBlock Margin="0,9,0,0" FontSize="10"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       Text="{Binding CapabilityValue}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding CapabilityValue}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Width="16" Height="16" Margin="0,0,8,0"
                                                                              Data="{StaticResource IconDatabase}"
                                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding Size}" />
                                                        </StackPanel>
                                                        <Border Margin="0,10,0,0" Padding="9,6"
                                                                HorizontalAlignment="Left"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="12">
                                                            <StackPanel Orientation="Horizontal">
                                                                <controls:AppIcon Width="15" Height="15" Margin="0,0,7,0">
                                                                    <controls:AppIcon.Style>
                                                                        <Style TargetType="{x:Type controls:AppIcon}" BasedOn="{StaticResource AppIconBaseStyle}">
                                                                            <Setter Property="Data" Value="{StaticResource IconWarning}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                                    <Setter Property="Data" Value="{StaticResource IconSuccess}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </controls:AppIcon.Style>
                                                                </controls:AppIcon>
                                                                <TextBlock VerticalAlignment="Center" FontSize="11" Text="{Binding Verification}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="{x:Type TextBlock}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </controls:AdaptiveSplitPanel>

                                                <StackPanel Width="148" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Button Margin="0,0,0,7" Padding="12,8" Tag="{Binding Id}"
                                                            IsEnabled="{Binding DataContext.SeleniumProfileActionsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Click="EditSeleniumProfile_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconEdit}" />
                                                            <TextBlock Text="{Binding DataContext.Text.EditSeleniumProfile, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Margin="0,0,0,7" Padding="12,8" Tag="{Binding Id}"
                                                            Click="CopySeleniumProfileId_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconCopy}" />
                                                            <TextBlock Text="{Binding DataContext.Text.CopyId, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Padding="12,8" Tag="{Binding Id}"
                                                            IsEnabled="{Binding DataContext.SeleniumProfileActionsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Click="RemoveSeleniumProfile_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconDelete}" />
                                                            <TextBlock Text="{Binding DataContext.Text.Delete, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </controls:AdaptiveSplitPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}"
                    Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SeleniumCookieVaults}">
                <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconShield}"
                                                Heading="{Binding Text.CookieVaultManagement}"
                                                Metadata="{Binding SeleniumCookieVaultCount}"
                                                Description="{Binding Text.CookieVaultCapabilityHelp}">
                            <controls:SectionHeader.Actions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Style="{StaticResource IconButtonStyle}"
                                            Click="ShowCookieVaultHelp_Click"
                                            ToolTip="{Binding Text.MoreInformation}"
                                            AutomationProperties.Name="{Binding Text.MoreInformation}">
                                        <controls:AppIcon Data="{StaticResource IconInfo}"
                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <Button Style="{StaticResource FormPrimaryButtonStyle}"
                                            IsEnabled="{Binding SeleniumProfileActionsEnabled}"
                                            Click="ImportCookieVault_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconAdd}" />
                                            <TextBlock Text="{Binding Text.AddCookieVault}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SectionHeader.Actions>
                        </controls:SectionHeader>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding NoSeleniumCookieVaults, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="{Binding Text.NoCookieVaults}" />
                        <ScrollViewer MaxHeight="430" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SeleniumCookieVaults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <GroupBox Margin="0,0,0,8" Header="{Binding Name}" Style="{StaticResource TrimmingGroupBoxStyle}">
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Domains}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CookieCount}" />
                                                <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="{Binding CapabilityValue}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CapabilityValue}" />
                                                <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Right">
                                                    <Button Margin="0,0,6,6" Tag="{Binding Id}" Click="CopyCookieVaultId_Click"
                                                            Content="{Binding DataContext.Text.CopyId, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Margin="0,0,0,6" Tag="{Binding Id}"
                                                            IsEnabled="{Binding DataContext.SeleniumProfileActionsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Click="RemoveCookieVault_Click" Content="{Binding DataContext.Text.Delete, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=SeleniumSessions}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconGlobe}"
                                                Heading="{Binding Text.SeleniumSessions}"
                                                Metadata="{Binding SeleniumSessionCount}">
                            <controls:SectionHeader.Actions>
                                <Button Style="{StaticResource SectionActionButtonStyle}"
                                        IsEnabled="{Binding SeleniumSessionActionsEnabled}"
                                        Click="RefreshSeleniumSessions_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconRefresh}" />
                                        <TextBlock Text="{Binding Text.Refresh}" />
                                    </StackPanel>
                                </Button>
                            </controls:SectionHeader.Actions>
                        </controls:SectionHeader>
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding NoSeleniumSessions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="{Binding Text.NoSeleniumSessions}" />
                        <ScrollViewer MaxHeight="460"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SeleniumSessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,13" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                            <controls:AdaptiveSplitPanel Gap="18" SecondaryWeight="0">
                                                <StackPanel MinWidth="0">
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Browser}" />
                                                    <TextBlock Margin="0,4,16,0" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="{Binding Id}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Id}" />
                                                    <WrapPanel Margin="0,9,16,0">
                                                        <TextBlock Margin="0,0,18,4"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="{Binding DataContext.Text.Platform, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding Platform, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,0,18,4"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="{Binding DataContext.Text.Started, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding StartedAt, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,0,0,4"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="{Binding DataContext.Text.Duration, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding Duration, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <Button Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Tag="{Binding Id}" Click="TerminateSeleniumSession_Click"
                                                        IsEnabled="{Binding DataContext.SeleniumSessionActionsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Content="{Binding DataContext.Text.TerminateSession, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </controls:AdaptiveSplitPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
