<Window x:Class="PortableDeveloper.App.ScheduledTaskRunDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
        Width="760" Height="560" MinWidth="520" MinHeight="360"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/portable-developer.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader x:Name="DialogHeader" Icon="{StaticResource IconText}" />

        <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="38,14,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="OutputLabel" Grid.Row="2" Margin="0,20,0,8"
                   Style="{StaticResource DialogFieldLabelStyle}" />
        <TextBox x:Name="OutputTextBox" Grid.Row="3" Padding="12"
                 FontFamily="Cascadia Mono,Consolas" FontSize="12"
                 IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" />

        <Border Grid.Row="4" Style="{StaticResource DialogFooterStyle}">
            <Button x:Name="CloseButton"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    HorizontalAlignment="Right" IsCancel="True"
                    Click="Close_Click">
                <StackPanel Orientation="Horizontal">
                    <controls:AppIcon Width="15" Height="15" Margin="0,0,7,0"
                                      Data="{StaticResource IconClose}" />
                    <TextBlock x:Name="CloseButtonText" />
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</Window>
