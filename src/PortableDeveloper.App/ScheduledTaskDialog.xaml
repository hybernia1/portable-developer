<Window x:Class="PortableDeveloper.App.ScheduledTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
        Width="600" Height="720" MinHeight="580"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/portable-developer.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader x:Name="DialogHeader" Icon="{StaticResource IconSchedule}" />

        <ScrollViewer Grid.Row="1" Margin="0,22,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock x:Name="NameLabel" Style="{StaticResource DialogFieldLabelStyle}" />
                <TextBox x:Name="NameTextBox" Margin="0,8,0,0" />

                <Grid Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CommandLabel" Style="{StaticResource DialogFieldLabelStyle}" />
                        <ComboBox x:Name="CommandComboBox" Margin="0,8,0,0"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ScheduleLabel" Style="{StaticResource DialogFieldLabelStyle}" />
                        <ComboBox x:Name="ScheduleComboBox" Margin="0,8,0,0"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectionChanged="ScheduleComboBox_SelectionChanged" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,17,0,0">
                    <TextBlock x:Name="TargetLabel" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBox x:Name="TargetTextBox" Margin="0,8,0,0" />
                    <TextBlock x:Name="TargetHelpText" Style="{StaticResource DialogHelpTextStyle}" />
                </StackPanel>

                <StackPanel Margin="0,17,0,0">
                    <TextBlock x:Name="ArgumentsLabel" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBox x:Name="ArgumentsTextBox" Margin="0,8,0,0" />
                    <TextBlock x:Name="ArgumentsHelpText" Style="{StaticResource DialogHelpTextStyle}" />
                </StackPanel>

                <Grid Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="IntervalPanel">
                        <TextBlock x:Name="IntervalLabel" Style="{StaticResource DialogFieldLabelStyle}" />
                        <TextBox x:Name="IntervalTextBox" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="TimePanel" Grid.Column="2">
                        <TextBlock x:Name="TimeLabel" Style="{StaticResource DialogFieldLabelStyle}" />
                        <TextBox x:Name="TimeTextBox" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="DayPanel" Margin="0,17,0,0">
                    <TextBlock x:Name="DayLabel" Style="{StaticResource DialogFieldLabelStyle}" />
                    <ComboBox x:Name="DayComboBox" Margin="0,8,0,0"
                              DisplayMemberPath="Label" SelectedValuePath="Value" />
                </StackPanel>

                <StackPanel Margin="0,17,0,0">
                    <TextBlock x:Name="TimeoutLabel" Style="{StaticResource DialogFieldLabelStyle}" />
                    <TextBox x:Name="TimeoutTextBox" Margin="0,8,0,0" />
                </StackPanel>

                <CheckBox x:Name="EnabledCheckBox" Margin="0,19,0,0" />
                <TextBlock x:Name="ValidationText" Style="{StaticResource DialogValidationTextStyle}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Margin="0,0,8,0"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        IsCancel="True" Click="Cancel_Click" />
                <Button Style="{StaticResource DialogPrimaryButtonStyle}"
                        IsDefault="True" Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:AppIcon Width="15" Height="15" Margin="0,0,7,0"
                                          Data="{StaticResource IconSave}" />
                        <TextBlock x:Name="SaveButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
