<UserControl x:Class="PortableDeveloper.App.Views.PortsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <UserControl.Resources>
        <Style x:Key="PortEditorRowStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="4,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="PortInputStyle" TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Width" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="PortStatusTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=PortsApplication}">
                <controls:FormSection Icon="{StaticResource IconPorts}"
                                      Heading="{Binding Text.CentralPortManager}"
                                      Feedback="{Binding StatusText}">
                    <controls:FormSection.Body>
                        <StackPanel>
                            <Border Margin="0,0,0,6" Style="{StaticResource InlineInfoPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:AppIcon Width="16" Height="16" Margin="0,1,0,0"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Data="{StaticResource IconInfo}" />
                                    <TextBlock Grid.Column="1"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" Text="{Binding PortSettingsAvailability}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PortEditorRowStyle}">
                                <controls:AdaptiveSplitPanel Gap="18" SecondaryWeight="0" CompactBreakpoint="520">
                                    <Grid MinWidth="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:BrandLogo Width="22" Height="22" Margin="0,1,0,0"
                                                            Brand="apache" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding Text.ApacheHttpPort}" />
                                    </Grid>
                                    <StackPanel MinWidth="250">
                                        <TextBox Style="{StaticResource PortInputStyle}"
                                                 IsEnabled="{Binding PortSettingsEnabled}"
                                                 Text="{Binding ApachePortText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="PortTextBox_TextChanged" />
                                        <TextBlock Style="{StaticResource PortStatusTextStyle}"
                                                   Text="{Binding ApachePortStatus}" />
                                    </StackPanel>
                                </controls:AdaptiveSplitPanel>
                            </Border>

                            <Border Style="{StaticResource PortEditorRowStyle}">
                                <controls:AdaptiveSplitPanel Gap="18" SecondaryWeight="0" CompactBreakpoint="520">
                                    <Grid MinWidth="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:BrandLogo Width="22" Height="22" Margin="0,1,0,0"
                                                            Brand="php" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding Text.PhpFastCgiPortLabel}" />
                                    </Grid>
                                    <StackPanel MinWidth="250">
                                        <TextBox Style="{StaticResource PortInputStyle}"
                                                 IsEnabled="{Binding PortSettingsEnabled}"
                                                 Text="{Binding PhpFastCgiPortText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="PortTextBox_TextChanged" />
                                        <TextBlock Style="{StaticResource PortStatusTextStyle}"
                                                   Text="{Binding PhpPortStatus}" />
                                    </StackPanel>
                                </controls:AdaptiveSplitPanel>
                            </Border>

                            <Border Style="{StaticResource PortEditorRowStyle}">
                                <controls:AdaptiveSplitPanel Gap="18" SecondaryWeight="0" CompactBreakpoint="520">
                                    <Grid MinWidth="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:BrandLogo Width="22" Height="22" Margin="0,1,0,0"
                                                            Brand="mariadb" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding Text.MariaDbPortLabel}" />
                                    </Grid>
                                    <StackPanel MinWidth="250">
                                        <TextBox Style="{StaticResource PortInputStyle}"
                                                 IsEnabled="{Binding PortSettingsEnabled}"
                                                 Text="{Binding MariaDbPortText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="PortTextBox_TextChanged" />
                                        <TextBlock Style="{StaticResource PortStatusTextStyle}"
                                                   Text="{Binding MariaDbPortStatus}" />
                                    </StackPanel>
                                </controls:AdaptiveSplitPanel>
                            </Border>

                            <Border Style="{StaticResource PortEditorRowStyle}">
                                <controls:AdaptiveSplitPanel Gap="18" SecondaryWeight="0" CompactBreakpoint="520">
                                    <Grid MinWidth="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:BrandLogo Width="22" Height="22" Margin="0,1,0,0"
                                                            Brand="selenium" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding Text.SeleniumPortLabel}" />
                                    </Grid>
                                    <StackPanel MinWidth="250">
                                        <TextBox Style="{StaticResource PortInputStyle}"
                                                 IsEnabled="{Binding PortSettingsEnabled}"
                                                 Text="{Binding SeleniumPortText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="PortTextBox_TextChanged" />
                                        <TextBlock Style="{StaticResource PortStatusTextStyle}"
                                                   Text="{Binding SeleniumPortStatus}" />
                                    </StackPanel>
                                </controls:AdaptiveSplitPanel>
                            </Border>
                        </StackPanel>
                    </controls:FormSection.Body>
                    <controls:FormSection.Actions>
                        <WrapPanel>
                            <Button Margin="0,0,8,0" Style="{StaticResource FormPrimaryButtonStyle}"
                                    IsEnabled="{Binding PortSettingsEnabled}" Click="SavePorts_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconSave}" />
                                    <TextBlock Text="{Binding Text.SavePorts}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FormSecondaryButtonStyle}"
                                    Click="RefreshPorts_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Margin="0,0,8,0" Data="{StaticResource IconRefresh}" />
                                    <TextBlock Text="{Binding Text.RefreshPortList}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </controls:FormSection.Actions>
                </controls:FormSection>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=PortsListeners}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <controls:SectionHeader Icon="{StaticResource IconPorts}"
                                                Heading="{Binding Text.ListeningPortsTab}"
                                                Metadata="{Binding TcpListeners.Count}">
                            <controls:SectionHeader.Actions>
                                <Button Style="{StaticResource SectionActionButtonStyle}"
                                        Click="RefreshPorts_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Margin="0,0,7,0" Data="{StaticResource IconRefresh}" />
                                        <TextBlock Text="{Binding Text.RefreshPortList}" />
                                    </StackPanel>
                                </Button>
                            </controls:SectionHeader.Actions>
                        </controls:SectionHeader>

                        <Border Margin="0,0,0,12" Style="{StaticResource InlineInfoPanelStyle}"
                                Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Margin="0,1,9,0" VerticalAlignment="Top"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Data="{StaticResource IconInfo}" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Text="{Binding StatusText}" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer MaxHeight="420"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TcpListeners}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,11"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:AppIcon Width="16" Height="16" Margin="0,1,0,0"
                                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                  Data="{StaticResource IconPorts}" />
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold"
                                                           Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Endpoint}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
