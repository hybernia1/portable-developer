<Window x:Class="PortableDeveloper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Portable Developer"
        Width="1000"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        Background="#101725"
        Foreground="#E8EDF5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#253650" />
            <Setter Property="BorderBrush" Value="#4A6388" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <ComboBox x:Name="LanguageSelector"
                      DockPanel.Dock="Right"
                      Width="96"
                      Padding="8,6"
                      SelectionChanged="LanguageSelector_SelectionChanged"
                      SelectedValuePath="Tag">
                <ComboBoxItem Tag="Czech" Content="Česky" />
                <ComboBoxItem Tag="English" Content="English" />
            </ComboBox>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Text.ApplicationTitle}" />
                <TextBlock Margin="0,6,0,0" Foreground="#A9B6C9" Text="{Binding Text.Subtitle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,24,0,20" Padding="18" Background="#192235" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="#A9B6C9" FontSize="12" Text="{Binding Text.WebStack}" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#F1C46B"
                               Text="{Binding StackState}" />
                    <TextBlock Margin="0,6,24,0"
                               Foreground="#A9B6C9"
                               TextWrapping="Wrap"
                               Text="{Binding StackDetail}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource ActionButtonStyle}"
                        MinWidth="170"
                        Padding="18,11"
                        VerticalAlignment="Center"
                        Background="{Binding StackActionBackground}"
                        BorderBrush="{Binding StackActionBorder}"
                        IsEnabled="{Binding StackActionEnabled}"
                        Click="ToggleStack_Click"
                        Content="{Binding StackActionLabel}" />
            </Grid>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Services}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="214"
                            MinHeight="205"
                            Margin="0,0,16,16"
                            Padding="18"
                            Background="#192235"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Margin="0,6,0,16"
                                       Foreground="#A9B6C9"
                                       TextWrapping="Wrap"
                                       Text="{Binding Description}" />
                            <TextBlock Foreground="#F1C46B" FontWeight="SemiBold" Text="{Binding State}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#A9B6C9"
                                       TextWrapping="Wrap"
                                       Text="{Binding Detail}" />
                            <Button Margin="0,14,0,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Padding="11,7"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding IsActionEnabled}"
                                    Tag="{Binding ActionKey}"
                                    Click="ServiceAction_Click"
                                    Content="{Binding ActionLabel}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Expander Header="{Binding Text.TechnicalDetails}" Foreground="#A9B6C9">
                <StackPanel Margin="0,8,0,4">
                    <TextBlock FontSize="11" Foreground="#78879C" Text="{Binding Text.ApplicationRoot}" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#A9B6C9"
                               TextWrapping="Wrap"
                               Text="{Binding RootPath}" />
                </StackPanel>
            </Expander>
            <TextBlock x:Name="InstallationStatusText"
                       Margin="0,10,0,0"
                       Foreground="#A9B6C9"
                       Text="{Binding Text.InitialStatus}" />
        </StackPanel>
    </Grid>
</Window>
