<UserControl x:Class="PortableDeveloper.App.Controls.WorkspaceHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="27" FontWeight="SemiBold" Text="{Binding PageTitle}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
            <TextBlock Margin="2,0,0,5" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ActiveProject}" />
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="220" Style="{StaticResource AppComboBoxStyle}"
                          ItemsSource="{Binding Projects}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding ActiveProjectId, Mode=OneWay}"
                          SelectionChanged="ProjectSelector_SelectionChanged" />
                <Button Margin="8,0,0,0" Padding="12,8" Style="{StaticResource AppButtonStyle}"
                        Click="ManageProjectsButton_Click" Content="{Binding Text.ManageProjects}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
