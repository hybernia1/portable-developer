<UserControl x:Class="PortableDeveloper.App.Views.ApachePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                <controls:AdaptiveSplitPanel SecondaryWeight="0">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Apache HTTP Server" />
                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontWeight="SemiBold" Text="{Binding ApacheService.State}" />
                        <TextBlock Margin="0,5,20,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding ApacheService.Detail}" />
                    </StackPanel>
                    <Button MinWidth="190" Padding="18,11" HorizontalAlignment="Left"
                            VerticalAlignment="Center" IsEnabled="{Binding ApacheActionEnabled}"
                            Click="ToggleApache_Click" Content="{Binding ApacheActionLabel}" />
                </controls:AdaptiveSplitPanel>
            </Border>
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CurrentConfiguration}" />
                    <TextBlock Margin="0,16,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Version}" />
                    <TextBlock Text="{Binding ApacheService.Version}" />
                    <TextBlock Margin="0,13,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Port}" />
                    <TextBlock Text="{Binding ApachePort}" />
                    <TextBlock Margin="0,13,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.DocumentRoot}" />
                    <TextBlock Text="{Binding ActiveDocumentRoot}" />
                    <TextBlock Margin="0,13,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.ActiveProject}" />
                    <TextBlock Text="{Binding ActiveWebProjectName}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
