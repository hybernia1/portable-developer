<UserControl x:Class="PortableDeveloper.App.Views.DatabasesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
             xmlns:views="clr-namespace:PortableDeveloper.App.Views">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                <controls:AdaptiveSplitPanel SecondaryWeight="0">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="MariaDB" />
                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontWeight="SemiBold" Text="{Binding MariaDbService.State}" />
                        <TextBlock Margin="0,5,20,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding MariaDbService.Detail}" />
                        <TextBlock Margin="0,9,20,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding StatusText}"
                                   Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                    <Button MinWidth="170" Padding="18,11" VerticalAlignment="Center" HorizontalAlignment="Left"
                            IsEnabled="{Binding MariaDbActionEnabled}" Click="ToggleMariaDb_Click"
                            Content="{Binding MariaDbActionLabel}" />
                </controls:AdaptiveSplitPanel>
            </Border>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=DatabasesOverview}">
                <controls:AdaptiveSplitPanel Margin="0,0,0,18">
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.ConnectionDetails}" />
                            <TextBlock Margin="0,16,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Host}" />
                            <TextBlock Text="127.0.0.1" />
                            <TextBlock Margin="0,13,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Port}" />
                            <TextBlock Text="{Binding MariaDbPort}" />
                            <TextBlock Margin="0,13,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.User}" />
                            <TextBlock Text="root" />
                            <TextBlock Margin="0,13,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Password}" />
                            <TextBlock Text="{Binding RootPasswordState}" />
                            <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding Text.RootAccountNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CreateDatabase}" />
                            <TextBlock Margin="0,16,0,6" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.NewDatabaseName}" />
                            <TextBox Text="{Binding NewDatabaseName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,12,0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.DefaultDatabase}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="portable_dev" />
                            <Button Margin="0,18,0,0" Padding="15,9" HorizontalAlignment="Left"
                                    IsEnabled="{Binding DatabaseActionsEnabled}" Click="CreateDatabase_Click"
                                    Content="{Binding Text.CreateDatabase}" />
                        </StackPanel>
                    </Border>
                </controls:AdaptiveSplitPanel>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=DatabasesAdministration}">
                <controls:AdaptiveSplitPanel Margin="0,0,0,18">
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.RootPasswordSecurity}" />
                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding RootPasswordState}" />
                            <TextBlock Margin="0,14,0,5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.NewPassword}" />
                            <PasswordBox x:Name="RootPasswordBox" />
                            <TextBlock Margin="0,11,0,5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.ConfirmPassword}" />
                            <PasswordBox x:Name="ConfirmRootPasswordBox" />
                            <TextBlock Margin="0,11,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding Text.PasswordGuidance}" />
                            <Button Margin="0,16,0,0" Padding="15,9" HorizontalAlignment="Left"
                                    IsEnabled="{Binding DatabaseActionsEnabled}" Click="ChangeRootPassword_Click"
                                    Content="{Binding RootPasswordActionLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCardStyle}"
                            Visibility="{Binding PhpMyAdminInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="phpMyAdmin 5.2.3" />
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding Text.PhpMyAdminDescription}" />
                            <TextBlock Margin="0,16,0,4" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="URL" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding PhpMyAdminUrl}" />
                            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding PhpMyAdminDependencyState}" />
                            <Button Margin="0,18,0,0" Padding="15,9" HorizontalAlignment="Left"
                                    IsEnabled="{Binding PhpMyAdminActionEnabled}" Click="OpenPhpMyAdmin_Click"
                                    Content="{Binding Text.OpenPhpMyAdmin}" />
                        </StackPanel>
                    </Border>
                </controls:AdaptiveSplitPanel>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=DatabasesCatalog}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.DatabaseOverview}" />
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DatabaseCount}" />
                            </StackPanel>
                            <Button Grid.Column="1" Padding="13,8" IsEnabled="{Binding DatabaseActionsEnabled}"
                                    Click="RefreshDatabases_Click" Content="{Binding Text.Refresh}" />
                        </Grid>
                        <ScrollViewer MaxHeight="420"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Databases}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Margin="0,6,0,0" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{Binding DataContext.Text.ApproximateSize, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}, Mode=OneWay}" />
                                                        <Run Text=": " />
                                                        <Run Text="{Binding ApproximateSize, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,6,12,0" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="{Binding DataContext.Text.DefaultDatabaseCannotBeDeleted, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" Margin="16,0,0,0"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Margin="0,2,8,2" Padding="12,8" Tag="{Binding Name}"
                                                            IsEnabled="{Binding DataContext.PhpMyAdminActionEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}"
                                                            ToolTip="{Binding DataContext.PhpMyAdminDependencyState, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}"
                                                            Click="ManageDatabase_Click"
                                                            Content="{Binding DataContext.Text.ManageDatabase, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}" />
                                                    <Button Margin="0,2" Padding="12,8" Tag="{Binding Name}"
                                                            Click="DeleteDatabase_Click"
                                                            Content="{Binding DataContext.Text.DeleteDatabase, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}">
                                                        <Button.Style>
                                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding CanDelete}" Value="True" />
                                                                            <Condition Binding="{Binding DataContext.DatabaseActionsEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:DatabasesPageView}}}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
