<Window x:Class="PortableDeveloper.App.NamePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="245" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Icon="Assets/portable-developer.ico">
    <Grid>
        <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox x:Name="NameTextBox" Grid.Row="1" Margin="0,13,0,0"
                 KeyDown="NameTextBox_KeyDown" />
        <TextBlock x:Name="ValidationText" Grid.Row="2" Margin="0,8,0,0"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
        </Grid>
    </Grid>
</Window>
