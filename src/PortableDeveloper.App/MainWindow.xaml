<Window x:Class="PortableDeveloper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Portable Developer"
        Width="1000"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        Background="#101725"
        Foreground="#E8EDF5">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <ComboBox x:Name="LanguageSelector"
                      DockPanel.Dock="Right"
                      Width="96"
                      Margin="0,0,12,0"
                      Padding="8,6"
                      SelectionChanged="LanguageSelector_SelectionChanged"
                      SelectedValuePath="Tag">
                <ComboBoxItem Tag="Czech" Content="Česky" />
                <ComboBoxItem Tag="English" Content="English" />
            </ComboBox>
            <Button DockPanel.Dock="Right"
                    x:Name="StopStackButton"
                    Margin="0,0,12,0"
                    Padding="14,8"
                    Background="#6B3434"
                    BorderBrush="#A25B5B"
                    Click="StopStack_Click"
                    Content="{Binding Text.StopStack}" />
            <Button DockPanel.Dock="Right"
                    x:Name="StartStackButton"
                    Margin="0,0,12,0"
                    Padding="14,8"
                    Background="#2D6A4F"
                    BorderBrush="#4F9A70"
                    Click="StartStack_Click"
                    Content="{Binding Text.StartStack}" />
            <Button DockPanel.Dock="Right"
                    Padding="14,8"
                    Background="#253650"
                    BorderBrush="#4A6388"
                    Click="RefreshModules_Click"
                    Content="{Binding Text.RefreshModules}" />
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Text.ApplicationTitle}" />
                <TextBlock Margin="0,6,0,0" Foreground="#A9B6C9" Text="{Binding Text.Subtitle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,24,0,20" Padding="14,10" Background="#192235" CornerRadius="8">
            <StackPanel>
                <TextBlock Foreground="#A9B6C9" FontSize="12" Text="{Binding Text.ApplicationRoot}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding RootPath}" TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Foreground="#F1C46B" Text="{Binding StackState}" />
                    <TextBlock Margin="10,0,0,0" Foreground="#A9B6C9" Text="{Binding StackDetail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button x:Name="InitializeMariaDbButton"
                            Padding="14,8"
                            Background="#253650"
                            BorderBrush="#4A6388"
                            Click="InitializeMariaDb_Click"
                            Content="{Binding Text.InitializeMariaDb}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Services}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="214" Margin="0,0,16,16" Padding="18" Background="#192235" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Margin="0,6,0,18" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Description}" />
                            <TextBlock Foreground="#F1C46B" FontWeight="SemiBold" Text="{Binding State}" />
                            <TextBlock Margin="0,6,0,0" Foreground="#A9B6C9" TextWrapping="Wrap" Text="{Binding Detail}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="InstallationStatusText"
                   Grid.Row="3"
                   Margin="0,16,0,0"
                   Foreground="#A9B6C9"
                   Text="{Binding Text.InitialStatus}" />
    </Grid>
</Window>
