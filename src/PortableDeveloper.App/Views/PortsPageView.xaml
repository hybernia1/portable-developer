<UserControl x:Class="PortableDeveloper.App.Views.PortsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                <controls:AdaptiveSplitPanel SecondaryWeight="0">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Text.CentralPortManager}" />
                        <TextBlock Margin="0,7,24,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding Text.PortManagerHelp}" />
                        <TextBlock Margin="0,9,24,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap" Text="{Binding PortSettingsAvailability}" />
                        <TextBlock Margin="0,9,24,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding StatusText}"
                                   Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                    <Button Padding="15,9" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Click="RefreshPorts_Click" Content="{Binding Text.RefreshPortList}" />
                </controls:AdaptiveSplitPanel>
            </Border>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=PortsApplication}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.ServiceControl}" />
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Port}" />
                            <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.PortStatus}" />
                        </Grid>
                        <Border Margin="0,5,0,0" Padding="13,10" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.ApacheHttpPort}" />
                                <TextBox Grid.Column="1" Width="120" HorizontalAlignment="Left" IsEnabled="{Binding PortSettingsEnabled}"
                                         Text="{Binding ApachePortText, UpdateSourceTrigger=PropertyChanged}" TextChanged="PortTextBox_TextChanged" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding ApachePortStatus}" />
                            </Grid>
                        </Border>
                        <Border Margin="0,7,0,0" Padding="13,10" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.PhpFastCgiPortLabel}" />
                                <TextBox Grid.Column="1" Width="120" HorizontalAlignment="Left" IsEnabled="{Binding PortSettingsEnabled}"
                                         Text="{Binding PhpFastCgiPortText, UpdateSourceTrigger=PropertyChanged}" TextChanged="PortTextBox_TextChanged" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding PhpPortStatus}" />
                            </Grid>
                        </Border>
                        <Border Margin="0,7,0,0" Padding="13,10" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.MariaDbPortLabel}" />
                                <TextBox Grid.Column="1" Width="120" HorizontalAlignment="Left" IsEnabled="{Binding PortSettingsEnabled}"
                                         Text="{Binding MariaDbPortText, UpdateSourceTrigger=PropertyChanged}" TextChanged="PortTextBox_TextChanged" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding MariaDbPortStatus}" />
                            </Grid>
                        </Border>
                        <Border Margin="0,7,0,0" Padding="13,10" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.SeleniumPortLabel}" />
                                <TextBox Grid.Column="1" Width="120" HorizontalAlignment="Left" IsEnabled="{Binding PortSettingsEnabled}"
                                         Text="{Binding SeleniumPortText, UpdateSourceTrigger=PropertyChanged}" TextChanged="PortTextBox_TextChanged" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SeleniumPortStatus}" />
                            </Grid>
                        </Border>
                        <Button Margin="0,15,0,0" Padding="16,10" HorizontalAlignment="Left"
                                IsEnabled="{Binding PortSettingsEnabled}" Click="SavePorts_Click" Content="{Binding Text.SavePorts}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=PortsListeners}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.ListeningPortsTab}" />
                                <TextBlock Margin="0,5,20,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Text="{Binding Text.PortReadOnlyNotice}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding TcpListenerCount}" />
                        </Grid>
                        <ScrollViewer MaxHeight="380"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TcpListeners}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,11" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                            <controls:AdaptiveSplitPanel Gap="18">
                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Address}">
                                                    <Run Text="{Binding DataContext.Text.LocalAddress, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                                                    <Run Text=": " />
                                                    <Run Text="{Binding Address, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding DataContext.Text.Port, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                                                    <Run Text=": " />
                                                    <Run Text="{Binding Port, Mode=OneWay}" />
                                                </TextBlock>
                                            </controls:AdaptiveSplitPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
