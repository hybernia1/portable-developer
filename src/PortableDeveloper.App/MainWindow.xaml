<Window x:Class="PortableDeveloper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PortableDeveloper.App.Converters"
        xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
        xmlns:viewModels="clr-namespace:PortableDeveloper.App.ViewModels"
        mc:Ignorable="d"
        Title="Portable Developer"
        Icon="Assets/portable-developer.ico"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Style="{StaticResource AppChromeWindowStyle}"
        Background="{StaticResource AppWindowBrush}"
        Foreground="{StaticResource AppForegroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EnumToVisibilityConverter x:Key="PageVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <CollectionViewSource x:Key="GroupedNavigation" Source="{Binding NavigationItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="PanelCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource AppButtonStyle}" />

        <Style x:Key="InputTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AppForegroundBrush}" />
        </Style>

        <Style x:Key="InputPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AppForegroundBrush}" />
        </Style>

        <Style x:Key="NavigationItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="NavigationChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationChrome" Property="Background" Value="{StaticResource AppControlBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AppStrongForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
            <Setter Property="Background" Value="{StaticResource AppControlBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" CornerRadius="5,5,0,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AppStrongForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SectionTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            <ContentPresenter Grid.Row="2" ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FileSortHeaderButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource AppSubtleBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PackageListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="OperationProgressTemplate">
            <Border Style="{StaticResource PanelCardStyle}"
                    Visibility="{Binding OperationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding OperationStatus}" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding OperationDetail}"
                               Visibility="{Binding OperationDetail, Converter={StaticResource StringToVisibilityConverter}}" />
                    <ProgressBar Margin="0,10,0,0" Height="6" Minimum="0" Maximum="100"
                                 Background="{StaticResource AppInputBrush}" Foreground="{StaticResource AppAccentBorderBrush}"
                                 IsIndeterminate="{Binding OperationIndeterminate, Mode=OneWay}"
                                 Value="{Binding OperationPercentage, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:AppTitleBar />
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource AppDeepSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="8,0,8,20">
                    <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Text.ApplicationTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="10"
                               Foreground="{StaticResource AppSubtleBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding Text.LocalOnly}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="10"
                               Foreground="{StaticResource AppDisabledTextBrush}"
                               Text="{Binding ApplicationVersion, StringFormat=v{0}}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         SelectionChanged="NavigationList_SelectionChanged"
                         ItemsSource="{Binding Source={StaticResource GroupedNavigation}}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         SelectedValuePath="Page"
                         SelectedValue="{Binding SelectedPage, Mode=OneWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel>
                                                    <TextBlock Margin="8,14,8,4" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Name}" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.6">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Setter Property="Data" Value="{StaticResource IconPackage}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Page}" Value="Dashboard"><Setter Property="Data" Value="{StaticResource IconDashboard}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Modules"><Setter Property="Data" Value="{StaticResource IconPackage}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Ports"><Setter Property="Data" Value="{StaticResource IconPorts}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Apache"><Setter Property="Data" Value="{StaticResource IconServer}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Php"><Setter Property="Data" Value="{StaticResource IconCode}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Databases"><Setter Property="Data" Value="{StaticResource IconDatabase}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Selenium"><Setter Property="Data" Value="{StaticResource IconGear}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Composer"><Setter Property="Data" Value="{StaticResource IconPackage}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Python"><Setter Property="Data" Value="{StaticResource IconCode}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Terminal"><Setter Property="Data" Value="{StaticResource IconTerminal}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Files"><Setter Property="Data" Value="{StaticResource IconFolder}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Tools"><Setter Property="Data" Value="{StaticResource IconFile}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Guides"><Setter Property="Data" Value="{StaticResource IconGuide}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Page}" Value="Settings"><Setter Property="Data" Value="{StaticResource IconGear}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding UsesBrandLogo}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <controls:BrandLogo Width="16" Height="16" Brand="{Binding BrandLogo}"
                                                    Visibility="{Binding UsesBrandLogo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Grid.Column="1" FontSize="14" Text="{Binding Label}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="8,16,8,0">
                    <TextBlock Margin="0,0,0,6"
                               FontSize="11"
                               Foreground="{StaticResource AppSubtleBrush}"
                               Text="{Binding Text.Language}" />
                    <ComboBox x:Name="LanguageSelector"
                              Style="{StaticResource AppComboBoxStyle}"
                              SelectionChanged="LanguageSelector_SelectionChanged"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Tag="Czech" Content="Česky" />
                        <ComboBoxItem Tag="English" Content="English" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock FontSize="27" FontWeight="SemiBold" Text="{Binding PageTitle}" />
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Subtitle}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- Dashboard -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Dashboard}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,20"
                                Visibility="{Binding ApacheReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource AppMutedBrush}" FontSize="12" Text="{Binding Text.ApacheServer}" />
                                    <TextBlock Margin="0,7,0,0" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource AppWarningBrush}" Text="{Binding ApacheState}" />
                                    <TextBlock Margin="0,6,24,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding ApacheDetail}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionButtonStyle}"
                                        MinWidth="170"
                                        Padding="18,11"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding ApacheActionEnabled}"
                                        Click="ToggleApache_Click"
                                        Content="{Binding ApacheActionLabel}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,20"
                                Visibility="{Binding NoInstalledServices, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding Text.PackageMissingComponents}" />
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                           Text="{Binding Text.NoModulesDashboard}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="185" MinHeight="205" Margin="0,0,10,10" Style="{StaticResource PanelCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Margin="0,6,0,16" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Description}" />
                                            <TextBlock Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold" Text="{Binding State}" />
                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Detail}" />
                                            <Button Margin="0,14,0,0"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Padding="11,7"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    IsEnabled="{Binding IsActionEnabled}"
                                                    Tag="{Binding ActionKey}"
                                                    Click="ServiceAction_Click"
                                                    Content="{Binding ActionLabel}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Modules -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Modules}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding RuntimePackages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="390" MinHeight="215" Margin="0,0,12,12" Style="{StaticResource PanelCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Grid Width="34" Height="34">
                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                                            <controls:BrandLogo Width="18" Height="18" Brand="{Binding PrimaryBrandLogo}"
                                                                                Visibility="{Binding HasPrimaryBrandLogo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <controls:BrandLogo Width="14" Height="14" Margin="2,0,0,0" Brand="{Binding SecondaryBrandLogo}"
                                                                                Visibility="{Binding HasSecondaryBrandLogo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource AppInfoBrush}" StrokeThickness="1.6">
                                                        <Path.Style>
                                                            <Style TargetType="{x:Type Path}">
                                                                <Setter Property="Data" Value="{StaticResource IconPackage}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IconKind}" Value="Apache"><Setter Property="Data" Value="{StaticResource IconServer}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKind}" Value="Php"><Setter Property="Data" Value="{StaticResource IconCode}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKind}" Value="Database"><Setter Property="Data" Value="{StaticResource IconDatabase}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKind}" Value="Selenium"><Setter Property="Data" Value="{StaticResource IconGear}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKind}" Value="Composer"><Setter Property="Data" Value="{StaticResource IconPackage}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKind}" Value="Python"><Setter Property="Data" Value="{StaticResource IconCode}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKind}" Value="Editor"><Setter Property="Data" Value="{StaticResource IconFile}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IconKind}" Value="PhpMyAdmin"><Setter Property="Data" Value="{StaticResource IconDatabase}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasPrimaryBrandLogo}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    </Grid>
                                                </Grid>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" />
                                                <Border Grid.Column="2" Padding="8,4" Background="{StaticResource AppInputBrush}" CornerRadius="10">
                                                    <TextBlock FontSize="10" Foreground="{StaticResource AppWarningBrush}" Text="{Binding Version}" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,10,0,12">
                                                <TextBlock Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Description}" />
                                                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource AppSuccessBrush}" FontWeight="SemiBold" Text="{Binding Status}"
                                                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding DownloadDetail}"
                                                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ProgressBar Margin="0,10,0,0" Height="5" Minimum="0" Maximum="100"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                             Value="{Binding Progress, Mode=OneWay}" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Padding="13,8"
                                                    HorizontalAlignment="Left" IsEnabled="{Binding CanInstall}"
                                                    Click="InstallRuntimePackage_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                        <Setter Property="Content" Value="{Binding DataContext.Text.DownloadAndInstall, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Content" Value="{Binding DataContext.Text.Installed, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,8,0,0" Padding="14,11" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppControlHoverBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Text.ModulesIntroduction}" />
                                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap"
                                           Text="{Binding Text.ModulesPortableNotice}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PHP -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Php}">
                    <StackPanel>
                        <TabControl Style="{StaticResource SectionTabControlStyle}">
                            <TabItem Header="{Binding Text.SettingsTab}">
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.PhpSettings}" />
                                    <TextBlock Margin="0,7,0,3" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Text.PhpSettingsHelp}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.MemoryLimit}" />
                                            <TextBox x:Name="PhpMemoryLimitTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                            <TextBlock Margin="0,11,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.UploadLimit}" />
                                            <TextBox x:Name="PhpUploadLimitTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                            <TextBlock Margin="0,11,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ExecutionTime}" />
                                            <TextBox x:Name="PhpExecutionTimeTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.PostLimit}" />
                                            <TextBox x:Name="PhpPostLimitTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                            <TextBlock Margin="0,11,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.MaximumInputVariables}" />
                                            <TextBox x:Name="PhpMaxInputVariablesTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding PhpSettingsEnabled}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="PhpDisplayErrorsCheckBox" Margin="0,14,0,0"
                                              Foreground="{StaticResource AppForegroundBrush}" IsEnabled="{Binding PhpSettingsEnabled}"
                                              Content="{Binding Text.DisplayErrors}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                               Text="{Binding Text.DisplayErrorsHelp}" />
                                    <WrapPanel Margin="0,15,0,0">
                                        <Button Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                                IsEnabled="{Binding PhpSettingsEnabled}" Click="SavePhpSettings_Click"
                                                Content="{Binding PhpSettingsActionLabel}" />
                                        <Button Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                                IsEnabled="{Binding PhpSettingsEnabled}" Click="ResetPhpSettings_Click"
                                                Content="{Binding Text.ResetDefaults}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            </TabItem>
                            <TabItem Header="{Binding Text.ExtensionsTab}">
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.PhpExtensions}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                               Text="{Binding Text.PhpExtensionsHelp}" />
                                    <TextBlock Margin="0,8,0,12" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap"
                                               Text="{Binding Text.RequiredPhpExtensions}" />
                                    <ItemsControl ItemsSource="{Binding PhpExtensions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,0,18,12" MinWidth="105" Foreground="{StaticResource AppForegroundBrush}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanToggle}">
                                                    <TextBlock Text="{Binding Name}" />
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Margin="0,5,0,0" Padding="12,10" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.PhpIni}" />
                                            <TextBlock Margin="0,4,0,0" Text="temp/generated/default/apache-php/php.ini" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Version}" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding PhpRuntimeVersion}" />
                                        </StackPanel>
                                    </Border>
                                    <Button Margin="0,14,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left"
                                            Click="EditCustomPhpIni_Click" Content="{Binding Text.EditCustomPhpIni}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap"
                                               Text="{Binding Text.CustomPhpIniHelp}" />
                                </StackPanel>
                            </Border>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Apache -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Apache}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Apache HTTP Server" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold" Text="{Binding ApacheService.State}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding ApacheService.Detail}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" MinWidth="190" Padding="18,11"
                                        VerticalAlignment="Center" IsEnabled="{Binding ApacheActionEnabled}"
                                        Click="ToggleApache_Click" Content="{Binding ApacheActionLabel}" />
                            </Grid>
                        </Border>
                        <TabControl Style="{StaticResource SectionTabControlStyle}">
                            <TabItem Header="{Binding Text.OverviewTab}">
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CurrentConfiguration}" />
                                    <TextBlock Margin="0,16,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Version}" />
                                    <TextBlock Text="{Binding ApacheService.Version}" />
                                    <TextBlock Margin="0,13,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Port}" />
                                    <TextBlock Text="{Binding ApachePort}" />
                                    <TextBlock Margin="0,13,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.DocumentRoot}" />
                                    <TextBlock Text="{Binding ActiveDocumentRoot}" />
                                    <TextBlock Margin="0,13,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ActiveProject}" />
                                    <TextBlock Text="{Binding ActiveWebProjectName}" />
                                </StackPanel>
                            </Border>
                            </TabItem>
                            <TabItem Header="{Binding Text.WebProjectsTab}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.75*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.AddWebProject}" />
                                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Text.WebProjectsHelp}" />
                                            <TextBlock Margin="0,15,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ProjectName}" />
                                            <TextBox x:Name="ProjectNameTextBox" Style="{StaticResource InputTextBoxStyle}" />
                                            <TextBlock Margin="0,12,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.WebRootInsideProject}" />
                                            <TextBox x:Name="ProjectWebRootTextBox" Style="{StaticResource InputTextBoxStyle}" Text="public" />
                                            <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap" Text="{Binding Text.WebRootExample}" />
                                            <Button Margin="0,16,0,0" HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                                    Click="CreateWebProject_Click" Content="{Binding Text.CreateProject}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.ConfiguredWebProjects}" />
                                                <TextBlock Grid.Column="1" Foreground="{StaticResource AppWarningBrush}" Text="{Binding WebProjects.Count}" />
                                            </Grid>
                                            <ListBox Grid.Row="1" MaxHeight="430" ItemsSource="{Binding WebProjects}" Style="{StaticResource PackageListBoxStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8" Padding="13,11" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                        <TextBlock Margin="8,0,0,0" Foreground="{StaticResource AppWarningBrush}" Text="{Binding HostName}" />
                                                                    </StackPanel>
                                                                    <TextBlock Margin="0,4,12,0" FontSize="10" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap" Text="{Binding ProjectRootRelativePath}" />
                                                                    <TextBlock Margin="0,3,12,0" FontSize="10" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding WebRootDisplay}" />
                                                                    <WrapPanel Margin="0,5,0,0">
                                                                        <TextBlock Foreground="{StaticResource AppSuccessBrush}" FontWeight="SemiBold" Text="{Binding ActiveState}" />
                                                                        <TextBlock Margin="12,0,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding HtaccessState}" />
                                                                        <TextBlock Margin="12,0,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding ApacheState}" />
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                                <Grid Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Margin="0,0,6,6" Style="{StaticResource ActionButtonStyle}" Padding="9,6" Tag="{Binding Id}"
                                                                            IsEnabled="{Binding CanSelect}" Click="SelectWebProject_Click" Content="{Binding DataContext.Text.UseProject, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                    <Button Margin="0,0,6,6" Padding="9,6" Tag="{Binding Id}" Click="OpenWebProjectUrl_Click" Content="URL">
                                                                        <Button.Style>
                                                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButtonStyle}">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition Binding="{Binding IsEnabled}" Value="True" />
                                                                                            <Condition Binding="{Binding DataContext.ApacheIsRunning, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Margin="0,0,0,6" Style="{StaticResource ActionButtonStyle}" Padding="9,6" Tag="{Binding Id}"
                                                                            Click="OpenWebProject_Click" Content="{Binding DataContext.Text.Open, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Margin="0,0,6,6" Style="{StaticResource ActionButtonStyle}" Padding="9,6" Tag="{Binding Id}"
                                                                            Click="ToggleWebProjectHtaccess_Click" Content="{Binding HtaccessAction}" />
                                                                    <Button Margin="0,0,0,6" Style="{StaticResource ActionButtonStyle}" Padding="9,6" Tag="{Binding Id}"
                                                                            IsEnabled="{Binding CanToggleApache}" Click="ToggleWebProjectEnabled_Click" Content="{Binding ApacheAction}" />
                                                                    </StackPanel>
                                                                    <Button Grid.Row="2" HorizontalAlignment="Right" Style="{StaticResource ActionButtonStyle}" Padding="9,6" Tag="{Binding Id}" IsEnabled="{Binding CanRemove}"
                                                                            Background="{StaticResource AppDangerSurfaceBrush}" BorderBrush="{StaticResource AppDangerMutedBorderBrush}"
                                                                            Click="RemoveWebProject_Click" Content="{Binding DataContext.Text.RemoveProject, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Databases -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Databases}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="MariaDB" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold" Text="{Binding MariaDbService.State}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding MariaDbService.Detail}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" MinWidth="170" Padding="18,11"
                                        VerticalAlignment="Center" IsEnabled="{Binding MariaDbActionEnabled}"
                                        Tag="toggle-mariadb" Click="ServiceAction_Click" Content="{Binding MariaDbActionLabel}" />
                            </Grid>
                        </Border>
                        <TabControl Style="{StaticResource SectionTabControlStyle}">
                            <TabItem Header="{Binding Text.OverviewTab}">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.ConnectionDetails}" />
                                    <TextBlock Margin="0,16,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Host}" />
                                    <TextBlock Text="127.0.0.1" />
                                    <TextBlock Margin="0,13,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Port}" />
                                    <TextBlock Text="{Binding MariaDbPort}" />
                                    <TextBlock Margin="0,13,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.User}" />
                                    <TextBlock Text="root" />
                                    <TextBlock Margin="0,13,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Password}" />
                                    <TextBlock Text="{Binding RootPasswordState}" />
                                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Text.RootAccountNote}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}"
                                    Visibility="{Binding PhpMyAdminInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CreateDatabase}" />
                                    <TextBlock Margin="0,16,0,6" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.NewDatabaseName}" />
                                    <TextBox x:Name="NewDatabaseNameTextBox" Style="{StaticResource InputTextBoxStyle}" Text="project_db" />
                                    <TextBlock Margin="0,12,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.DefaultDatabase}" />
                                    <TextBlock Foreground="{StaticResource AppWarningBrush}" Text="portable_dev" />
                                    <Button Margin="0,18,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left" IsEnabled="{Binding DatabaseActionsEnabled}"
                                            Click="CreateDatabase_Click" Content="{Binding Text.CreateDatabase}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                            </TabItem>
                            <TabItem Header="{Binding Text.AdministrationTab}">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.RootPasswordSecurity}" />
                                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource AppWarningBrush}" Text="{Binding RootPasswordState}" />
                                    <TextBlock Margin="0,14,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.NewPassword}" />
                                    <PasswordBox x:Name="RootPasswordBox" Style="{StaticResource InputPasswordBoxStyle}" />
                                    <TextBlock Margin="0,11,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ConfirmPassword}" />
                                    <PasswordBox x:Name="ConfirmRootPasswordBox" Style="{StaticResource InputPasswordBoxStyle}" />
                                    <TextBlock Margin="0,11,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Text.PasswordGuidance}" />
                                    <Button Margin="0,16,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left" IsEnabled="{Binding DatabaseActionsEnabled}"
                                            Click="ChangeRootPassword_Click" Content="{Binding RootPasswordActionLabel}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="phpMyAdmin 5.2.3" />
                                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Text.PhpMyAdminDescription}" />
                                    <TextBlock Margin="0,16,0,4" Foreground="{StaticResource AppSubtleBrush}" Text="URL" />
                                    <TextBlock Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap" Text="{Binding PhpMyAdminUrl}" />
                                    <TextBlock Margin="0,12,0,0" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap"
                                               Text="{Binding PhpMyAdminDependencyState}" />
                                    <Button Margin="0,18,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                            HorizontalAlignment="Left" IsEnabled="{Binding PhpMyAdminActionEnabled}" Click="OpenPhpMyAdmin_Click"
                                            Content="{Binding Text.OpenPhpMyAdmin}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                            </TabItem>
                            <TabItem Header="{Binding Text.DatabasesTab}">
                        <Border Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.DatabaseOverview}" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding DatabaseCount}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="13,8"
                                            IsEnabled="{Binding DatabaseActionsEnabled}" Click="RefreshDatabases_Click"
                                            Content="{Binding Text.Refresh}" />
                                </Grid>
                                <ListBox MaxHeight="420" ItemsSource="{Binding Databases}" Style="{StaticResource PackageListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="13,11" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AppWarningBrush}" Text="{Binding ApproximateSize}" />
                                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource AppSubtleBrush}"
                                                                   Text="{Binding DataContext.Text.ApproximateSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Selenium -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Selenium}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Selenium Server" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold" Text="{Binding SeleniumService.State}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding SeleniumService.Detail}" />
                                    <TextBlock Margin="0,8,20,0" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap" Text="{Binding SeleniumHubUrl}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}" Padding="15,10"
                                            IsEnabled="{Binding SeleniumIsRunning}" Click="OpenSeleniumHub_Click"
                                            Content="{Binding Text.OpenSeleniumHub}" />
                                    <Button Style="{StaticResource ActionButtonStyle}" MinWidth="170" Padding="18,11"
                                            IsEnabled="{Binding SeleniumActionEnabled}" Click="ToggleSelenium_Click"
                                            Content="{Binding SeleniumActionLabel}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TabControl Style="{StaticResource SectionTabControlStyle}">
                            <TabItem Header="{Binding Text.SeleniumSettings}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SeleniumSettings}" />
                                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                       Text="{Binding Text.ManagedOnPortsPage}" />
                                            <TextBlock Margin="0,12,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.MaximumSessions}" />
                                            <TextBox x:Name="SeleniumMaxSessionsTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding SeleniumSettingsEnabled}" />
                                            <TextBlock Margin="0,12,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.SessionTimeout}" />
                                            <TextBox x:Name="SeleniumSessionTimeoutTextBox" Style="{StaticResource InputTextBoxStyle}"
                                                     IsEnabled="{Binding SeleniumSettingsEnabled}" />
                                            <TextBlock Margin="0,9,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                       Text="{Binding Text.SessionTimeoutHelp}" />
                                            <CheckBox x:Name="SeleniumDownloadsEnabledCheckBox" Margin="0,14,0,0"
                                                      Foreground="{StaticResource AppForegroundBrush}" IsEnabled="{Binding SeleniumSettingsEnabled}"
                                                      Content="{Binding Text.EnableSeleniumDownloads}" />
                                            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                       Text="{Binding Text.SeleniumDownloadsHelp}" />
                                            <Button Margin="0,15,0,0" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                                    HorizontalAlignment="Left" IsEnabled="{Binding SeleniumSettingsEnabled}"
                                                    Click="SaveSeleniumSettings_Click" Content="{Binding Text.SaveSeleniumSettings}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{Binding Text.SeleniumDrivers}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SeleniumDriverCatalog}" />
                                            <TextBlock Margin="0,8,0,10" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                       Text="{Binding Text.SeleniumDriversHelp}" />
                                            <ItemsControl ItemsSource="{Binding SeleniumDriverPackages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,9" Padding="13,11" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                            <Grid>
                                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{StaticResource AppWarningBrush}" Text="{Binding Version}" />
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Margin="0,5,0,9" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap" Text="{Binding Description}" />
                                                                <Grid Grid.Row="2">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                    <Button Padding="12,7" IsEnabled="{Binding CanInstall}"
                                                                            Click="InstallRuntimePackage_Click">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                                                <Setter Property="Content" Value="{Binding DataContext.Text.DownloadAndInstall, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                        <Setter Property="Content" Value="{Binding DataContext.Text.Installed, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Foreground="{StaticResource AppSuccessBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                                                                        <ProgressBar Margin="0,5,0,0" Height="4" Minimum="0" Maximum="100"
                                                                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                     Value="{Binding Progress, Mode=OneWay}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.InstalledSeleniumDrivers}" />
                                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource AppWarningBrush}" Text="{Binding SeleniumDriverCount}" />
                                            <WrapPanel Margin="0,14,0,8">
                                                <Button Style="{StaticResource ActionButtonStyle}" Padding="13,8"
                                                        IsEnabled="{Binding SeleniumSettingsEnabled}" Click="ReloadSeleniumDrivers_Click"
                                                        Content="{Binding Text.ReloadDrivers}" />
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding SeleniumDrivers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,6,0,0" Padding="12,10" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                    <TextBlock Grid.Column="1" Foreground="{StaticResource AppWarningBrush}" Text="{Binding Version}" />
                                                                </Grid>
                                                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Source}" />
                                                                <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap" Text="{Binding RelativePath}" />
                                                                <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Detail}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{Binding Text.SeleniumProfiles}">
                                <TabControl Style="{StaticResource SectionTabControlStyle}">
                                    <TabItem Header="{Binding Text.SeleniumBrowserProfiles}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource PanelCardStyle}" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SeleniumProfileManagement}" />
                                                    <TextBlock Margin="0,8,0,12" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Text.SeleniumProfilesHelp}" />
                                                    <TextBlock Margin="0,0,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ProfileName}" />
                                                    <TextBox x:Name="SeleniumCleanProfileNameTextBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="80" />
                                                    <TextBlock Margin="0,12,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.BrowserEnvironment}" />
                                                    <ComboBox x:Name="SeleniumProfileEnvironmentSelector" Style="{StaticResource AppComboBoxStyle}"
                                                              ItemsSource="{Binding SeleniumBrowserChoices}"
                                                              DisplayMemberPath="Label" SelectedValuePath="Id" SelectedIndex="0" />
                                                    <Button Margin="0,12,0,0" Style="{StaticResource ActionButtonStyle}" Padding="13,8"
                                                            HorizontalAlignment="Left" IsEnabled="{Binding SeleniumProfileActionsEnabled}"
                                                            Click="CreateCleanSeleniumProfile_Click" Content="{Binding Text.CreateCleanMaster}" />
                                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                               Text="{Binding Text.CreateCleanMasterHelp}" />
                                                    <StackPanel x:Name="SeleniumProfileProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                                        <TextBlock x:Name="SeleniumProfileProgressText" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap" />
                                                        <ProgressBar x:Name="SeleniumProfileProgressBar" Margin="0,7,0,0" Height="5" IsIndeterminate="False" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SeleniumProfileMasters}" />
                                                    <TextBlock Margin="0,5,0,10" Foreground="{StaticResource AppWarningBrush}" Text="{Binding SeleniumProfileCount}" />
                                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AppMutedBrush}"
                                                               Visibility="{Binding NoSeleniumProfiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Text="{Binding Text.NoSeleniumProfiles}" />
                                                    <ListBox MaxHeight="430" ItemsSource="{Binding SeleniumProfiles}" Style="{StaticResource PackageListBoxStyle}">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,9" Padding="14,12" Background="{StaticResource AppInputBrush}"
                                                                        BorderBrush="{StaticResource AppButtonBorderBrush}" BorderThickness="1" CornerRadius="6">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" Text="{Binding Name}" />
                                                                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Browser}" />
                                                                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AppSubtleBrush}" FontSize="11"
                                                                                           TextTrimming="CharacterEllipsis" Text="{Binding CapabilityValue}" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" HorizontalAlignment="Right">
                                                                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Size}" />
                                                                                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Right" Foreground="{StaticResource AppSuccessBrush}"
                                                                                           FontSize="11" Text="{Binding Verification}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                                            <Button Style="{StaticResource ActionButtonStyle}" Tag="{Binding Id}"
                                                                                    IsEnabled="{Binding DataContext.SeleniumProfileActionsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    Click="EditSeleniumProfile_Click" Content="{Binding DataContext.Text.EditSeleniumProfile, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                            <Button Margin="7,0,0,0" Style="{StaticResource ActionButtonStyle}" Tag="{Binding Id}"
                                                                                    Click="CopySeleniumProfileId_Click" Content="{Binding DataContext.Text.CopyId, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                            <Button Margin="7,0,0,0" Style="{StaticResource ActionButtonStyle}" Foreground="{StaticResource AppDangerBorderBrush}"
                                                                                    Tag="{Binding Id}" IsEnabled="{Binding DataContext.SeleniumProfileActionsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    Click="RemoveSeleniumProfile_Click" Content="{Binding DataContext.Text.Delete, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="{Binding Text.SeleniumCookieVaults}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource PanelCardStyle}">
                                                <StackPanel>
                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CookieVaultManagement}" />
                                                    <TextBlock Margin="0,8,0,12" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Text.CookieVaultHelp}" />
                                                    <TextBlock Margin="0,0,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.CookieVaultName}" />
                                                    <TextBox x:Name="CookieVaultNameTextBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="80" />
                                                    <TextBlock Margin="0,12,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.CookieExportFile}" />
                                                    <Button Style="{StaticResource ActionButtonStyle}" Padding="13,8" HorizontalAlignment="Left"
                                                            Click="ChooseCookieFile_Click" Content="{Binding Text.ChooseCookieFile}" />
                                                    <TextBlock x:Name="SelectedCookieFileText" Margin="0,7,0,0" Foreground="{StaticResource AppMutedBrush}"
                                                               TextWrapping="Wrap" Text="{Binding Text.NoCookieFileSelected}" />
                                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                               Text="{Binding Text.CookieVaultAutomaticProtectionHelp}" />
                                                    <Button Margin="0,12,0,0" Style="{StaticResource ActionButtonStyle}" Padding="13,8"
                                                            HorizontalAlignment="Left" IsEnabled="{Binding SeleniumProfileActionsEnabled}"
                                                            Click="ImportCookieVault_Click" Content="{Binding Text.ImportCookieVault}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                                <StackPanel>
                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SeleniumCookieVaults}" />
                                                    <TextBlock Margin="0,5,0,4" Foreground="{StaticResource AppWarningBrush}" Text="{Binding SeleniumCookieVaultCount}" />
                                                    <TextBlock Margin="0,0,0,10" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                               Text="{Binding Text.CookieVaultCapabilityHelp}" />
                                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AppMutedBrush}"
                                                               Visibility="{Binding NoSeleniumCookieVaults, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Text="{Binding Text.NoCookieVaults}" />
                                                    <ListBox MaxHeight="430" ItemsSource="{Binding SeleniumCookieVaults}" Style="{StaticResource PackageListBoxStyle}">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,9" Padding="13,11" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                            <TextBlock Margin="0,4,12,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Domains}" />
                                                                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource AppSubtleBrush}" FontSize="10" Text="{Binding CookieCount}" />
                                                                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource AppSubtleBrush}" FontSize="10" Text="{Binding CapabilityValue}" />
                                                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AppSuccessBrush}" FontSize="10" TextWrapping="Wrap" Text="{Binding Status}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                            <Button Style="{StaticResource ActionButtonStyle}" Padding="12,7" Tag="{Binding Id}"
                                                                                    Click="CopyCookieVaultId_Click" Content="{Binding DataContext.Text.CopyId, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                            <Button Margin="0,6,0,0" Style="{StaticResource ActionButtonStyle}" Padding="12,7" Tag="{Binding Id}"
                                                                                    IsEnabled="{Binding DataContext.SeleniumProfileActionsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    Click="RemoveCookieVault_Click" Content="{Binding DataContext.Text.Delete, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </TabItem>
                            <TabItem Header="{Binding Text.SeleniumSessions}">
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.SeleniumSessions}" />
                                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AppWarningBrush}" Text="{Binding SeleniumSessionCount}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="13,8"
                                                    IsEnabled="{Binding SeleniumSessionActionsEnabled}" Click="RefreshSeleniumSessions_Click"
                                                    Content="{Binding Text.Refresh}" />
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource AppMutedBrush}"
                                                   Visibility="{Binding NoSeleniumSessions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   Text="{Binding Text.NoSeleniumSessions}" />
                                        <ListBox MaxHeight="460" ItemsSource="{Binding SeleniumSessions}" Style="{StaticResource PackageListBoxStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="13,11" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="1*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding DataContext.Text.Browser, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,3,8,0" FontWeight="SemiBold" Text="{Binding Browser}" />
                                                                <TextBlock Margin="0,3,8,0" FontSize="9" Foreground="{StaticResource AppSubtleBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Id}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding DataContext.Text.Platform, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,3,8,0" Text="{Binding Platform}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding DataContext.Text.Started, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,3,8,0" Text="{Binding StartedAt}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3">
                                                                <TextBlock FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding DataContext.Text.Duration, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,3,10,0" Foreground="{StaticResource AppWarningBrush}" Text="{Binding Duration}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                                                                    VerticalAlignment="Center" Tag="{Binding Id}" Click="TerminateSeleniumSession_Click"
                                                                    IsEnabled="{Binding DataContext.SeleniumSessionActionsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Content="{Binding DataContext.Text.TerminateSession, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Ports -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Ports}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Text.CentralPortManager}" />
                                    <TextBlock Margin="0,7,24,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                               Text="{Binding Text.PortManagerHelp}" />
                                    <TextBlock Margin="0,9,24,0" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap"
                                               Text="{Binding PortSettingsAvailability}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="15,9"
                                        VerticalAlignment="Center" Click="RefreshPorts_Click"
                                        Content="{Binding Text.RefreshPortList}" />
                            </Grid>
                        </Border>
                        <TabControl Style="{StaticResource SectionTabControlStyle}">
                            <TabItem Header="{Binding Text.ApplicationPortsTab}">
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="1.3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ServiceControl}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Port}" />
                                            <TextBlock Grid.Column="2" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.PortStatus}" />
                                        </Grid>
                                        <Border Margin="0,5,0,0" Padding="13,10" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.ApacheHttpPort}" />
                                                <TextBox x:Name="ApachePortTextBox" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                         Style="{StaticResource InputTextBoxStyle}" IsEnabled="{Binding PortSettingsEnabled}"
                                                         TextChanged="PortTextBox_TextChanged" />
                                                <TextBlock x:Name="ApachePortStatusText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppWarningBrush}" />
                                            </Grid>
                                        </Border>
                                        <Border Margin="0,7,0,0" Padding="13,10" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.PhpFastCgiPortLabel}" />
                                                <TextBox x:Name="PhpFastCgiPortTextBox" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                         Style="{StaticResource InputTextBoxStyle}" IsEnabled="{Binding PortSettingsEnabled}"
                                                         TextChanged="PortTextBox_TextChanged" />
                                                <TextBlock x:Name="PhpPortStatusText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppWarningBrush}" />
                                            </Grid>
                                        </Border>
                                        <Border Margin="0,7,0,0" Padding="13,10" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.MariaDbPortLabel}" />
                                                <TextBox x:Name="MariaDbPortTextBox" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                         Style="{StaticResource InputTextBoxStyle}" IsEnabled="{Binding PortSettingsEnabled}"
                                                         TextChanged="PortTextBox_TextChanged" />
                                                <TextBlock x:Name="MariaDbPortStatusText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppWarningBrush}" />
                                            </Grid>
                                        </Border>
                                        <Border Margin="0,7,0,0" Padding="13,10" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.SeleniumPortLabel}" />
                                                <TextBox x:Name="CentralSeleniumPortTextBox" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                         Style="{StaticResource InputTextBoxStyle}" IsEnabled="{Binding PortSettingsEnabled}"
                                                         TextChanged="PortTextBox_TextChanged" />
                                                <TextBlock x:Name="SeleniumPortStatusText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppWarningBrush}" />
                                            </Grid>
                                        </Border>
                                        <Button Margin="0,15,0,0" Style="{StaticResource ActionButtonStyle}" Padding="16,10"
                                                HorizontalAlignment="Left" IsEnabled="{Binding PortSettingsEnabled}"
                                                Click="SavePorts_Click" Content="{Binding Text.SavePorts}" />
                                    </StackPanel>
                                </Border>
                            </TabItem>
                            <TabItem Header="{Binding Text.ListeningPortsTab}">
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.ListeningPortsTab}" />
                                                <TextBlock Margin="0,5,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                           Text="{Binding Text.PortReadOnlyNotice}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Top" Foreground="{StaticResource AppWarningBrush}" Text="{Binding TcpListenerCount}" />
                                        </Grid>
                                        <Grid Margin="13,0,13,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.LocalAddress}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Port}" />
                                        </Grid>
                                        <ListBox MaxHeight="380" ItemsSource="{Binding TcpListeners}" Style="{StaticResource PackageListBoxStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,3,0,0" Padding="13,9" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Address}" />
                                                            <TextBlock Grid.Column="1" Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold" Text="{Binding Port}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Composer -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Composer}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Composer" />
                                    <TextBlock Margin="0,6,20,0" Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold"
                                               Text="{Binding Composer.RuntimeVersion, StringFormat=Version {0}}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                               Text="{Binding Composer.RuntimeDetail}" />
                                    <TextBlock Margin="0,8,20,0" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap"
                                               Text="{Binding Composer.ProjectRelativePath}" />
                                    <ComboBox Margin="0,10,20,0" Width="260" HorizontalAlignment="Left"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding WebProjects}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding ActiveWebProjectId, Mode=OneWay}" SelectionChanged="WebProjectSelection_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Padding="13,9"
                                            Click="OpenComposerProject_Click" Content="{Binding Text.OpenProjectDirectory}" />
                                    <Button Style="{StaticResource ActionButtonStyle}" Padding="13,9"
                                            IsEnabled="{Binding Composer.CanOperate}" Click="RefreshComposerPackages_Click"
                                            Content="{Binding Text.RefreshPackages}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ContentControl Grid.Row="1" Margin="0,0,0,18" Content="{Binding Composer}"
                                        ContentTemplate="{StaticResource OperationProgressTemplate}" />
                        <Grid Grid.Row="2" MinHeight="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.AddPackage}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Text.ComposerHelp}" />
                                    <TextBlock Margin="0,15,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.PackageName}" />
                                    <TextBox x:Name="ComposerPackageNameTextBox" Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding Composer.CanOperate}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ComposerPackageExample}" />
                                    <TextBlock Margin="0,12,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.VersionConstraint}" />
                                    <TextBox x:Name="ComposerVersionConstraintTextBox" Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding Composer.CanOperate}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ComposerConstraintExample}" />
                                    <Button Margin="0,15,0,0" Padding="15,9" HorizontalAlignment="Left"
                                            IsEnabled="{Binding Composer.CanOperate}" Click="InstallComposerPackage_Click">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButtonStyle}">
                                                <Setter Property="Content" Value="{Binding Text.InstallPackage}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Composer.IsBusy}" Value="True">
                                                        <Setter Property="Content" Value="{Binding Composer.OperationStatus}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap"
                                               Text="{Binding Text.PackageNetworkNotice}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <Grid MinHeight="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.InstalledPackages}" />
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource AppWarningBrush}" Text="{Binding Composer.DirectPackages.Count}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="{StaticResource AppMutedBrush}"
                                               Visibility="{Binding Composer.NoPackages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Text="{Binding Text.NoInstalledPackages}" />
                                    <Expander Grid.Row="2" Margin="0,4,0,10" Style="{StaticResource AppNavigationGroupExpanderStyle}"
                                              Visibility="{Binding Composer.HasTransitivePackages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Expander.Header>
                                            <TextBlock Foreground="{StaticResource AppMutedBrush}">
                                                <Run Text="{Binding Text.TransitiveDependencies, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Composer.TransitivePackages.Count, Mode=OneWay}" />
                                            </TextBlock>
                                        </Expander.Header>
                                        <ListBox MaxHeight="150" Margin="0,8,0,0" ItemsSource="{Binding Composer.TransitivePackages}"
                                                 Style="{StaticResource PackageListBoxStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="10,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Version}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                    <ListBox Grid.Row="3" ItemsSource="{Binding Composer.DirectPackages}" Style="{StaticResource PackageListBoxStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="13,11" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                            <TextBlock Margin="0,3,10,0" Foreground="{StaticResource AppWarningBrush}" Text="{Binding Version}" />
                                                            <TextBlock Margin="0,3,10,0" FontSize="10" Foreground="{StaticResource AppSubtleBrush}"
                                                                       TextWrapping="Wrap" Text="{Binding Description}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                                                                Tag="{Binding Name}" IsEnabled="{Binding IsDirectDependency}"
                                                                Click="RemoveComposerPackage_Click"
                                                                Content="{Binding DataContext.Text.RemovePackage, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                </Grid>

                <!-- Python -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Python}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Python" />
                                    <TextBlock Margin="0,6,20,0" Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold"
                                               Text="{Binding Python.RuntimeVersion, StringFormat=Version {0}}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                               Text="{Binding Python.RuntimeDetail}" />
                                    <TextBlock Margin="0,8,20,0" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap"
                                               Text="{Binding Python.ProjectRelativePath}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Padding="13,9"
                                            Click="OpenPythonProject_Click" Content="{Binding Text.OpenProjectDirectory}" />
                                    <Button Style="{StaticResource ActionButtonStyle}" Padding="13,9"
                                            IsEnabled="{Binding Python.CanOperate}" Click="RefreshPythonPackages_Click"
                                            Content="{Binding Text.RefreshPackages}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ContentControl Grid.Row="1" Margin="0,0,0,18" Content="{Binding Python}"
                                        ContentTemplate="{StaticResource OperationProgressTemplate}" />
                        <Grid Grid.Row="2" MinHeight="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.AddPackage}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Text="{Binding Text.PythonHelp}" />
                                    <TextBlock Margin="0,15,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.PackageName}" />
                                    <TextBox x:Name="PythonPackageNameTextBox" Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding Python.CanOperate}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.PythonPackageExample}" />
                                    <TextBlock Margin="0,12,0,5" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.VersionConstraint}" />
                                    <TextBox x:Name="PythonVersionConstraintTextBox" Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding Python.CanOperate}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.PythonConstraintExample}" />
                                    <Button Margin="0,15,0,0" Padding="15,9" HorizontalAlignment="Left"
                                            IsEnabled="{Binding Python.CanOperate}" Click="InstallPythonPackage_Click">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButtonStyle}">
                                                <Setter Property="Content" Value="{Binding Text.InstallPackage}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Python.IsBusy}" Value="True">
                                                        <Setter Property="Content" Value="{Binding Python.OperationStatus}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap"
                                               Text="{Binding Text.PackageNetworkNotice}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                                <Grid MinHeight="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.InstalledPackages}" />
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource AppWarningBrush}" Text="{Binding Python.DirectPackages.Count}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="{StaticResource AppMutedBrush}"
                                               Visibility="{Binding Python.NoPackages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Text="{Binding Text.NoInstalledPackages}" />
                                    <Expander Grid.Row="2" Margin="0,4,0,10" Style="{StaticResource AppNavigationGroupExpanderStyle}"
                                              Visibility="{Binding Python.HasTransitivePackages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Expander.Header>
                                            <TextBlock Foreground="{StaticResource AppMutedBrush}">
                                                <Run Text="{Binding Text.TransitiveDependencies, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Python.TransitivePackages.Count, Mode=OneWay}" />
                                            </TextBlock>
                                        </Expander.Header>
                                        <ListBox MaxHeight="150" Margin="0,8,0,0" ItemsSource="{Binding Python.TransitivePackages}"
                                                 Style="{StaticResource PackageListBoxStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="10,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Version}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                    <ListBox Grid.Row="3" ItemsSource="{Binding Python.DirectPackages}" Style="{StaticResource PackageListBoxStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="13,11" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                            <TextBlock Margin="0,3,10,0" Foreground="{StaticResource AppWarningBrush}" Text="{Binding Version}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                                                                Tag="{Binding Name}" IsEnabled="{Binding DataContext.Python.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Click="RemovePythonPackage_Click"
                                                                Content="{Binding DataContext.Text.RemovePackage, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                </Grid>

                <!-- Terminal -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Terminal}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Margin="0,0,0,8" Padding="8" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppControlHoverBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Margin="4,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ActiveProject}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding WebProjects}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding ActiveWebProjectId, Mode=OneWay}" SelectionChanged="WebProjectSelection_SelectionChanged" />
                        </Grid>
                    </Border>
                    <TextBox x:Name="TerminalConsoleTextBox" Grid.Row="1"
                             Padding="14" AcceptsReturn="True" AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono,Consolas" FontSize="13"
                             Foreground="{StaticResource AppCodeForegroundBrush}" Background="{StaticResource AppDeepSurfaceBrush}" BorderBrush="{StaticResource AppControlBrush}"
                             TextWrapping="NoWrap" ToolTip="{Binding Text.TerminalHelp}"
                             PreviewKeyDown="TerminalConsoleTextBox_PreviewKeyDown"
                             PreviewTextInput="TerminalConsoleTextBox_PreviewTextInput" />
                </Grid>

                <!-- Files -->
                <Border Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppControlBrush}" BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Files}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="10" Background="{StaticResource AppCardBrush}" CornerRadius="8,8,0,0" BorderBrush="{StaticResource AppControlBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource IconButtonStyle}" Click="WorkspaceBack_Click" ToolTip="{Binding Text.Back}">
                                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconBack}" />
                                </Button>
                                <ComboBox Grid.Column="1" Width="180" Margin="10,0,0,0"
                                          Style="{StaticResource AppComboBoxStyle}"
                                          ItemsSource="{Binding WebProjects}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding ActiveWebProjectId, Mode=OneWay}" SelectionChanged="WebProjectSelection_SelectionChanged" />
                                <TextBox x:Name="WorkspacePathTextBox" Grid.Column="2" Margin="10,0"
                                         Style="{StaticResource InputTextBoxStyle}" Padding="12,7"
                                         FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource AppCodeForegroundBrush}"
                                         ToolTip="{Binding Text.WorkspaceAddressHint}"
                                         KeyDown="WorkspacePathTextBox_KeyDown" GotKeyboardFocus="WorkspacePathTextBox_GotKeyboardFocus" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Margin="0,0,7,0" Style="{StaticResource ActionButtonStyle}" Padding="11,7"
                                            Click="CreateWorkspaceFile_Click" ToolTip="{Binding Text.NewFile}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="17" Height="17" Margin="0,0,7,0" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconFileAdd}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Text.NewFile}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,0,7,0" Style="{StaticResource ActionButtonStyle}" Padding="11,7"
                                            Click="CreateWorkspaceFolder_Click" ToolTip="{Binding Text.NewFolder}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="17" Height="17" Margin="0,0,7,0" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconFolderAdd}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Text.NewFolder}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Click="RefreshWorkspace_Click" ToolTip="{Binding Text.RefreshFiles}">
                                        <Path Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconRefresh}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Margin="14,9" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.FileManagerHelp}" />
                        <Grid Grid.Row="2" Margin="14,4,14,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="90" />
                                <ColumnDefinition Width="135" /><ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="WorkspaceNameSortButton" Grid.Column="1" Style="{StaticResource FileSortHeaderButtonStyle}" Tag="Name"
                                    Click="WorkspaceSort_Click" Content="{Binding Text.Name}" />
                            <Button x:Name="WorkspaceTypeSortButton" Grid.Column="2" Style="{StaticResource FileSortHeaderButtonStyle}" Tag="Type"
                                    Click="WorkspaceSort_Click" Content="{Binding Text.Type}" />
                            <Button x:Name="WorkspaceSizeSortButton" Grid.Column="3" Style="{StaticResource FileSortHeaderButtonStyle}" Tag="Size"
                                    Click="WorkspaceSort_Click" Content="{Binding Text.Size}" />
                            <Button x:Name="WorkspaceModifiedSortButton" Grid.Column="4" Style="{StaticResource FileSortHeaderButtonStyle}" Tag="Modified"
                                    Click="WorkspaceSort_Click" Content="{Binding Text.Modified}" />
                            <TextBlock Grid.Column="5" HorizontalAlignment="Center" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.Actions}" />
                        </Grid>
                        <Grid Grid.Row="3">
                            <TextBlock Margin="18,14" Foreground="{StaticResource AppMutedBrush}"
                                       Visibility="{Binding NoWorkspaceEntries, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="{Binding Text.EmptyFolder}" />
                            <ListBox Margin="8,0" ItemsSource="{Binding WorkspaceEntries}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,5" Padding="9,7" Background="{StaticResource AppInputBrush}" CornerRadius="4"
                                                    Tag="{Binding}" MouseLeftButtonDown="WorkspaceEntry_MouseLeftButtonDown">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="135" /><ColumnDefinition Width="132" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          Stretch="Uniform" Stroke="{StaticResource AppWarningBrush}" Fill="Transparent" StrokeThickness="1.6">
                                                        <Path.Style>
                                                            <Style TargetType="{x:Type Path}">
                                                                <Setter Property="Data" Value="{StaticResource IconFile}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                        <Setter Property="Data" Value="{StaticResource IconFolder}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Image">
                                                                        <Setter Property="Data" Value="{StaticResource IconImage}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Archive">
                                                                        <Setter Property="Data" Value="{StaticResource IconArchive}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Database">
                                                                        <Setter Property="Data" Value="{StaticResource IconDatabase}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Configuration">
                                                                        <Setter Property="Data" Value="{StaticResource IconGear}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Php">
                                                                        <Setter Property="Data" Value="{StaticResource IconCode}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Python">
                                                                        <Setter Property="Data" Value="{StaticResource IconCode}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="JavaScript">
                                                                        <Setter Property="Data" Value="{StaticResource IconBraces}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="StyleSheet">
                                                                        <Setter Property="Data" Value="{StaticResource IconBraces}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Html">
                                                                        <Setter Property="Data" Value="{StaticResource IconHtml}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Xml">
                                                                        <Setter Property="Data" Value="{StaticResource IconHtml}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Json">
                                                                        <Setter Property="Data" Value="{StaticResource IconBraces}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Yaml">
                                                                        <Setter Property="Data" Value="{StaticResource IconBraces}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Markdown">
                                                                        <Setter Property="Data" Value="{StaticResource IconText}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Text">
                                                                        <Setter Property="Data" Value="{StaticResource IconText}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Document">
                                                                        <Setter Property="Data" Value="{StaticResource IconText}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Spreadsheet">
                                                                        <Setter Property="Data" Value="{StaticResource IconSpreadsheet}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Executable">
                                                                        <Setter Property="Data" Value="{StaticResource IconExecutable}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AppForegroundBrush}" Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Kind}" />
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Size}" />
                                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Modified}" />
                                                    <StackPanel Grid.Column="5" HorizontalAlignment="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource IconButtonStyle}" Tag="{Binding}" IsEnabled="{Binding IsSafe}"
                                                                Click="OpenWorkspaceItem_Click" ToolTip="{Binding DataContext.Text.Open, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconOpen}" />
                                                        </Button>
                                                        <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" IsEnabled="{Binding IsSafe}"
                                                                Click="RenameWorkspaceItem_Click" ToolTip="{Binding DataContext.Text.Rename, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconRename}" />
                                                        </Button>
                                                        <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" IsEnabled="{Binding IsSafe}"
                                                                Click="DeleteWorkspaceItem_Click" ToolTip="{Binding DataContext.Text.Delete, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconDelete}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Border Grid.Row="4" Padding="10,8" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppControlBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="WorkspacePageSizeSelector" Width="78" SelectedValuePath="Tag"
                                          SelectionChanged="WorkspacePageSizeSelector_SelectionChanged">
                                    <ComboBoxItem Tag="25" Content="25" />
                                    <ComboBoxItem Tag="50" Content="50" IsSelected="True" />
                                    <ComboBoxItem Tag="100" Content="100" />
                                </ComboBox>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource AppMutedBrush}" Text="{Binding WorkspacePageSummary}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButtonStyle}" Tag="First" IsEnabled="{Binding WorkspaceHasPreviousPage}"
                                            Click="WorkspacePage_Click" ToolTip="{Binding Text.FirstPage}">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconFirstPage}" />
                                    </Button>
                                    <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="Previous" IsEnabled="{Binding WorkspaceHasPreviousPage}"
                                            Click="WorkspacePage_Click" ToolTip="{Binding Text.PreviousPage}">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconPreviousPage}" />
                                    </Button>
                                    <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="Next" IsEnabled="{Binding WorkspaceHasNextPage}"
                                            Click="WorkspacePage_Click" ToolTip="{Binding Text.NextPage}">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconNextPage}" />
                                    </Button>
                                    <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="Last" IsEnabled="{Binding WorkspaceHasNextPage}"
                                            Click="WorkspacePage_Click" ToolTip="{Binding Text.LastPage}">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconLastPage}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tools -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Tools}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Text.PortableEditor}" />
                                    <TextBlock Margin="0,6,20,0" Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold"
                                               Text="{Binding EditorVersionLabel}" />
                                    <TextBlock Margin="0,5,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                               Text="{Binding EditorDetail}" />
                                    <TextBlock Margin="0,9,20,0" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap"
                                               Text="{Binding Text.PortableEditorHelp}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="16,10"
                                        VerticalAlignment="Center"
                                        Click="StartEditor_Click" Content="{Binding Text.StartEditor}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PanelCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CustomPhpIni}" />
                                    <TextBlock Margin="0,8,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                               Text="{Binding Text.CustomPhpIniHelp}" />
                                    <TextBlock Margin="0,10,20,0" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap"
                                               Text="instances/default/config/php-custom.ini" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Padding="16,10"
                                        VerticalAlignment="Center" IsEnabled="{Binding EditorReady}"
                                        Click="EditCustomPhpIni_Click" Content="{Binding Text.EditCustomPhpIni}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Guides -->
                <Border Style="{StaticResource PanelCardStyle}"
                        Padding="22,18"
                        Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Guides}">
                    <FlowDocumentScrollViewer x:Name="GuidesDocumentViewer"
                                              IsToolBarVisible="False"
                                              Background="Transparent"
                                              Foreground="{StaticResource AppForegroundBrush}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" />
                </Border>

                <!-- Settings -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.PortableStorage}" />
                                <TextBlock Margin="0,14,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ApplicationRoot}" />
                                <TextBlock Text="{Binding RootPath}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,16,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                           Text="{Binding Text.PortableBoundaryNote}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18" MaxWidth="820" HorizontalAlignment="Left">
                            <StackPanel x:Name="StorageActionsPanel">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CacheManagement}" />
                                        <TextBlock Margin="0,7,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                   Text="{Binding Text.CacheManagementHelp}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Padding="14,9"
                                                Click="RefreshStorageUsage_Click" Content="{Binding Text.RefreshStorage}" />
                                        <Button x:Name="ClearAllCachesButton" Style="{StaticResource ActionButtonStyle}" Padding="14,9"
                                                Click="ClearAllStorageCaches_Click" Content="{Binding Text.ClearAllCaches}" />
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,16,0,0" Padding="12,4" Background="{StaticResource AppDeepSurfaceBrush}"
                                        BorderBrush="{StaticResource AppButtonBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="90" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Text.RuntimePackageCache}" />
                                        <TextBlock x:Name="RuntimePackageCacheSizeText" Grid.Column="1" Margin="18,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                        <Button x:Name="ClearRuntimePackageCacheButton" Grid.Column="2" Margin="6,5,0,5"
                                                Tag="RuntimePackages" Style="{StaticResource ActionButtonStyle}"
                                                Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding Text.ComposerCache}" />
                                        <TextBlock x:Name="ComposerCacheSizeText" Grid.Row="1" Grid.Column="1" Margin="18,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                        <Button x:Name="ClearComposerCacheButton" Grid.Row="1" Grid.Column="2" Margin="6,5,0,5"
                                                Tag="Composer" Style="{StaticResource ActionButtonStyle}"
                                                Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding Text.PipCache}" />
                                        <TextBlock x:Name="PipCacheSizeText" Grid.Row="2" Grid.Column="1" Margin="18,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                        <Button x:Name="ClearPipCacheButton" Grid.Row="2" Grid.Column="2" Margin="6,5,0,5"
                                                Tag="Pip" Style="{StaticResource ActionButtonStyle}"
                                                Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                        <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,0"
                                                BorderBrush="{StaticResource AppButtonBorderBrush}" BorderThickness="0,1,0,0" />
                                        <TextBlock Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.TotalCache}" />
                                        <TextBlock x:Name="TotalCacheSizeText" Grid.Row="3" Grid.Column="1" Margin="18,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold" Text="—" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="StorageOverviewStatusText" Margin="0,13,0,0" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.ProtectedStorage}" />
                                <TextBlock Margin="0,7,0,12" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                           Text="{Binding Text.ProtectedStorageHelp}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text.InstalledRuntimes}" />
                                    <TextBlock x:Name="InstalledRuntimeSizeText" Grid.Column="1" Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                </Grid>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text.PersistentProjectData}" />
                                    <TextBlock x:Name="PersistentDataSizeText" Grid.Column="1" Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.TechnicalDetails}" />
                                <TextBlock Margin="0,14,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ApplicationVersion}" />
                                <TextBlock Text="{Binding ApplicationVersion}" />
                                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap">
                                    <Run Text="Apache " /><Run Text="{Binding ApachePort, Mode=OneWay}" /><Run Text="  •  PHP FastCGI " />
                                    <Run Text="{Binding PhpFastCgiPort, Mode=OneWay}" /><Run Text="  •  MariaDB " /><Run Text="{Binding MariaDbPort, Mode=OneWay}" />
                                    <Run Text="  •  Selenium " /><Run Text="{Binding SeleniumPort, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <TextBlock x:Name="InstallationStatusText"
                       Grid.Row="2"
                       Margin="0,14,0,0"
                       Foreground="{StaticResource AppSubtleBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding Text.InitialStatus}" />
        </Grid>
        </Grid>
        <Grid Grid.Row="1" Panel.ZIndex="100" Background="{StaticResource AppOverlayBrush}"
              Visibility="{Binding GlobalOperation.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding GlobalOperation.Status}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding GlobalOperation.Detail}"
                               Visibility="{Binding GlobalOperation.Detail, Converter={StaticResource StringToVisibilityConverter}}" />
                    <ProgressBar Margin="0,15,0,0" Height="7" Minimum="0" Maximum="100"
                                 IsIndeterminate="{Binding GlobalOperation.IsIndeterminate, Mode=OneWay}"
                                 Value="{Binding GlobalOperation.Progress, Mode=OneWay}" />
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Text.OperationPleaseWait}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
