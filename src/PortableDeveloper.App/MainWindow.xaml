                                                <Run Text="{Binding Text.TransitiveDependencies, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Python.TransitivePackages.Count, Mode=OneWay}" />
                                            </TextBlock>
                                        </Expander.Header>
                                        <ListBox MaxHeight="150" Margin="0,8,0,0" ItemsSource="{Binding Python.TransitivePackages}"
                                                 Style="{StaticResource PackageListBoxStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="10,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Version}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                    <ListBox Grid.Row="3" ItemsSource="{Binding Python.DirectPackages}" Style="{StaticResource PackageListBoxStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="13,11" Background="{StaticResource AppInputBrush}" CornerRadius="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                            <TextBlock Margin="0,3,10,0" Foreground="{StaticResource AppWarningBrush}" Text="{Binding Version}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                                                                Tag="{Binding Name}" IsEnabled="{Binding DataContext.Python.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Click="RemovePythonPackage_Click"
                                                                Content="{Binding DataContext.Text.RemovePackage, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                </Grid>
                </ScrollViewer>

                <!-- Scheduler -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Scheduler}">
                    <StackPanel>
                        <TabControl Style="{StaticResource SectionTabControlStyle}">
                            <TabItem Header="{Binding Text.SchedulerTasksTab}">
                                <StackPanel>
                                    <Border Margin="0,0,0,14" Style="{StaticResource PanelCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" Foreground="{StaticResource AppMutedBrush}"
                                                       TextWrapping="Wrap" Text="{Binding Text.SchedulerRunsOnlyWhileOpen}" />
                                            <Button Grid.Column="1" Padding="14,9" Style="{StaticResource ActionButtonStyle}"
                                                    Click="NewScheduledTask_Click" Content="{Binding Text.NewScheduledTask}" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Margin="4,12" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Text.NoScheduledTasks}"
                                               Visibility="{Binding NoScheduledTasks, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="16" Background="{StaticResource AppCardBrush}"
                                                        BorderBrush="{StaticResource AppButtonBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.3*" />
                                                            <ColumnDefinition Width="1.4*" />
                                                            <ColumnDefinition Width="1.4*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                                                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Target}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding DataContext.Text.ScheduledTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <TextBlock Margin="0,5,0,0" Text="{Binding Command}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding DataContext.Text.ScheduledTaskSchedule, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <TextBlock Margin="0,5,0,0" Text="{Binding Schedule}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Margin="18,0,0,0">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding DataContext.Text.ScheduledTaskStatus, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Status}" />
                                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource AppMutedBrush}" Text="{Binding NextRun}" />
                                                            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource AppMutedBrush}" Text="{Binding LastRun}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Padding="12,8" Style="{StaticResource ActionButtonStyle}" Tag="{Binding Id}"
                                                                    IsEnabled="{Binding CanRun}" Click="RunScheduledTask_Click"
                                                                    Content="{Binding DataContext.Text.RunScheduledTaskNow, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <Button Margin="7,0,0,0" Padding="12,8" Style="{StaticResource ActionButtonStyle}" Tag="{Binding Id}"
                                                                    IsEnabled="{Binding CanRun}" Click="EditScheduledTask_Click"
                                                                    Content="{Binding DataContext.Text.EditScheduledTask, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <Button Margin="7,0,0,0" Padding="12,8" Style="{StaticResource ActionButtonStyle}" Tag="{Binding Id}"
                                                                    IsEnabled="{Binding CanRun}" Click="DeleteScheduledTask_Click"
                                                                    Content="{Binding DataContext.Text.DeleteScheduledTask, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="{Binding Text.SchedulerHistoryTab}">
                                <StackPanel>
                                    <TextBlock Margin="4,12" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Text.NoScheduledTaskHistory}"
                                               Visibility="{Binding NoScheduledTaskHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding ScheduledTaskHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="16" Background="{StaticResource AppCardBrush}"
                                                        BorderBrush="{StaticResource AppButtonBorderBrush}" BorderThickness="1" CornerRadius="8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="1.4*" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding TaskName}" />
                                                            <TextBlock Grid.Column="1" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Started}" />
                                                            <TextBlock Grid.Column="2" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Duration}" />
                                                            <TextBlock Grid.Column="3" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Trigger}" />
                                                            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="{Binding Result}" />
                                                        </Grid>
                                                        <Expander Margin="0,12,0,0" Header="{Binding DataContext.Text.ScheduledTaskOutput, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <TextBox Margin="0,8,0,0" Padding="10" MaxHeight="240" IsReadOnly="True"
                                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                                     Background="{StaticResource AppDeepSurfaceBrush}" Foreground="{StaticResource AppMutedBrush}"
                                                                     BorderBrush="{StaticResource AppButtonBorderBrush}" Text="{Binding Output}" />
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Terminal -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Terminal}">
                    <TextBox x:Name="TerminalConsoleTextBox"
                             Padding="14" AcceptsReturn="True" AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono,Consolas" FontSize="13"
                             Foreground="{StaticResource AppCodeForegroundBrush}" Background="{StaticResource AppDeepSurfaceBrush}" BorderBrush="{StaticResource AppControlBrush}"
                             TextWrapping="NoWrap"
                             PreviewKeyDown="TerminalConsoleTextBox_PreviewKeyDown"
                             PreviewTextInput="TerminalConsoleTextBox_PreviewTextInput" />
                </Grid>

                <!-- Files -->
                <Border Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppControlBrush}" BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Files}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="10" Background="{StaticResource AppCardBrush}" CornerRadius="8,8,0,0" BorderBrush="{StaticResource AppControlBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource IconButtonStyle}" Click="WorkspaceBack_Click" ToolTip="{Binding Text.Back}">
                                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconBack}" />
                                </Button>
                                <TextBox x:Name="WorkspacePathTextBox" Grid.Column="1" Margin="10,0"
                                         Style="{StaticResource InputTextBoxStyle}" Padding="12,7"
                                         FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource AppCodeForegroundBrush}"
                                         ToolTip="{Binding Text.WorkspaceAddressHint}"
                                         KeyDown="WorkspacePathTextBox_KeyDown" GotKeyboardFocus="WorkspacePathTextBox_GotKeyboardFocus" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButtonStyle}" Click="RefreshWorkspace_Click" ToolTip="{Binding Text.RefreshFiles}">
                                        <Path Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconRefresh}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="14,9,14,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" /><ColumnDefinition Width="135" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="WorkspaceNameSortButton" Grid.Column="1" Style="{StaticResource FileSortHeaderButtonStyle}" Tag="Name"
                                    Click="WorkspaceSort_Click" Content="{Binding Text.Name}" />
                            <Button x:Name="WorkspaceTypeSortButton" Grid.Column="2" Style="{StaticResource FileSortHeaderButtonStyle}" Tag="Type"
                                    Click="WorkspaceSort_Click" Content="{Binding Text.Type}" />
                            <Button x:Name="WorkspaceSizeSortButton" Grid.Column="3" Style="{StaticResource FileSortHeaderButtonStyle}" Tag="Size"
                                    Click="WorkspaceSort_Click" Content="{Binding Text.Size}" />
                            <Button x:Name="WorkspaceModifiedSortButton" Grid.Column="4" Style="{StaticResource FileSortHeaderButtonStyle}" Tag="Modified"
                                    Click="WorkspaceSort_Click" Content="{Binding Text.Modified}" />
                        </Grid>
                        <Grid Grid.Row="2" AllowDrop="True"
                              PreviewDragOver="WorkspaceFileList_DragOver"
                              Drop="WorkspaceFileList_Drop">
                            <TextBlock Margin="18,14" Foreground="{StaticResource AppMutedBrush}"
                                       Visibility="{Binding NoWorkspaceEntries, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="{Binding Text.EmptyFolder}" />
                            <ListBox x:Name="WorkspaceEntriesListBox" Margin="8,0" ItemsSource="{Binding WorkspaceEntries}"
                                     Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     PreviewKeyDown="WorkspaceEntriesListBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="WorkspaceEntriesListBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="WorkspaceEntriesListBox_PreviewMouseMove">
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource AppContextMenuStyle}" Opened="WorkspaceBackgroundContextMenu_Opened">
                                        <MenuItem x:Name="WorkspaceContextPasteMenuItem" Style="{StaticResource AppContextMenuItemStyle}"
                                                  InputGestureText="Ctrl+V" Click="WorkspaceContextPaste_Click" />
                                        <Separator Style="{StaticResource AppContextMenuSeparatorStyle}" />
                                        <MenuItem x:Name="WorkspaceContextNewFileMenuItem" Style="{StaticResource AppContextMenuItemStyle}" Click="CreateWorkspaceFile_Click" />
                                        <MenuItem x:Name="WorkspaceContextNewFolderMenuItem" Style="{StaticResource AppContextMenuItemStyle}" Click="CreateWorkspaceFolder_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Focusable" Value="True" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border x:Name="SelectionChrome" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SelectionChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="SelectionChrome" Property="Background" Value="{StaticResource AppControlBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,2" Padding="9,7" Background="Transparent" CornerRadius="4"
                                                    Tag="{Binding}" MouseLeftButtonDown="WorkspaceEntry_MouseLeftButtonDown">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="90" /><ColumnDefinition Width="135" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          Stretch="Uniform" Fill="Transparent" StrokeThickness="1.6">
                                                        <Path.Style>
                                                            <Style TargetType="{x:Type Path}">
                                                                <Setter Property="Data" Value="{StaticResource IconFile}" />
                                                                <Setter Property="Stroke" Value="{StaticResource AppMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                        <Setter Property="Data" Value="{StaticResource IconFolder}" />
                                                                        <Setter Property="Stroke" Value="{StaticResource AppWarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Image">
                                                                        <Setter Property="Data" Value="{StaticResource IconImage}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Archive">
                                                                        <Setter Property="Data" Value="{StaticResource IconArchive}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Database">
                                                                        <Setter Property="Data" Value="{StaticResource IconDatabase}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Configuration">
                                                                        <Setter Property="Data" Value="{StaticResource IconGear}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Php">
                                                                        <Setter Property="Data" Value="{StaticResource IconCode}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Python">
                                                                        <Setter Property="Data" Value="{StaticResource IconCode}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="JavaScript">
                                                                        <Setter Property="Data" Value="{StaticResource IconBraces}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="StyleSheet">
                                                                        <Setter Property="Data" Value="{StaticResource IconBraces}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Html">
                                                                        <Setter Property="Data" Value="{StaticResource IconHtml}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Xml">
                                                                        <Setter Property="Data" Value="{StaticResource IconHtml}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Json">
                                                                        <Setter Property="Data" Value="{StaticResource IconBraces}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Yaml">
                                                                        <Setter Property="Data" Value="{StaticResource IconBraces}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Markdown">
                                                                        <Setter Property="Data" Value="{StaticResource IconText}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Text">
                                                                        <Setter Property="Data" Value="{StaticResource IconText}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Document">
                                                                        <Setter Property="Data" Value="{StaticResource IconText}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Spreadsheet">
                                                                        <Setter Property="Data" Value="{StaticResource IconSpreadsheet}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FileKind}" Value="Executable">
                                                                        <Setter Property="Data" Value="{StaticResource IconExecutable}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <Grid Grid.Column="1">
                                                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="SemiBold" Cursor="IBeam"
                                                                   Tag="WorkspaceEntryName"
                                                                   Foreground="{StaticResource AppForegroundBrush}" Text="{Binding Name}"
                                                                   PreviewMouseLeftButtonUp="WorkspaceName_PreviewMouseLeftButtonUp"
                                                                   PreviewMouseRightButtonDown="WorkspaceName_PreviewMouseRightButtonDown">
                                                            <TextBlock.ContextMenu>
                                                                <ContextMenu Style="{StaticResource AppContextMenuStyle}" Opened="WorkspaceItemContextMenu_Opened">
                                                                    <MenuItem Style="{StaticResource AppContextMenuItemStyle}" Tag="Open" Click="WorkspaceContextOpen_Click" />
                                                                    <Separator Style="{StaticResource AppContextMenuSeparatorStyle}" />
                                                                    <MenuItem Style="{StaticResource AppContextMenuItemStyle}" Tag="Copy" InputGestureText="Ctrl+C" Click="WorkspaceContextCopy_Click" />
                                                                    <MenuItem Style="{StaticResource AppContextMenuItemStyle}" Tag="Cut" InputGestureText="Ctrl+X" Click="WorkspaceContextCut_Click" />
                                                                    <MenuItem Style="{StaticResource AppContextMenuItemStyle}" Tag="Rename" Click="WorkspaceContextRename_Click" />
                                                                    <MenuItem Style="{StaticResource AppContextMenuItemStyle}" Tag="Delete" Click="WorkspaceContextDelete_Click" />
                                                                </ContextMenu>
                                                            </TextBlock.ContextMenu>
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox Padding="5,2" Margin="-5,-3,8,-3"
                                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                                 KeyDown="WorkspaceRenameTextBox_KeyDown"
                                                                 LostKeyboardFocus="WorkspaceRenameTextBox_LostKeyboardFocus"
                                                                 IsVisibleChanged="WorkspaceRenameTextBox_IsVisibleChanged">
                                                            <TextBox.Style>
                                                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource InputTextBoxStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Kind}" />
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Size}" />
                                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Modified}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Border Grid.Row="3" Padding="10,8" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppControlBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="WorkspacePageSizeSelector" Width="78" SelectedValuePath="Tag"
                                          SelectionChanged="WorkspacePageSizeSelector_SelectionChanged">
                                    <ComboBoxItem Tag="25" Content="25" />
                                    <ComboBoxItem Tag="50" Content="50" IsSelected="True" />
                                    <ComboBoxItem Tag="100" Content="100" />
                                </ComboBox>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource AppMutedBrush}" Text="{Binding WorkspacePageSummary}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButtonStyle}" Tag="First" IsEnabled="{Binding WorkspaceHasPreviousPage}"
                                            Click="WorkspacePage_Click" ToolTip="{Binding Text.FirstPage}">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconFirstPage}" />
                                    </Button>
                                    <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="Previous" IsEnabled="{Binding WorkspaceHasPreviousPage}"
                                            Click="WorkspacePage_Click" ToolTip="{Binding Text.PreviousPage}">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconPreviousPage}" />
                                    </Button>
                                    <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="Next" IsEnabled="{Binding WorkspaceHasNextPage}"
                                            Click="WorkspacePage_Click" ToolTip="{Binding Text.NextPage}">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconNextPage}" />
                                    </Button>
                                    <Button Margin="5,0,0,0" Style="{StaticResource IconButtonStyle}" Tag="Last" IsEnabled="{Binding WorkspaceHasNextPage}"
                                            Click="WorkspacePage_Click" ToolTip="{Binding Text.LastPage}">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AppForegroundBrush}" StrokeThickness="1.7" Data="{StaticResource IconLastPage}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Guides -->
                <Border Style="{StaticResource PanelCardStyle}"
                        Padding="22,18"
                        Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Guides}">
                    <FlowDocumentScrollViewer x:Name="GuidesDocumentViewer"
                                              IsToolBarVisible="False"
                                              Background="Transparent"
                                              Foreground="{StaticResource AppForegroundBrush}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" />
                </Border>

                <!-- Settings -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}">
                    <StackPanel x:Name="SettingsContent">
                        <TabControl Style="{StaticResource SectionTabControlStyle}">
                            <TabItem Header="{Binding Text.SettingsGeneralTab}">
                                <StackPanel>
                                    <Border Width="{Binding ActualWidth, ElementName=SettingsContent}"
                                            Style="{StaticResource PanelCardStyle}" MaxWidth="820" HorizontalAlignment="Left">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="280" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.EditorSelection}" />
                                                <TextBlock Margin="0,7,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                           Text="{Binding Text.EditorSelectionHelp}" />
                                            </StackPanel>
                                            <ComboBox x:Name="EditorPreferenceSelector" Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource AppComboBoxStyle}" SelectedValuePath="Tag"
                                                      SelectionChanged="EditorPreferenceSelector_SelectionChanged">
                                                <ComboBoxItem Tag="PortableWhenAvailable" Content="{Binding Text.PreferPortableEditor}" />
                                                <ComboBoxItem Tag="WindowsDefault" Content="{Binding Text.UseWindowsDefaultEditor}" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{Binding Text.SettingsStorageTab}">
                                <StackPanel>
                        <Border Width="{Binding ActualWidth, ElementName=SettingsContent}"
                                Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18" MaxWidth="820" HorizontalAlignment="Left">
                            <StackPanel x:Name="StorageActionsPanel">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.CacheManagement}" />
                                        <TextBlock Margin="0,7,20,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                                   Text="{Binding Text.CacheManagementHelp}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" Padding="14,9"
                                                Click="RefreshStorageUsage_Click" Content="{Binding Text.RefreshStorage}" />
                                        <Button x:Name="ClearAllCachesButton" Style="{StaticResource ActionButtonStyle}" Padding="14,9"
                                                Click="ClearAllStorageCaches_Click" Content="{Binding Text.ClearAllCaches}" />
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,16,0,0" Padding="12,4" Background="{StaticResource AppDeepSurfaceBrush}"
                                        BorderBrush="{StaticResource AppButtonBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="90" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Text.RuntimePackageCache}" />
                                        <TextBlock x:Name="RuntimePackageCacheSizeText" Grid.Column="1" Margin="18,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                        <Button x:Name="ClearRuntimePackageCacheButton" Grid.Column="2" Margin="6,5,0,5"
                                                Tag="RuntimePackages" Style="{StaticResource ActionButtonStyle}"
                                                Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding Text.ComposerCache}" />
                                        <TextBlock x:Name="ComposerCacheSizeText" Grid.Row="1" Grid.Column="1" Margin="18,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                         <Button x:Name="ClearComposerCacheButton" Grid.Row="1" Grid.Column="2" Margin="6,5,0,5"
                                                 Tag="Composer" Style="{StaticResource ActionButtonStyle}"
                                                 Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                         <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding Text.NpmCache}" />
                                         <TextBlock x:Name="NpmCacheSizeText" Grid.Row="2" Grid.Column="1" Margin="18,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                         <Button x:Name="ClearNpmCacheButton" Grid.Row="2" Grid.Column="2" Margin="6,5,0,5"
                                                 Tag="Npm" Style="{StaticResource ActionButtonStyle}"
                                                 Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                         <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{Binding Text.PipCache}" />
                                         <TextBlock x:Name="PipCacheSizeText" Grid.Row="3" Grid.Column="1" Margin="18,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                         <Button x:Name="ClearPipCacheButton" Grid.Row="3" Grid.Column="2" Margin="6,5,0,5"
                                                 Tag="Pip" Style="{StaticResource ActionButtonStyle}"
                                                 Click="ClearStorageCache_Click" Content="{Binding Text.ClearCache}" />

                                         <Border Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,0"
                                                 BorderBrush="{StaticResource AppButtonBorderBrush}" BorderThickness="0,1,0,0" />
                                         <TextBlock Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text.TotalCache}" />
                                         <TextBlock x:Name="TotalCacheSizeText" Grid.Row="4" Grid.Column="1" Margin="18,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold" Text="—" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="StorageOverviewStatusText" Margin="0,13,0,0" Foreground="{StaticResource AppSubtleBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Width="{Binding ActualWidth, ElementName=SettingsContent}"
                                Style="{StaticResource PanelCardStyle}" MaxWidth="820" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.ProtectedStorage}" />
                                <TextBlock Margin="0,7,0,12" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                           Text="{Binding Text.ProtectedStorageHelp}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text.InstalledRuntimes}" />
                                    <TextBlock x:Name="InstalledRuntimeSizeText" Grid.Column="1" Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                </Grid>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text.PersistentProjectData}" />
                                    <TextBlock x:Name="PersistentDataSizeText" Grid.Column="1" Foreground="{StaticResource AppWarningBrush}" Text="—" />
                                </Grid>
                            </StackPanel>
                        </Border>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{Binding Text.SettingsAboutTab}">
                                <StackPanel>
                                    <Border Width="{Binding ActualWidth, ElementName=SettingsContent}"
                                            Style="{StaticResource PanelCardStyle}" MaxWidth="820" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.TechnicalDetails}" />
                                            <TextBlock Margin="0,14,0,3" Foreground="{StaticResource AppSubtleBrush}" Text="{Binding Text.ApplicationVersion}" />
                                            <TextBlock Text="{Binding ApplicationVersion}" />
                                            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap">
                                                <Run Text="Apache " /><Run Text="{Binding ApachePort, Mode=OneWay}" /><Run Text="  •  PHP FastCGI " />
                                                <Run Text="{Binding PhpFastCgiPort, Mode=OneWay}" /><Run Text="  •  MariaDB " /><Run Text="{Binding MariaDbPort, Mode=OneWay}" />
                                                <Run Text="  •  Selenium " /><Run Text="{Binding SeleniumPort, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <TextBlock x:Name="InstallationStatusText"
                       Grid.Row="2"
                       Margin="0,14,0,0"
                       Foreground="{StaticResource AppSubtleBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding Text.InitialStatus}" />
        </Grid>
        </Grid>
        <Grid Grid.Row="1" Panel.ZIndex="100" Background="{StaticResource AppOverlayBrush}"
              Visibility="{Binding GlobalOperation.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding GlobalOperation.Status}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding GlobalOperation.Detail}"
                               Visibility="{Binding GlobalOperation.Detail, Converter={StaticResource StringToVisibilityConverter}}" />
                    <ProgressBar Margin="0,15,0,0" Height="7" Minimum="0" Maximum="100"
                                 IsIndeterminate="{Binding GlobalOperation.IsIndeterminate, Mode=OneWay}"
                                 Value="{Binding GlobalOperation.Progress, Mode=OneWay}" />
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource AppMutedBrush}" Text="{Binding Text.OperationPleaseWait}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
