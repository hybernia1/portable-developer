<Window x:Class="PortableDeveloper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
        xmlns:shell="clr-namespace:PortableDeveloper.App.Shell"
        mc:Ignorable="d"
        Title="Portable Developer"
        Icon="Assets/portable-developer.ico"
        Width="1120"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <controls:AppSidebar x:Name="Sidebar"
                                 DataContext="{Binding Shell}"
                                 NavigationSelectionChanged="NavigationList_SelectionChanged"
                                 LanguageSelectionChanged="LanguageSelector_SelectionChanged" />
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,20"
              shell:WorkspaceLayout.Mode="{Binding Shell.LayoutMode}"
              SizeChanged="WorkspaceSurface_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:WorkspaceHeader Margin="0,0,0,20"
                                      DataContext="{Binding Shell}"
                                      ProjectSelectionChanged="ProjectSelection_SelectionChanged"
                                      ManageProjectsRequested="ManageProjects_Click" />

            <Grid Grid.Row="1">
                <ContentControl Style="{StaticResource PageHostContentControlStyle}"
                                Content="{Binding CurrentPage}" />
            </Grid>

            <controls:TransientNotificationHost Grid.Row="1" Margin="20"
                                                Panel.ZIndex="20"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                DataContext="{Binding Notifications}" />
        </Grid>
    </Grid>
</Window>
