<UserControl x:Class="PortableDeveloper.App.Controls.AppSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedNavigation" Source="{Binding NavigationItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0"
                     IsEnabled="{Binding CanNavigate}"
                     SelectionChanged="NavigationList_SelectionChanged"
                     ItemsSource="{Binding Source={StaticResource GroupedNavigation}}"
                     ItemContainerStyle="{StaticResource NavigationItemStyle}"
                     SelectedValuePath="Page"
                     SelectedValue="{Binding SelectedPage, Mode=OneWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="8,7,8,2" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Name}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.6">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Data" Value="{StaticResource IconPackage}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Folder"><Setter Property="Data" Value="{StaticResource IconFolder}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Ports"><Setter Property="Data" Value="{StaticResource IconPorts}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Code"><Setter Property="Data" Value="{StaticResource IconCode}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Database"><Setter Property="Data" Value="{StaticResource IconDatabase}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Gear"><Setter Property="Data" Value="{StaticResource IconGear}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Schedule"><Setter Property="Data" Value="{StaticResource IconSchedule}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Terminal"><Setter Property="Data" Value="{StaticResource IconTerminal}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKind}" Value="Guide"><Setter Property="Data" Value="{StaticResource IconGuide}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding UsesBrandLogo}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <controls:BrandLogo Width="16" Height="16" Brand="{Binding BrandLogo}"
                                                Visibility="{Binding UsesBrandLogo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Column="1" FontSize="14" Text="{Binding Label}" />
                            <Ellipse Grid.Column="2" Width="9" Height="9" Margin="9,0,0,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter Property="Visibility" Value="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Setter Property="ToolTip" Value="{Binding StatusText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Margin="8,10,8,0">
                <TextBlock Margin="0,0,0,6"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Text.Language}" />
                <ComboBox x:Name="LanguageSelector"
                          SelectionChanged="LanguageSelector_SelectionChanged"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Tag="Czech" Content="Česky" />
                    <ComboBoxItem Tag="English" Content="English" />
                </ComboBox>
                <TextBlock Margin="0,10,2,0"
                           HorizontalAlignment="Right"
                           FontSize="9"
                           Foreground="{DynamicResource TextFillColorDisabledBrush}"
                           Text="{Binding ApplicationVersion, StringFormat=v{0}}" />
            </StackPanel>
    </Grid>
</UserControl>
