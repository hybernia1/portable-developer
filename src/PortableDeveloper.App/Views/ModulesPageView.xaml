<UserControl x:Class="PortableDeveloper.App.Views.ModulesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
             xmlns:views="clr-namespace:PortableDeveloper.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="ModuleCatalogRowTemplate">
            <Border Padding="4,13" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" VerticalAlignment="Top"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <controls:BrandLogo Width="21" Height="21"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Brand="{Binding PrimaryBrandLogo}" />
                    </Border>
                    <controls:AdaptiveSplitPanel Grid.Column="1" Gap="18" SecondaryWeight="0"
                                                 CompactBreakpoint="680">
                        <StackPanel MinWidth="0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Margin="0,5,16,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding Description}" />
                            <TextBlock Margin="0,8,16,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Status}"
                                       Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="0,5,16,0" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding DownloadDetail}" TextWrapping="Wrap"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ProgressBar Margin="0,8,16,0" Height="5" Minimum="0" Maximum="100"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Value="{Binding Progress, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel MinWidth="170" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,0,7" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <Run Text="{Binding DataContext.Text.Version, RelativeSource={RelativeSource AncestorType={x:Type views:ModulesPageView}}, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                            <Button HorizontalAlignment="Left" Style="{StaticResource SectionActionButtonStyle}"
                                    IsEnabled="{Binding CanInstall}" Click="InstallRuntimePackage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AppIcon Margin="0,0,7,0">
                                        <controls:AppIcon.Style>
                                            <Style TargetType="{x:Type controls:AppIcon}"
                                                   BasedOn="{StaticResource AppIconBaseStyle}">
                                                <Setter Property="Data" Value="{StaticResource IconInstall}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconSuccess}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:AppIcon.Style>
                                    </controls:AppIcon>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text"
                                                        Value="{Binding DataContext.Text.DownloadAndInstall, RelativeSource={RelativeSource AncestorType={x:Type views:ModulesPageView}}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Text"
                                                                Value="{Binding DataContext.Text.Installed, RelativeSource={RelativeSource AncestorType={x:Type views:ModulesPageView}}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:AdaptiveSplitPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <Border Margin="0,0,0,14" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <controls:SectionHeader Icon="{StaticResource IconGlobe}"
                                            Heading="{Binding Text.WebStackModules}"
                                            Metadata="{Binding WebStackPackages.Count}" />
                    <ItemsControl ItemsSource="{Binding WebStackPackages}"
                                  ItemTemplate="{StaticResource ModuleCatalogRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,14" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <controls:SectionHeader Icon="{StaticResource IconCode}"
                                            Heading="{Binding Text.DevelopmentModules}"
                                            Metadata="{Binding DevelopmentPackages.Count}" />
                    <ItemsControl ItemsSource="{Binding DevelopmentPackages}"
                                  ItemTemplate="{StaticResource ModuleCatalogRowTemplate}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <controls:SectionHeader Icon="{StaticResource IconSchedule}"
                                            Heading="{Binding Text.AutomationModules}"
                                            Metadata="{Binding AutomationPackages.Count}" />
                    <ItemsControl ItemsSource="{Binding AutomationPackages}"
                                  ItemTemplate="{StaticResource ModuleCatalogRowTemplate}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
