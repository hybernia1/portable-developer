<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <SolidColorBrush x:Key="AppWindowBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="AppInputBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="AppCardBrush" Color="#161B22" />
    <SolidColorBrush x:Key="AppControlBrush" Color="#21262D" />
    <SolidColorBrush x:Key="AppControlHoverBrush" Color="#30363D" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3D444D" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#F0F3F6" />
    <SolidColorBrush x:Key="AppStrongForegroundBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="AppMutedBrush" Color="#9DA7B3" />
    <SolidColorBrush x:Key="AppSubtleBrush" Color="#8B949E" />
    <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#6E7681" />
    <SolidColorBrush x:Key="AppCodeForegroundBrush" Color="#E6EDF3" />
    <SolidColorBrush x:Key="AppDeepSurfaceBrush" Color="#010409" />
    <SolidColorBrush x:Key="AppIconSurfaceBrush" Color="#11151C" />
    <SolidColorBrush x:Key="AppButtonBrush" Color="#1C2128" />
    <SolidColorBrush x:Key="AppButtonHoverBrush" Color="#292E36" />
    <SolidColorBrush x:Key="AppButtonPressedBrush" Color="#30363D" />
    <SolidColorBrush x:Key="AppButtonBorderBrush" Color="#30363D" />
    <SolidColorBrush x:Key="AppFocusBrush" Color="#8FB4E5" />
    <SolidColorBrush x:Key="AppSeparatorBrush" Color="#32445F" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="#79C0FF" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="AppValidationBrush" Color="#F1C46B" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#238636" />
    <SolidColorBrush x:Key="AppAccentBorderBrush" Color="#2EA043" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#B62324" />
    <SolidColorBrush x:Key="AppDangerBorderBrush" Color="#F85149" />
    <SolidColorBrush x:Key="AppDangerSurfaceBrush" Color="#3D2025" />
    <SolidColorBrush x:Key="AppDangerMutedBorderBrush" Color="#6E343B" />
    <SolidColorBrush x:Key="AppDangerIconSurfaceBrush" Color="#4A2A31" />
    <SolidColorBrush x:Key="AppDangerTextBrush" Color="#FFD5D8" />
    <SolidColorBrush x:Key="AppTitleBarBrush" Color="#010409" />
    <SolidColorBrush x:Key="AppTitleBarBorderBrush" Color="#30363D" />
    <SolidColorBrush x:Key="AppCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="AppOverlayBrush" Color="#B0000000" />
    <SolidColorBrush x:Key="BrandApacheBrush" Color="#E0525A" />
    <SolidColorBrush x:Key="BrandComposerBrush" Color="#D4B171" />
    <SolidColorBrush x:Key="BrandFirefoxBrush" Color="#FF7139" />
    <SolidColorBrush x:Key="BrandGoogleChromeBrush" Color="#4285F4" />
    <SolidColorBrush x:Key="BrandMariaDbBrush" Color="#5DB9C0" />
    <SolidColorBrush x:Key="BrandNotepadPlusPlusBrush" Color="#A2E69A" />
    <SolidColorBrush x:Key="BrandNodeJsBrush" Color="#83CD29" />
    <SolidColorBrush x:Key="BrandPhpBrush" Color="#A0A2DB" />
    <SolidColorBrush x:Key="BrandPhpMyAdminBrush" Color="#92A6D6" />
    <SolidColorBrush x:Key="BrandPythonBrush" Color="#3776AB" />
    <SolidColorBrush x:Key="BrandSeleniumBrush" Color="#43B02A" />

    <Style x:Key="AppTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource AppForegroundBrush}" />
    </Style>

    <Style x:Key="AppButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource AppButtonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AppButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AppButtonPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDialogButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style x:Key="AppDialogPrimaryButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource AppDialogButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBorderBrush}" />
    </Style>

    <Style x:Key="AppDialogDangerButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource AppDialogButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AppDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDangerBorderBrush}" />
    </Style>

    <Style x:Key="AppCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="CheckChrome" Width="18" Height="18" Margin="0,0,9,0"
                                Background="{StaticResource AppInputBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <TextBlock x:Name="CheckMark" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource AppStrongForegroundBrush}" FontSize="13"
                                       FontWeight="Bold" Text="✓" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckChrome" Property="Background" Value="{StaticResource AppAccentBrush}" />
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource AppAccentBorderBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton" Command="ScrollBar.PageUpCommand"
                                              Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Margin="2" Background="{StaticResource AppBorderBrush}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbChrome" Background="{TemplateBinding Background}"
                                                    CornerRadius="3" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbChrome" Property="Background"
                                                            Value="{StaticResource AppAccentBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton" Command="ScrollBar.PageDownCommand"
                                              Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scrollbars created inside ScrollViewer/ListBox templates must never fall back to the OS theme. -->
    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppScrollBarStyle}" />

    <Style x:Key="AppComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AppStrongForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemChrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItemStyle}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                      Foreground="{TemplateBinding Foreground}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="ToggleChrome" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            <Border Grid.Column="1" BorderBrush="{StaticResource AppSeparatorBrush}" BorderThickness="1,0,0,0">
                                                <Path Width="9" Height="5" Fill="{StaticResource AppMutedBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4.5 5 L 9 0 Z" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource AppInputBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer Margin="1" VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppScrollBarStyle}" />
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- App-wide defaults prevent newly added selects from falling back to the light WPF theme. -->
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource AppComboBoxStyle}" />
    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource AppComboBoxItemStyle}" />

    <Style x:Key="AppChromeWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="Background" Value="{StaticResource AppWindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
    </Style>

    <Style x:Key="AppDialogWindowStyle"
           TargetType="{x:Type Window}"
           BasedOn="{StaticResource AppChromeWindowStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="AppNavigationGroupExpanderStyle" TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="HeaderChrome" Margin="0,8,0,3" Padding="8,6" Background="Transparent" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow" Width="9" Height="9" Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.6" Data="{StaticResource IconChevronDown}" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" /></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Grid.Row="1" ContentSource="Content" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppCaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="CaptionChrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaptionChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CaptionChrome" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CaptionChrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppCloseCaptionButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource AppCaptionButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AppCloseHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
