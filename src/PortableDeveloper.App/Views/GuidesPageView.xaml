<UserControl x:Class="PortableDeveloper.App.Views.GuidesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="16,13" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
            <controls:AdaptiveSplitPanel PrimaryWeight="1.3" SecondaryWeight="0.7">
                <StackPanel>
                    <TextBlock Margin="0,0,0,7" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding Text.GuideCategories}" />
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}"
                             SelectedValuePath="Id" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Margin="0,0,0,7" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding Text.GuideSearch}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </controls:AdaptiveSplitPanel>
        </Border>

        <controls:AdaptiveSplitPanel Grid.Row="1" Margin="0,12,0,0" Gap="12"
                                     PrimaryWeight="0.72" SecondaryWeight="1.28"
                                     CompactFillAvailableHeight="True">

            <Border Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="2,0,0,11" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ArticleCount}" />
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding CategoryTitle}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Text="{Binding Title}" />
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,5,4" Padding="7,2"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="9">
                                                        <TextBlock FontSize="9"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Text.GuideNoArticles}"
                                   Visibility="{Binding NoArticles, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Padding="22,18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding Text.GuideSelectArticle}"
                               Visibility="{Binding NoSelectedArticle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid Visibility="{Binding HasSelectedArticle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Text="{Binding SelectedContent.Article.CategoryTitle}" />
                        <TextBlock Grid.Row="1" Margin="0,5,0,8" FontSize="23" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Text="{Binding SelectedContent.Article.Title}" />
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ItemsControl Margin="0,0,0,7" ItemsSource="{Binding SelectedContent.Article.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="GuideTag_Click" Content="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <FlowDocumentScrollViewer x:Name="DocumentViewer" Grid.Row="1"
                                                      IsToolBarVisible="False" Background="Transparent"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </controls:AdaptiveSplitPanel>
    </Grid>
</UserControl>
