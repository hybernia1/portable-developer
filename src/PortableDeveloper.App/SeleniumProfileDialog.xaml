<Window x:Class="PortableDeveloper.App.SeleniumProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PortableDeveloper.App.Controls"
        Width="500" SizeToContent="Height" MinHeight="330" MaxHeight="560"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/portable-developer.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader x:Name="DialogHeader" Icon="{StaticResource IconFolder}" />

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock x:Name="ProfileNameLabel" Style="{StaticResource DialogFieldLabelStyle}" />
            <TextBox x:Name="ProfileNameTextBox" Margin="0,8,0,0" MaxLength="80" />

            <TextBlock x:Name="BrowserLabel" Margin="0,16,0,0"
                       Style="{StaticResource DialogFieldLabelStyle}" />
            <ComboBox x:Name="BrowserComboBox" Margin="0,8,0,0"
                      DisplayMemberPath="Label" SelectedValuePath="Id" />

            <TextBlock x:Name="ValidationText" Style="{StaticResource DialogValidationTextStyle}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Margin="0,0,8,0"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        IsCancel="True" Click="Cancel_Click" />
                <Button Style="{StaticResource DialogPrimaryButtonStyle}"
                        IsDefault="True" Click="Confirm_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:AppIcon Width="15" Height="15" Margin="0,0,7,0"
                                          Data="{StaticResource IconAdd}" />
                        <TextBlock x:Name="ConfirmButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
