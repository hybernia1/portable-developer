<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PortableDeveloper.Application\PortableDeveloper.Application.csproj" />
    <ProjectReference Include="..\PortableDeveloper.Infrastructure\PortableDeveloper.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PortableDeveloper</AssemblyName>
    <RootNamespace>PortableDeveloper.App</RootNamespace>
    <Version>1.28.0</Version>
    <AssemblyVersion>1.28.0.0</AssemblyVersion>
    <FileVersion>1.28.0.0</FileVersion>
    <InformationalVersion>1.28.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\portable-developer.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;cs</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\catalog\modules.json" Link="catalog\modules.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(PortableSeedArchive)' == ''" />
    <Content Include="..\..\catalog\dependencies.lock.json" Link="catalog\dependencies.lock.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(PortableSeedArchive)' == ''" />
    <Content Include="Resources\Selenium\PortableProfileNode.java" Link="resources\selenium\PortableProfileNode.java" CopyToOutputDirectory="PreserveNewest" Condition="'$(PortableSeedArchive)' == ''" />
    <None Update="Assets\Logos\*.svg" Link="resources\logos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="'$(PortableSeedArchive)' == ''" />
    <EmbeddedResource Include="$(PortableSeedArchive)" LogicalName="PortableDeveloper.Seed.zip" Condition="'$(PortableSeedArchive)' != ''" />
    <Resource Include="Assets\portable-developer.ico" />
    <Resource Include="Assets\portable-developer.png" />
    <EmbeddedResource Include="Guides\catalog.json" />
    <EmbeddedResource Include="Guides\Articles\**\*.md" />
  </ItemGroup>

</Project>
