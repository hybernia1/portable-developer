<UserControl x:Class="PortableDeveloper.App.Views.PhpPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Text="{Binding StatusText}"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}" />
            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=PhpSettings}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.PhpSettings}" />
                        <controls:AdaptiveSplitPanel Margin="0,10,0,0" Gap="12">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.MemoryLimit}" />
                                <TextBox IsEnabled="{Binding PhpSettingsEnabled}" Text="{Binding MemoryLimitText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,11,0,5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.UploadLimit}" />
                                <TextBox IsEnabled="{Binding PhpSettingsEnabled}" Text="{Binding UploadLimitText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,11,0,5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.ExecutionTime}" />
                                <TextBox IsEnabled="{Binding PhpSettingsEnabled}" Text="{Binding ExecutionTimeText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.PostLimit}" />
                                <TextBox IsEnabled="{Binding PhpSettingsEnabled}" Text="{Binding PostLimitText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,11,0,5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.MaximumInputVariables}" />
                                <TextBox IsEnabled="{Binding PhpSettingsEnabled}" Text="{Binding MaximumInputVariablesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </controls:AdaptiveSplitPanel>
                        <CheckBox Margin="0,14,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  IsEnabled="{Binding PhpSettingsEnabled}" IsChecked="{Binding DisplayErrors, Mode=TwoWay}"
                                  Content="{Binding Text.DisplayErrors}" />
                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding Text.DisplayErrorsHelp}" />
                        <WrapPanel Margin="0,15,0,0">
                            <Button Margin="0,0,8,0" Padding="15,9" IsEnabled="{Binding PhpSettingsEnabled}"
                                    Click="SavePhpSettings_Click" Content="{Binding PhpSettingsActionLabel}" />
                            <Button Padding="15,9" IsEnabled="{Binding PhpSettingsEnabled}"
                                    Click="ResetPhpSettings_Click" Content="{Binding Text.ResetDefaults}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=PhpExtensions}">
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Text.PhpExtensions}" />
                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding Text.PhpExtensionsHelp}" />
                        <TextBlock Margin="0,8,0,12" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap" Text="{Binding Text.RequiredPhpExtensions}" />
                        <ItemsControl ItemsSource="{Binding PhpExtensions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,0,18,12" MinWidth="105"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanToggle}">
                                        <TextBlock Text="{Binding Name}" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,5,0,0" Padding="12,10" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.PhpIni}" />
                                <TextBlock Margin="0,4,0,0" Text="temp/generated/default/apache-php/php.ini" TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Text.Version}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding PhpRuntimeVersion}" />
                            </StackPanel>
                        </Border>
                        <Button Margin="0,14,0,0" Padding="15,9" HorizontalAlignment="Left"
                                Click="EditCustomPhpIni_Click" Content="{Binding Text.EditCustomPhpIni}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding Text.CustomPhpIniHelp}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
