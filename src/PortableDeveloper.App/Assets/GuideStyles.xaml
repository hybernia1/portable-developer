<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GuideCategoryItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="CategoryChrome" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource AppControlBrush}" CornerRadius="5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CategoryChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CategoryChrome" Property="Background" Value="{StaticResource AppControlHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AppStrongForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuideArticleItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Padding" Value="13,11" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ArticleChrome" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource AppInputBrush}"
                            BorderBrush="{StaticResource AppButtonBorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArticleChrome" Property="Background" Value="{StaticResource AppControlBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ArticleChrome" Property="Background" Value="{StaticResource AppControlBrush}" />
                            <Setter TargetName="ArticleChrome" Property="BorderBrush" Value="{StaticResource AppAccentBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuideTagButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource AppInfoBrush}" />
        <Setter Property="Background" Value="{StaticResource AppIconSurfaceBrush}" />
    </Style>
</ResourceDictionary>
