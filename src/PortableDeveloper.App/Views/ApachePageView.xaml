<UserControl x:Class="PortableDeveloper.App.Views.ApachePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PortableDeveloper.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel>
            <controls:RuntimeHeader Margin="0,0,0,18"
                                    Brand="apache"
                                    Heading="Apache HTTP Server"
                                    State="{Binding ApacheService.State}"
                                    IsRunning="{Binding ApacheIsRunning}"
                                    Version="{Binding ApacheService.Version}"
                                    Detail="{Binding ApacheHeaderDetail}">
                <controls:RuntimeHeader.Actions>
                    <Button HorizontalAlignment="Left"
                            Style="{StaticResource RuntimePrimaryButtonStyle}"
                            IsEnabled="{Binding ApacheActionEnabled}"
                            Click="ToggleApache_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Width="15" Height="15" Margin="0,0,8,0">
                                <controls:AppIcon.Style>
                                    <Style TargetType="{x:Type controls:AppIcon}"
                                           BasedOn="{StaticResource AppIconBaseStyle}">
                                        <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ApacheIsRunning}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconStop}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:AppIcon.Style>
                            </controls:AppIcon>
                            <TextBlock Text="{Binding ApacheActionLabel}" />
                        </StackPanel>
                    </Button>
                </controls:RuntimeHeader.Actions>
            </controls:RuntimeHeader>
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <controls:SectionHeader Icon="{StaticResource IconCode}"
                                            Heading="{Binding Text.CurrentConfiguration}" />
                    <controls:AdaptiveSplitPanel Gap="22" CompactBreakpoint="620">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="{Binding Text.Version}" />
                            <TextBlock Text="{Binding ApacheService.Version}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,14,0,6" Style="{StaticResource FormFieldLabelStyle}" Text="{Binding Text.Port}" />
                            <TextBlock Text="{Binding ApachePort}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="{Binding Text.DocumentRoot}" />
                            <TextBlock Text="{Binding ActiveDocumentRoot}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,14,0,6" Style="{StaticResource FormFieldLabelStyle}" Text="{Binding Text.ActiveProject}" />
                            <TextBlock Text="{Binding ActiveWebProjectName}" TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:AdaptiveSplitPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
